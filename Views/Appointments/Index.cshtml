@model IEnumerable<AUREVA.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<style>
    /* =========================================================
           AUREVA / APPOINTMENTS
           EDITORIAL LUXURY — MODERN ATELIER
        ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .appointments-page {
        --teal: #169C98;
        --teal-dark: #0B7773;
        --teal-deep: #064F50;
        --teal-soft: #DDF3F1;
        --teal-pale: #F2F9F8;
        --burgundy: #731B35;
        --burgundy-dark: #521126;
        --burgundy-soft: #D9AEB9;
        --burgundy-pale: #FAF0F3;
        --white: #FFFFFF;
        --ivory: #F8F7F2;
        --ivory-dark: #ECECE5;
        --text: #173334;
        --text-soft: #4E6563;
        --text-muted: #81918F;
        --text-faint: #A9B8B6;
        --line: rgba(23,51,52,.10);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        padding: 145px 0 100px;
        background: radial-gradient( circle at 88% 5%, rgba(22,156,152,.12), transparent 25% ), radial-gradient( circle at 5% 74%, rgba(115,27,53,.07), transparent 27% ), linear-gradient( 180deg, #FFFFFF 0%, #F8F7F2 58%, #ECECE5 100% );
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .appointments-page *,
        .appointments-page *::before,
        .appointments-page *::after {
            box-sizing: border-box;
        }

        .appointments-page a {
            -webkit-tap-highlight-color: transparent;
        }


        /* =========================================================
           BACKGROUND A
        ========================================================= */

        .appointments-page::before {
            content: "A";
            position: absolute;
            right: -45px;
            top: 55px;
            color: rgba(22,156,152,.085);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 34vw, 34rem);
            line-height: .72;
            pointer-events: none;
            user-select: none;
        }

        .appointments-page::after {
            content: "";
            position: absolute;
            left: -260px;
            top: 485px;
            width: 520px;
            height: 520px;
            border: 1px solid rgba(22,156,152,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 48px rgba(22,156,152,.022), 0 0 0 95px rgba(115,27,53,.015);
            pointer-events: none;
        }


    /* =========================================================
           SHELL
        ========================================================= */

    .appointments-shell {
        position: relative;
        z-index: 2;
        width: min(1320px, calc(100% - 64px));
        margin: auto;
    }


    /* =========================================================
           TOP LINE
        ========================================================= */

    .appointments-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 40px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
    }

    .appointments-kicker {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .38em;
    }

        .appointments-kicker::before {
            content: "";
            width: 47px;
            height: 1px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

    .appointments-edition {
        color: var(--text-muted);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .24em;
    }


    /* =========================================================
           HEADER
        ========================================================= */

    .appointments-header {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 60px;
        align-items: end;
        padding-bottom: 48px;
        border-bottom: 1px solid var(--line);
    }

    .appointments-title {
        margin: 24px 0 0;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(5rem, 8vw, 8.8rem);
        font-weight: 400;
        line-height: .74;
        letter-spacing: -.085em;
    }

        .appointments-title span {
            color: var(--burgundy);
        }

    .appointments-intro {
        max-width: 350px;
        margin: 0 0 5px auto;
        padding-left: 18px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.95;
    }


    /* =========================================================
           HEADER SIDE
        ========================================================= */

    .appointments-side {
        padding: 24px;
        background: rgba(255,255,255,.78);
        border: 1px solid var(--line);
        box-shadow: 0 24px 55px rgba(23,51,52,.05);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .appointments-side-number {
        color: var(--burgundy);
        font-family: Georgia, serif;
        font-size: 48px;
        line-height: .8;
        letter-spacing: -.07em;
    }

    .appointments-side-label {
        margin-top: 13px;
        color: var(--teal-deep);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .20em;
    }

    .appointments-side-copy {
        margin-top: 11px;
        color: var(--text-muted);
        font-size: 8px;
        line-height: 1.85;
    }

    .appointments-side-line {
        width: 38px;
        height: 1px;
        margin-top: 21px;
        background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
    }


    /* =========================================================
           ACTION BAR
        ========================================================= */

    .appointments-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 30px;
    }

    .appointments-count {
        color: var(--text-faint);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .25em;
        text-transform: uppercase;
    }

    .appointments-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 11px;
        min-height: 48px;
        padding: 0 22px;
        border: 0;
        border-radius: 0;
        background: var(--burgundy);
        color: white;
        text-decoration: none;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        box-shadow: 0 14px 30px rgba(115,27,53,.16);
        transition: transform .35s ease, background .35s ease, box-shadow .35s ease;
    }

        .appointments-button::before {
            content: "+";
            color: var(--burgundy-soft);
            font-family: Georgia, serif;
            font-size: 17px;
            font-weight: 400;
        }

        .appointments-button:hover {
            transform: translateY(-3px);
            background: var(--teal-deep);
            box-shadow: 0 17px 36px rgba(6,79,80,.17);
        }


    /* =========================================================
           APPOINTMENT LIST
        ========================================================= */

    .appointments-list {
        position: relative;
        margin-top: 38px;
        background: rgba(255,255,255,.82);
        border: 1px solid var(--line);
        box-shadow: 0 30px 80px rgba(23,51,52,.065);
    }


        /* =========================================================
           TABLE HEADER
        ========================================================= */

        .appointments-list::before {
            content: "";
            display: block;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

    .appointments-list-header {
        display: grid;
        grid-template-columns: 100px minmax(0,1.35fr) 1fr 125px 110px;
        gap: 22px;
        padding: 18px 30px;
        background: linear-gradient( 135deg, var(--teal-deep), var(--teal-dark) );
        color: rgba(255,255,255,.55);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .24em;
    }

        .appointments-list-header div:nth-child(5) {
            color: var(--burgundy-soft);
            text-align: right;
        }


    /* =========================================================
           APPOINTMENT ROW
        ========================================================= */

    .appointment-row {
        position: relative;
        display: grid;
        grid-template-columns: 100px minmax(0,1.35fr) 1fr 125px 110px;
        gap: 22px;
        align-items: center;
        min-height: 112px;
        padding: 24px 30px;
        border-bottom: 1px solid var(--line);
        background: transparent;
        transition: background .35s ease, padding-left .35s ease, transform .35s ease;
    }

        .appointment-row:last-child {
            border-bottom: 0;
        }

        .appointment-row::before {
            content: "";
            position: absolute;
            left: 0;
            top: 18px;
            bottom: 18px;
            width: 3px;
            background: var(--burgundy);
            transform: scaleY(0);
            transform-origin: center;
            transition: transform .35s ease;
        }

        .appointment-row:hover {
            background: var(--burgundy-pale);
            padding-left: 37px;
        }

            .appointment-row:hover::before {
                transform: scaleY(1);
            }


    /* =========================================================
           TIME
        ========================================================= */

    .appointment-time {
        color: var(--burgundy);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 27px;
        font-weight: 400;
        line-height: .9;
        letter-spacing: -.04em;
    }


    /* =========================================================
           CLIENT / SERVICE
        ========================================================= */

    .appointment-client {
        color: var(--teal-deep);
        font-size: 15px;
        font-weight: 800;
        transition: color .3s ease;
    }

    .appointment-row:hover .appointment-client {
        color: var(--burgundy);
    }

    .appointment-service {
        margin-top: 7px;
        color: var(--text-muted);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .10em;
        text-transform: uppercase;
    }


    /* =========================================================
           STAFF
        ========================================================= */

    .appointment-staff {
        color: var(--text-soft);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .12em;
    }


    /* =========================================================
           DATE
        ========================================================= */

    .appointment-date {
        color: var(--text-muted);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .04em;
    }


    /* =========================================================
           STATUS
        ========================================================= */

    .appointment-status {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .18em;
    }

        .appointment-status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--burgundy);
            box-shadow: 0 0 0 4px rgba(115,27,53,.09);
        }


    /* =========================================================
           EMPTY
        ========================================================= */

    .appointment-empty {
        padding: 90px 30px;
        color: var(--text-muted);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 30px;
        text-align: center;
    }


    /* =========================================================
           LOWER STATEMENT
        ========================================================= */

    .appointments-statement {
        display: grid;
        grid-template-columns: 1fr 310px;
        gap: 55px;
        margin-top: 72px;
        padding: 48px;
        background: linear-gradient( 135deg, var(--ivory), #FFFFFF );
        border: 1px solid var(--line);
    }

    .appointments-statement-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .30em;
    }

    .appointments-statement-title {
        margin-top: 17px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.8rem, 5vw, 5rem);
        font-weight: 400;
        line-height: .86;
        letter-spacing: -.06em;
    }

        .appointments-statement-title span {
            color: var(--burgundy);
        }

    .appointments-statement-copy {
        align-self: end;
        max-width: 290px;
        padding-left: 18px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 9px;
        line-height: 1.9;
    }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 1050px) {

        .appointments-shell {
            width: min(1180px, calc(100% - 48px));
        }

        .appointments-header {
            grid-template-columns: 1fr 260px;
            gap: 35px;
        }

        .appointments-list-header,
        .appointment-row {
            grid-template-columns: 85px minmax(0,1.25fr) 1fr 110px 90px;
        }

            .appointment-row:hover {
                padding-left: 35px;
            }

        .appointments-statement {
            grid-template-columns: 1fr 260px;
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 760px) {

        .appointments-page {
            padding: 105px 0 65px;
        }

            .appointments-page::before {
                top: 85px;
                right: -30px;
                font-size: 18rem;
            }

        .appointments-shell {
            width: calc(100% - 28px);
        }

        .appointments-topline {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .appointments-header {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .appointments-title {
            font-size: clamp(4.25rem, 18vw, 6.8rem);
        }

        .appointments-intro {
            max-width: 320px;
            margin-left: 0;
        }

        .appointments-side {
            max-width: 330px;
        }

        .appointments-actions {
            align-items: flex-start;
            flex-direction: column;
        }

        .appointments-button {
            width: 100%;
        }

        .appointments-list {
            margin-top: 34px;
        }

        .appointments-list-header {
            display: none;
        }

        .appointment-row {
            grid-template-columns: 65px minmax(0,1fr);
            gap: 12px 18px;
            padding: 25px 22px;
        }

            .appointment-row:hover {
                padding-left: 28px;
            }

        .appointment-time {
            font-size: 23px;
        }

        .appointment-staff {
            grid-column: 2;
            padding-top: 2px;
        }

        .appointment-date {
            grid-column: 1 / -1;
            padding-top: 12px;
            border-top: 1px solid var(--line);
            color: var(--text-muted);
        }

        .appointment-status {
            grid-column: 2;
            justify-content: flex-start;
        }

            .appointment-status::before {
                width: 6px;
                height: 6px;
            }

        .appointment-empty {
            padding: 65px 20px;
            font-size: 25px;
        }

        .appointments-statement {
            grid-template-columns: 1fr;
            gap: 28px;
            margin-top: 55px;
            padding: 32px 24px;
        }

        .appointments-statement-copy {
            max-width: 100%;
        }
    }


    /* =========================================================
           SMALL MOBILE
        ========================================================= */

    @@media (max-width: 430px) {

        .appointments-shell {
            width: calc(100% - 20px);
        }

        .appointments-title {
            font-size: 4rem;
        }

        .appointments-kicker {
            font-size: 7px;
            letter-spacing: .29em;
        }

        .appointment-row {
            grid-template-columns: 55px minmax(0,1fr);
            padding: 22px 19px;
        }

        .appointment-client {
            font-size: 14px;
        }

        .appointment-time {
            font-size: 21px;
        }

        .appointments-statement-title {
            font-size: 2.8rem;
        }
    }


    /* =========================================================
           REDUCED MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .appointments-page *,
        .appointments-page *::before,
        .appointments-page *::after {
            transition: none !important;
            animation: none !important;
        }
    }

</style>


<div class="appointments-page">

    <div class="appointments-shell">


        <!-- =====================================================
             TOP LINE
        ====================================================== -->

        <div class="appointments-topline">

            <div class="appointments-kicker">
                AUREVA / APPOINTMENTS
            </div>

            <div class="appointments-edition">
                DAILY RHYTHM / 01
            </div>

        </div>


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <header class="appointments-header">

            <div>

                <h1 class="appointments-title">
                    Today,
                    <br />
                    in motion.
                </h1>

                <p class="appointments-intro">
                    Every appointment is a moment
                    carefully placed within the rhythm
                    of the AUREVA atelier.
                </p>

            </div>


            <div class="appointments-side">

                <div class="appointments-side-number">
                    01
                </div>

                <div class="appointments-side-label">
                    TODAY'S EXPERIENCE
                </div>

                <div class="appointments-side-copy">
                    Follow the appointments,
                    clients and artists that shape
                    the day at AUREVA.
                </div>

                <div class="appointments-side-line"></div>

            </div>

        </header>


        <!-- =====================================================
             ACTIONS
        ====================================================== -->

        <div class="appointments-actions">

            <div class="appointments-count">
                APPOINTMENT SCHEDULE
            </div>

            <a asp-action="Create"
               class="appointments-button">
                NEW APPOINTMENT
            </a>

        </div>


        <!-- =====================================================
             APPOINTMENTS LIST
        ====================================================== -->

        <div class="appointments-list">


            <div class="appointments-list-header">

                <div>
                    TIME
                </div>

                <div>
                    CLIENT / SERVICE
                </div>

                <div>
                    ARTIST
                </div>

                <div>
                    DATE
                </div>

                <div>
                    STATUS
                </div>

            </div>


            @if (Model.Any())
            {
                @foreach (var item in Model)
                {

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="appointment-row"
                       style="text-decoration:none;color:inherit;">


                        <div class="appointment-time">

                            @item.StartTime.ToString("HH:mm")

                        </div>


                        <div>

                            <div class="appointment-client">

                                @(item.Client?.FullName
                                    ?? "Unknown client")

                            </div>

                            <div class="appointment-service">

                                @(item.Service?.Name
                                    ?? "Unknown service")

                            </div>

                        </div>


                        <div class="appointment-staff">

                            @(item.Staff?.FullName
                                ?? "Unknown artist")

                        </div>


                        <div class="appointment-date">

                            @item.StartTime.ToString("dd MMM yyyy")

                        </div>


                        <div class="appointment-status">

                            @item.Status.ToUpper()

                        </div>

                    </a>
                }
            }
            else
            {
                <div class="appointment-empty">

                    No appointments yet.

                </div>
            }


        </div>


        <!-- =====================================================
             STATEMENT
        ====================================================== -->

        <section class="appointments-statement">

            <div>

                <div class="appointments-statement-label">
                    AUREVA / EXPERIENCE
                </div>

                <div class="appointments-statement-title">
                    Every moment
                    <br />
                    <span>has its place.</span>
                </div>

            </div>

            <div class="appointments-statement-copy">
                From the first arrival to the
                final detail, AUREVA keeps every
                appointment part of a thoughtful,
                personal experience.
            </div>

        </section>


    </div>

</div>