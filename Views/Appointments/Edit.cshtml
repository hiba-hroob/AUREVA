@model AUREVA.Models.Appointment

@{
    ViewData["Title"] = "Edit Appointment";
}

<style>
    :root {
        --teal: #169C98;
        --teal-dark: #0B7773;
        --teal-deep: #064F50;
        --teal-soft: #DDF3F1;
        --teal-pale: #F2F9F8;
        --burgundy: #731B35;
        --burgundy-dark: #521126;
        --burgundy-soft: #D9AEB9;
        --burgundy-pale: #FAF0F3;
        --white: #FFFFFF;
        --ivory: #F8F7F2;
        --ivory-dark: #ECECE5;
        --text: #173334;
        --text-soft: #4E6563;
        --text-muted: #81918F;
        --text-faint: #A9B8B6;
    }

    * {
        box-sizing: border-box;
    }

    .appointment-edit-page {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        background: radial-gradient(circle at 12% 14%, rgba(22, 156, 152, .07), transparent 30%), radial-gradient(circle at 88% 82%, rgba(115, 27, 53, .06), transparent 28%), var(--ivory);
        color: var(--text);
        padding: 48px 28px 70px;
    }

        .appointment-edit-page::before {
            content: "A";
            position: absolute;
            top: 115px;
            right: -25px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 34vw, 34rem);
            line-height: .72;
            font-weight: 400;
            color: rgba(22, 156, 152, .065);
            pointer-events: none;
            user-select: none;
            z-index: 0;
        }

    .appointment-edit-shell {
        position: relative;
        z-index: 1;
        width: min(1180px, 100%);
        margin: 0 auto;
    }

    /* =========================
           TOPLINE
        ========================= */

    .appointment-edit-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(23, 51, 52, .12);
    }

    .appointment-edit-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--teal-dark);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .22em;
        text-transform: uppercase;
    }

        .appointment-edit-kicker::before {
            content: "";
            width: 28px;
            height: 1px;
            background: var(--teal);
        }

    .appointment-edit-id {
        color: var(--text-muted);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    /* =========================
           HERO
        ========================= */

    .appointment-edit-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 70px;
        align-items: end;
        margin-bottom: 42px;
    }

    .appointment-edit-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3rem, 6vw, 5.9rem);
        line-height: .9;
        font-weight: 400;
        letter-spacing: -.055em;
        color: var(--teal-deep);
    }

        .appointment-edit-title span{
            color: var(--burgundy);
        }

    .appointment-edit-intro {
        max-width: 620px;
        margin: 22px 0 0;
        color: var(--text-soft);
        font-size: 14px;
        line-height: 1.9;
    }

    .appointment-edit-note {
        position: relative;
        padding: 20px 22px;
        border-left: 2px solid var(--burgundy);
        background: rgba(255,255,255,.45);
    }

    .appointment-edit-note-label {
        display: block;
        margin-bottom: 8px;
        color: var(--burgundy);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .appointment-edit-note p {
        margin: 0;
        color: var(--text-soft);
        font-size: 12px;
        line-height: 1.8;
    }

    /* =========================
           MAIN FRAME
        ========================= */

    .appointment-edit-frame {
        display: grid;
        grid-template-columns: 285px minmax(0, 1fr);
        border: 1px solid rgba(23, 51, 52, .11);
        background: rgba(255,255,255,.72);
        box-shadow: 0 28px 80px rgba(6, 79, 80, .08), 0 8px 28px rgba(23, 51, 52, .05);
        backdrop-filter: blur(14px);
    }

    /* =========================
           SIDE PANEL
        ========================= */

    .appointment-edit-side {
        position: relative;
        padding: 38px 30px;
        background: linear-gradient( 180deg, rgba(6, 79, 80, .97), rgba(11, 119, 115, .98) );
        color: var(--white);
        overflow: hidden;
    }

        .appointment-edit-side::after {
            content: "02";
            position: absolute;
            right: -7px;
            bottom: -22px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 8rem;
            line-height: 1;
            color: rgba(255,255,255,.05);
            pointer-events: none;
        }

    .side-kicker {
        display: block;
        margin-bottom: 16px;
        color: rgba(255,255,255,.62);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .side-title {
        margin: 0 0 14px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        line-height: 1.05;
        font-weight: 400;
    }

    .side-copy {
        margin: 0;
        color: rgba(255,255,255,.7);
        font-size: 11px;
        line-height: 1.9;
    }

    .side-rule {
        width: 100%;
        height: 1px;
        margin: 28px 0;
        background: rgba(255,255,255,.14);
    }

    .side-step {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-bottom: 19px;
    }

    .side-step-number {
        flex: 0 0 28px;
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255,255,255,.22);
        color: rgba(255,255,255,.85);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .08em;
    }

    .side-step-text strong {
        display: block;
        margin-bottom: 4px;
        color: rgba(255,255,255,.92);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .side-step-text span {
        display: block;
        color: rgba(255,255,255,.56);
        font-size: 10px;
        line-height: 1.6;
    }

    /* =========================
           FORM AREA
        ========================= */

    .appointment-edit-content {
        padding: 42px 44px 38px;
    }

    .form-heading {
        margin-bottom: 28px;
    }

    .form-heading-kicker {
        display: block;
        margin-bottom: 7px;
        color: var(--burgundy);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .form-heading-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        font-weight: 400;
        color: var(--teal-deep);
        letter-spacing: -.025em;
    }

    .validation-summary {
        margin-bottom: 24px;
        padding: 15px 17px;
        border-left: 2px solid var(--burgundy);
        background: var(--burgundy-pale);
        color: var(--burgundy-dark);
        font-size: 11px;
        line-height: 1.7;
    }

        .validation-summary:empty {
            display: none;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px 20px;
    }

    .form-group {
        min-width: 0;
    }

        .form-group.full {
            grid-column: 1 / -1;
        }

    .form-label {
        display: block;
        margin-bottom: 9px;
        color: var(--text);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

        .form-label .required {
            color: var(--burgundy);
        }

    .form-control,
    .form-select {
        width: 100%;
        min-height: 50px;
        padding: 13px 14px;
        border: 1px solid rgba(23, 51, 52, .14);
        border-radius: 0;
        outline: none;
        background: rgba(255,255,255,.86);
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 13px;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

        .form-control:hover,
        .form-select:hover {
            border-color: rgba(22, 156, 152, .35);
            background: #fff;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--teal);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(22,156,152,.09);
        }

        .form-control::placeholder {
            color: var(--text-faint);
        }

    .form-select {
        cursor: pointer;
        appearance: none;
        background-image: linear-gradient(45deg, transparent 50%, var(--teal-dark) 50%), linear-gradient(135deg, var(--teal-dark) 50%, transparent 50%);
        background-position: calc(100% - 17px) 21px, calc(100% - 12px) 21px;
        background-size: 5px 5px, 5px 5px;
        background-repeat: no-repeat;
        padding-right: 38px;
    }

    textarea.form-control {
        min-height: 125px;
        resize: vertical;
        line-height: 1.7;
    }

    .field-validation-error {
        display: block;
        margin-top: 7px;
        color: var(--burgundy);
        font-size: 10px;
        line-height: 1.5;
    }

    .input-hint {
        margin-top: 7px;
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.5;
    }

    /* =========================
           DURATION + STATUS
        ========================= */

    .duration-status-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    /* =========================
           DIVIDER
        ========================= */

    .form-divider {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 3px 0 2px;
    }

        .form-divider::before,
        .form-divider::after {
            content: "";
            height: 1px;
            background: rgba(23,51,52,.1);
        }

        .form-divider::before {
            width: 36px;
        }

        .form-divider::after {
            flex: 1;
        }

        .form-divider span {
            color: var(--text-muted);
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

    /* =========================
           ACTIONS
        ========================= */

    .appointment-edit-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 34px;
        padding-top: 24px;
        border-top: 1px solid rgba(23,51,52,.1);
    }

    .edit-cancel {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text-soft);
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .15em;
        text-transform: uppercase;
        transition: color .2s ease, gap .2s ease;
    }

        .edit-cancel::before {
            content: "←";
            font-size: 15px;
            line-height: 1;
        }

        .edit-cancel:hover {
            color: var(--burgundy);
            gap: 13px;
        }

    .edit-submit {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 190px;
        min-height: 50px;
        padding: 14px 24px;
        border: 1px solid var(--teal-deep);
        background: var(--teal-deep);
        color: var(--white);
        cursor: pointer;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        transition: background .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease;
    }

        .edit-submit::after {
            content: "↗";
            margin-left: 13px;
            font-size: 13px;
            line-height: 1;
        }

        .edit-submit:hover {
            background: var(--burgundy);
            border-color: var(--burgundy);
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(115,27,53,.15);
        }

    /* =========================
           FOOTNOTE
        ========================= */

    .appointment-edit-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

        .appointment-edit-footer span {
            color: var(--text-faint);
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 1050px) {
        .appointment-edit-hero {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .appointment-edit-note {
            max-width: 500px;
        }

        .appointment-edit-frame {
            grid-template-columns: 235px minmax(0, 1fr);
        }

        .appointment-edit-content {
            padding: 36px 30px;
        }
    }

    @@media (max-width: 820px) {
        .appointment-edit-page {
            padding: 32px 18px 50px;
        }

        .appointment-edit-frame {
            grid-template-columns: 1fr;
        }

        .appointment-edit-side {
            padding: 30px;
        }

            .appointment-edit-side::after {
                display: none;
            }

        .side-rule {
            margin: 22px 0;
        }

        .side-steps {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .side-step {
            margin-bottom: 0;
        }
    }

    @@media (max-width: 620px) {
        .appointment-edit-page::before {
            right: -70px;
            top: 170px;
            font-size: 18rem;
        }

        .appointment-edit-topline {
            align-items: flex-start;
            flex-direction: column;
            gap: 9px;
        }

        .appointment-edit-title {
            font-size: 3.5rem;
        }

        .appointment-edit-content {
            padding: 30px 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: auto;
        }

        .form-divider {
            grid-column: auto;
        }

        .side-steps {
            grid-template-columns: 1fr;
        }

        .side-step {
            margin-bottom: 16px;
        }

        .appointment-edit-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .edit-submit,
        .edit-cancel {
            width: 100%;
        }

        .edit-cancel {
            justify-content: center;
        }
    }

    @@media (max-width: 430px) {
        .appointment-edit-page {
            padding-left: 12px;
            padding-right: 12px;
        }

        .appointment-edit-title {
            font-size: 3rem;
        }

        .appointment-edit-intro {
            font-size: 12px;
        }

        .appointment-edit-side {
            padding: 25px 20px;
        }

        .appointment-edit-content {
            padding: 26px 16px;
        }

        .form-control,
        .form-select {
            min-height: 48px;
        }
    }
</style>

<div class="appointment-edit-page">

    <div class="appointment-edit-shell">

        <!-- TOPLINE -->
        <div class="appointment-edit-topline">
            <div class="appointment-edit-kicker">
                Appointment Management
            </div>

            <div class="appointment-edit-id">
                Record #@Model.Id
            </div>
        </div>

        <!-- HERO -->
        <section class="appointment-edit-hero">

            <div>
                <h1 class="appointment-edit-title">
                    Edit <span>Appointment</span>
                </h1>

                <p class="appointment-edit-intro">
                    Refine the appointment details below. Changes are reviewed
                    against existing schedules before they are saved.
                </p>
            </div>

            <div class="appointment-edit-note">

                <span class="appointment-edit-note-label">
                    AUREVA Standard
                </span>

                <p>
                    Every appointment should maintain a clear client,
                    service, artist, time, and status record.
                </p>

            </div>

        </section>


        <!-- MAIN FRAME -->
        <section class="appointment-edit-frame">

            <!-- SIDE -->
            <aside class="appointment-edit-side">

                <span class="side-kicker">
                    Edit Suite
                </span>

                <h2 class="side-title">
                    Refine the<br />
                    appointment.
                </h2>

                <p class="side-copy">
                    Update the booking details with precision while keeping
                    the schedule aligned with the rest of the atelier.
                </p>

                <div class="side-rule"></div>

                <div class="side-steps">

                    <div class="side-step">
                        <div class="side-step-number">01</div>

                        <div class="side-step-text">
                            <strong>People</strong>
                            <span>Client &amp; artist</span>
                        </div>
                    </div>

                    <div class="side-step">
                        <div class="side-step-number">02</div>

                        <div class="side-step-text">
                            <strong>Service</strong>
                            <span>Selected treatment</span>
                        </div>
                    </div>

                    <div class="side-step">
                        <div class="side-step-number">03</div>

                        <div class="side-step-text">
                            <strong>Schedule</strong>
                            <span>Time &amp; duration</span>
                        </div>
                    </div>

                </div>

            </aside>


            <!-- FORM -->
            <div class="appointment-edit-content">

                <div class="form-heading">
                    <span class="form-heading-kicker">
                        Appointment Details
                    </span>

                    <h2 class="form-heading-title">
                        Update the record
                    </h2>
                </div>


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <form asp-action="Edit" method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="Id" />


                    <div class="form-grid">

                        <!-- CLIENT -->
                        <div class="form-group">

                            <label asp-for="ClientId" class="form-label">
                                Client <span class="required">*</span>
                            </label>

                            <select asp-for="ClientId"
                                    asp-items="ViewBag.Clients"
                                    class="form-select">
                                <option value="">Select client</option>
                            </select>

                            <span asp-validation-for="ClientId"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <!-- STAFF -->
                        <div class="form-group">

                            <label asp-for="StaffId" class="form-label">
                                Staff / Artist <span class="required">*</span>
                            </label>

                            <select asp-for="StaffId"
                                    asp-items="ViewBag.Staff"
                                    class="form-select">
                                <option value="">Select staff member</option>
                            </select>

                            <span asp-validation-for="StaffId"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <!-- SERVICE -->
                        <div class="form-group full">

                            <label asp-for="ServiceId" class="form-label">
                                Service <span class="required">*</span>
                            </label>

                            <select asp-for="ServiceId"
                                    asp-items="ViewBag.Services"
                                    class="form-select">
                                <option value="">Select service</option>
                            </select>

                            <span asp-validation-for="ServiceId"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <div class="form-divider">
                            <span>Schedule</span>
                        </div>


                        <!-- START TIME -->
                        <div class="form-group">

                            <label asp-for="StartTime" class="form-label">
                                Start Time <span class="required">*</span>
                            </label>

                            <input asp-for="StartTime"
                                   type="datetime-local"
                                   class="form-control" />

                            <div class="input-hint">
                                Choose the date and exact start time.
                            </div>

                            <span asp-validation-for="StartTime"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <!-- DURATION -->
                        <div class="form-group">

                            <label asp-for="DurationMinutes" class="form-label">
                                Duration <span class="required">*</span>
                            </label>

                            <input asp-for="DurationMinutes"
                                   type="number"
                                   min="1"
                                   step="1"
                                   class="form-control"
                                   placeholder="e.g. 60" />

                            <div class="input-hint">
                                Enter the appointment duration in minutes.
                            </div>

                            <span asp-validation-for="DurationMinutes"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <!-- STATUS -->
                        <div class="form-group full">

                            <label asp-for="Status" class="form-label">
                                Status
                            </label>

                            <select asp-for="Status" class="form-select">

                                <option value="Confirmed">
                                    Confirmed
                                </option>

                                <option value="Pending">
                                    Pending
                                </option>

                                <option value="Completed">
                                    Completed
                                </option>

                                <option value="Cancelled">
                                    Cancelled
                                </option>

                            </select>

                            <span asp-validation-for="Status"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <div class="form-divider">
                            <span>Additional Information</span>
                        </div>


                        <!-- NOTES -->
                        <div class="form-group full">

                            <label asp-for="Notes" class="form-label">
                                Notes
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      placeholder="Add any relevant notes about this appointment..."></textarea>

                            <span asp-validation-for="Notes"
                                  class="field-validation-error">
                            </span>

                        </div>

                    </div>


                    <!-- ACTIONS -->
                    <div class="appointment-edit-actions">

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="edit-cancel">
                            Cancel &amp; Return
                        </a>

                        <button type="submit"
                                class="edit-submit">
                            Save Changes
                        </button>

                    </div>

                </form>

            </div>

        </section>


        <!-- FOOTER -->
        <div class="appointment-edit-footer">
            <span>
                AUREVA / Appointment Management
            </span>
        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}