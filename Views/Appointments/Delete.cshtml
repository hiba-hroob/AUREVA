@model AUREVA.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<style>
    /* =========================================================
           AUREVA / DELETE APPOINTMENT
           QUIET LUXURY — CONFIRMATION ATELIER
        ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .delete-appointment-page {
        --teal: #169C98;
        --teal-dark: #0B7773;
        --teal-deep: #064F50;
        --teal-soft: #DDF3F1;
        --teal-pale: #F2F9F8;
        --burgundy: #731B35;
        --burgundy-dark: #521126;
        --burgundy-soft: #D9AEB9;
        --burgundy-pale: #FAF0F3;
        --white: #FFFFFF;
        --ivory: #F8F7F2;
        --ivory-dark: #ECECE5;
        --text: #173334;
        --text-soft: #4E6563;
        --text-muted: #81918F;
        --text-faint: #A9B8B6;
        --line: rgba(23,51,52,.10);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 110px 20px 90px;
        background: radial-gradient( circle at 87% 7%, rgba(22,156,152,.12), transparent 26% ), radial-gradient( circle at 5% 80%, rgba(115,27,53,.07), transparent 27% ), linear-gradient( 180deg, #FFFFFF 0%, #F8F7F2 58%, #ECECE5 100% );
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .delete-appointment-page *,
        .delete-appointment-page *::before,
        .delete-appointment-page *::after {
            box-sizing: border-box;
        }

        .delete-appointment-page a {
            -webkit-tap-highlight-color: transparent;
        }


        /* =========================================================
           BACKGROUND A
        ========================================================= */

        .delete-appointment-page::before {
            content: "A";
            position: absolute;
            top: 55px;
            right: -35px;
            color: rgba(22,156,152,.085);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 34vw, 34rem);
            line-height: .72;
            pointer-events: none;
            user-select: none;
        }

        .delete-appointment-page::after {
            content: "";
            position: absolute;
            width: 520px;
            height: 520px;
            left: -270px;
            bottom: -270px;
            border: 1px solid rgba(22,156,152,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 48px rgba(22,156,152,.022), 0 0 0 95px rgba(115,27,53,.015);
            pointer-events: none;
        }


    /* =========================================================
           SHELL
        ========================================================= */

    .delete-appointment-shell {
        position: relative;
        z-index: 2;
        width: min(1040px, 100%);
        margin: auto;
    }


    /* =========================================================
           TOP LINE
        ========================================================= */

    .delete-appointment-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
    }

    .delete-appointment-kicker {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .38em;
        text-transform: uppercase;
    }

        .delete-appointment-kicker::before {
            content: "";
            width: 46px;
            height: 1px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

    .delete-appointment-edition {
        color: var(--text-muted);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .23em;
    }


    /* =========================================================
           MAIN CARD
        ========================================================= */

    .delete-appointment-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 145deg, rgba(255,255,255,.98), rgba(247,251,250,.96) );
        border: 1px solid var(--line);
        box-shadow: 0 35px 90px rgba(23,51,52,.075);
    }

        .delete-appointment-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            right: 0;
            height: 3px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

        .delete-appointment-card::after {
            content: "A";
            position: absolute;
            right: -20px;
            bottom: -105px;
            color: rgba(22,156,152,.035);
            font-family: Georgia, serif;
            font-size: 250px;
            line-height: .8;
            pointer-events: none;
        }


    /* =========================================================
           HERO
        ========================================================= */

    .delete-appointment-hero {
        display: grid;
        grid-template-columns: 1fr 270px;
        gap: 55px;
        align-items: end;
        padding: 52px 55px 42px;
        border-bottom: 1px solid var(--line);
    }

    .delete-appointment-label {
        position: relative;
        z-index: 2;
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .32em;
    }

    .delete-appointment-title {
        position: relative;
        z-index: 2;
        margin: 25px 0 0;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(4.4rem, 7.4vw, 7.8rem);
        font-weight: 400;
        line-height: .75;
        letter-spacing: -.085em;
    }

    .delete-appointment-intro {
        max-width: 520px;
        margin-top: 28px;
        padding-left: 19px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.95;
    }


    /* =========================================================
           SIDE NOTE
        ========================================================= */

    .delete-appointment-side {
        padding: 24px;
        background: var(--ivory);
        border: 1px solid var(--line);
        box-shadow: 0 22px 48px rgba(23,51,52,.04);
    }

    .delete-appointment-side-number {
        color: var(--burgundy);
        font-family: Georgia, serif;
        font-size: 49px;
        line-height: .8;
        letter-spacing: -.07em;
    }

    .delete-appointment-side-label {
        margin-top: 14px;
        color: var(--teal-deep);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .19em;
    }

    .delete-appointment-side-copy {
        margin-top: 11px;
        color: var(--text-muted);
        font-size: 8px;
        line-height: 1.85;
    }

    .delete-appointment-side-line {
        width: 38px;
        height: 1px;
        margin-top: 21px;
        background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
    }


    /* =========================================================
           APPOINTMENT SUMMARY
        ========================================================= */

    .delete-appointment-summary {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 0;
    }

    .delete-appointment-primary {
        position: relative;
        z-index: 2;
        padding: 40px 55px;
        border-right: 1px solid var(--line);
    }

    .summary-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .27em;
    }

    .summary-client {
        margin-top: 18px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 37px;
        font-weight: 400;
        line-height: .92;
        letter-spacing: -.05em;
    }

    .summary-service {
        margin-top: 12px;
        color: var(--text-soft);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .summary-artist {
        margin-top: 7px;
        color: var(--text-muted);
        font-size: 9px;
    }


    /* =========================================================
           TIME BOX
        ========================================================= */

    .delete-appointment-time {
        padding: 40px;
        background: var(--teal-pale);
    }

    .time-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .25em;
    }

    .time-value {
        margin-top: 19px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 29px;
        font-weight: 400;
        line-height: .95;
        letter-spacing: -.045em;
    }

    .time-meta {
        margin-top: 9px;
        color: var(--text-muted);
        font-size: 8px;
        line-height: 1.7;
    }


    /* =========================================================
           WARNING MESSAGE
        ========================================================= */

    .delete-appointment-warning {
        position: relative;
        z-index: 2;
        margin: 0 55px;
        padding: 25px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        color: var(--text-muted);
        font-size: 9px;
        line-height: 1.9;
    }

        .delete-appointment-warning strong {
            display: block;
            margin-bottom: 7px;
            color: var(--burgundy);
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .16em;
        }


    /* =========================================================
           ACTIONS
        ========================================================= */

    .delete-appointment-actions {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin: 0 55px;
        padding: 28px 0 35px;
    }

    .delete-appointment-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        transition: color .3s ease, transform .3s ease;
    }

        .delete-appointment-cancel:hover {
            color: var(--teal-deep);
            transform: translateX(-3px);
        }

    .delete-appointment-form {
        margin: 0;
    }

    .delete-appointment-confirm {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 51px;
        padding: 0 25px;
        border: 0;
        background: var(--burgundy);
        color: white;
        font-family: inherit;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        cursor: pointer;
        box-shadow: 0 14px 30px rgba(115,27,53,.14);
        transition: transform .35s ease, background .35s ease, box-shadow .35s ease;
    }

        .delete-appointment-confirm::after {
            content: "→";
            color: var(--burgundy-soft);
            font-size: 14px;
            transition: transform .35s ease;
        }

        .delete-appointment-confirm:hover {
            transform: translateY(-3px);
            background: var(--burgundy-dark);
            box-shadow: 0 18px 38px rgba(82,17,38,.18);
        }

            .delete-appointment-confirm:hover::after {
                transform: translateX(4px);
            }


    /* =========================================================
           FOOTNOTE
        ========================================================= */

    .delete-appointment-footnote {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 55px 22px;
        color: var(--text-muted);
        font-size: 7px;
        line-height: 1.7;
    }

        .delete-appointment-footnote::before {
            content: "03";
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 29px;
            width: 29px;
            height: 29px;
            border: 1px solid rgba(115,27,53,.18);
            border-radius: 50%;
            color: var(--burgundy);
            font-family: Georgia, serif;
            font-size: 10px;
        }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 850px) {

        .delete-appointment-shell {
            width: min(850px, calc(100% - 30px));
        }

        .delete-appointment-hero {
            grid-template-columns: 1fr;
            gap: 30px;
            padding: 45px 40px 38px;
        }

        .delete-appointment-primary {
            padding: 34px 40px;
        }

        .delete-appointment-time {
            padding: 34px 40px;
        }

        .delete-appointment-warning,
        .delete-appointment-actions {
            margin-left: 40px;
            margin-right: 40px;
        }

        .delete-appointment-footnote {
            padding-left: 40px;
            padding-right: 40px;
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 620px) {

        .delete-appointment-page {
            align-items: flex-start;
            padding: 82px 14px 60px;
        }

            .delete-appointment-page::before {
                top: 75px;
                right: -30px;
                font-size: 17rem;
            }

        .delete-appointment-shell {
            width: 100%;
        }

        .delete-appointment-topline {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .delete-appointment-hero {
            padding: 36px 23px 32px;
        }

        .delete-appointment-title {
            font-size: 4.35rem;
        }

        .delete-appointment-intro {
            font-size: 9px;
        }

        .delete-appointment-summary {
            grid-template-columns: 1fr;
        }

        .delete-appointment-primary {
            padding: 30px 23px;
            border-right: 0;
            border-bottom: 1px solid var(--line);
        }

        .delete-appointment-time {
            padding: 30px 23px;
        }

        .summary-client {
            font-size: 32px;
        }

        .time-value {
            font-size: 26px;
        }

        .delete-appointment-warning {
            margin: 0 23px;
        }

        .delete-appointment-actions {
            align-items: stretch;
            flex-direction: column-reverse;
            margin: 0 23px;
            padding-top: 24px;
        }

        .delete-appointment-form {
            width: 100%;
        }

        .delete-appointment-confirm {
            width: 100%;
        }

        .delete-appointment-cancel {
            justify-content: center;
        }

        .delete-appointment-footnote {
            padding-left: 23px;
            padding-right: 23px;
        }
    }


    /* =========================================================
           SMALL MOBILE
        ========================================================= */

    @@media (max-width: 430px) {

        .delete-appointment-page {
            padding-left: 10px;
            padding-right: 10px;
        }

        .delete-appointment-hero {
            padding: 31px 19px 28px;
        }

        .delete-appointment-title {
            font-size: 3.85rem;
        }

        .delete-appointment-kicker {
            font-size: 7px;
            letter-spacing: .28em;
        }

        .delete-appointment-primary {
            padding: 27px 19px;
        }

        .delete-appointment-time {
            padding: 27px 19px;
        }

        .delete-appointment-warning {
            margin-left: 19px;
            margin-right: 19px;
        }

        .delete-appointment-actions {
            margin-left: 19px;
            margin-right: 19px;
        }

        .delete-appointment-footnote {
            padding-left: 19px;
            padding-right: 19px;
        }

        .summary-client {
            font-size: 29px;
        }

        .time-value {
            font-size: 23px;
        }
    }


    /* =========================================================
           REDUCED MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .delete-appointment-page *,
        .delete-appointment-page *::before,
        .delete-appointment-page *::after {
            transition: none !important;
            animation: none !important;
        }
    }

</style>


<div class="delete-appointment-page">

    <div class="delete-appointment-shell">


        <!-- =====================================================
             TOP LINE
        ====================================================== -->

        <div class="delete-appointment-topline">

            <div class="delete-appointment-kicker">
                AUREVA / REMOVE APPOINTMENT
            </div>

            <div class="delete-appointment-edition">
                APPOINTMENT RECORD / 03
            </div>

        </div>


        <!-- =====================================================
             MAIN CARD
        ====================================================== -->

        <section class="delete-appointment-card">


            <!-- HERO -->

            <div class="delete-appointment-hero">

                <div>

                    <div class="delete-appointment-label">
                        PERMANENT ACTION
                    </div>

                    <h1 class="delete-appointment-title">
                        Remove
                        <br />
                        this moment?
                    </h1>

                    <p class="delete-appointment-intro">
                        Removing this appointment will erase
                        this booking from the AUREVA rhythm.
                        Please review the details before continuing.
                    </p>

                </div>


                <div class="delete-appointment-side">

                    <div class="delete-appointment-side-number">
                        03
                    </div>

                    <div class="delete-appointment-side-label">
                        CONFIRM REMOVAL
                    </div>

                    <div class="delete-appointment-side-copy">
                        This is a permanent action.
                        The appointment cannot be restored
                        once removed.
                    </div>

                    <div class="delete-appointment-side-line"></div>

                </div>

            </div>


            <!-- APPOINTMENT SUMMARY -->

            <div class="delete-appointment-summary">


                <div class="delete-appointment-primary">

                    <div class="summary-label">
                        CLIENT / SERVICE
                    </div>

                    <div class="summary-client">
                        @Model.Client?.FullName
                    </div>

                    <div class="summary-service">
                        @Model.Service?.Name
                    </div>

                    <div class="summary-artist">
                        With @Model.Staff?.FullName
                    </div>

                </div>


                <div class="delete-appointment-time">

                    <div class="time-label">
                        DATE & TIME
                    </div>

                    <div class="time-value">
                        @Model.StartTime.ToString("dd MMM yyyy · HH:mm")
                    </div>

                    <div class="time-meta">
                        Duration:
                        @Model.DurationMinutes minutes
                    </div>

                </div>

            </div>


            <!-- WARNING -->

            <div class="delete-appointment-warning">

                <strong>
                    THIS APPOINTMENT WILL BE PERMANENTLY REMOVED
                </strong>

                This action cannot be undone.
                Make sure this is the correct appointment
                before confirming its removal.

            </div>


            <!-- ACTIONS -->

            <div class="delete-appointment-actions">


                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="delete-appointment-cancel">

                    ← CANCEL / KEEP APPOINTMENT

                </a>


                <form asp-action="Delete"
                      method="post"
                      class="delete-appointment-form">

                    <input type="hidden"
                           asp-for="Id" />

                    <button type="submit"
                            class="delete-appointment-confirm">

                        DELETE APPOINTMENT

                    </button>

                </form>

            </div>


            <!-- FOOTNOTE -->

            <div class="delete-appointment-footnote">

                Please verify the client, service, artist and
                appointment time before proceeding.

            </div>


        </section>

    </div>

</div>