@model AUREVA.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<style>
    /* =========================================================
           AUREVA / APPOINTMENT DETAILS
           EDITORIAL LUXURY — MODERN ATELIER
        ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .appointment-details-page {
        --teal: #169C98;
        --teal-dark: #0B7773;
        --teal-deep: #064F50;
        --teal-soft: #DDF3F1;
        --teal-pale: #F2F9F8;
        --burgundy: #731B35;
        --burgundy-dark: #521126;
        --burgundy-soft: #D9AEB9;
        --burgundy-pale: #FAF0F3;
        --white: #FFFFFF;
        --ivory: #F8F7F2;
        --ivory-dark: #ECECE5;
        --text: #173334;
        --text-soft: #4E6563;
        --text-muted: #81918F;
        --text-faint: #A9B8B6;
        --line: rgba(23,51,52,.10);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        padding: 145px 0 100px;
        background: radial-gradient( circle at 88% 5%, rgba(22,156,152,.12), transparent 25% ), radial-gradient( circle at 5% 75%, rgba(115,27,53,.07), transparent 27% ), linear-gradient( 180deg, #FFFFFF 0%, #F8F7F2 58%, #ECECE5 100% );
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .appointment-details-page *,
        .appointment-details-page *::before,
        .appointment-details-page *::after {
            box-sizing: border-box;
        }

        .appointment-details-page a {
            -webkit-tap-highlight-color: transparent;
        }


        /* =========================================================
           BACKGROUND A
        ========================================================= */

        .appointment-details-page::before {
            content: "A";
            position: absolute;
            right: -45px;
            top: 65px;
            color: rgba(22,156,152,.085);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 34vw, 34rem);
            line-height: .72;
            pointer-events: none;
            user-select: none;
        }

        .appointment-details-page::after {
            content: "";
            position: absolute;
            left: -260px;
            top: 480px;
            width: 520px;
            height: 520px;
            border: 1px solid rgba(22,156,152,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 48px rgba(22,156,152,.022), 0 0 0 95px rgba(115,27,53,.015);
            pointer-events: none;
        }


    /* =========================================================
           SHELL
        ========================================================= */

    .appointment-details-shell {
        position: relative;
        z-index: 2;
        width: min(1260px, calc(100% - 64px));
        margin: auto;
    }


    /* =========================================================
           TOP LINE
        ========================================================= */

    .appointment-details-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 40px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
    }

    .appointment-details-kicker {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .38em;
        text-transform: uppercase;
    }

        .appointment-details-kicker::before {
            content: "";
            width: 47px;
            height: 1px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

    .appointment-details-edition {
        color: var(--text-muted);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .24em;
    }


    /* =========================================================
           HERO
        ========================================================= */

    .appointment-details-hero {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 65px;
        align-items: end;
        padding-bottom: 45px;
        border-bottom: 1px solid var(--line);
    }

    .appointment-details-title {
        margin: 0;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(5rem, 8vw, 8.5rem);
        font-weight: 400;
        line-height: .73;
        letter-spacing: -.085em;
    }

    .appointment-details-intro {
        max-width: 390px;
        margin-top: 30px;
        padding-left: 19px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.95;
    }


    /* =========================================================
           HERO SIDE NOTE
        ========================================================= */

    .appointment-details-side {
        padding: 25px;
        background: rgba(255,255,255,.80);
        border: 1px solid var(--line);
        box-shadow: 0 25px 60px rgba(23,51,52,.05);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .appointment-details-side-number {
        color: var(--burgundy);
        font-family: Georgia, serif;
        font-size: 50px;
        line-height: .8;
        letter-spacing: -.07em;
    }

    .appointment-details-side-label {
        margin-top: 14px;
        color: var(--teal-deep);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .20em;
    }

    .appointment-details-side-copy {
        margin-top: 12px;
        color: var(--text-muted);
        font-size: 8px;
        line-height: 1.85;
    }

    .appointment-details-side-line {
        width: 38px;
        height: 1px;
        margin-top: 22px;
        background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
    }


    /* =========================================================
           MAIN FRAME
        ========================================================= */

    .appointment-details-frame {
        display: grid;
        grid-template-columns: 310px 1fr;
        margin-top: 38px;
        background: rgba(255,255,255,.92);
        border: 1px solid var(--line);
        box-shadow: 0 35px 90px rgba(23,51,52,.075);
    }


    /* =========================================================
           LEFT PANEL
        ========================================================= */

    .appointment-details-panel {
        position: relative;
        overflow: hidden;
        min-height: 610px;
        padding: 40px 30px;
        background: linear-gradient( 155deg, var(--teal-deep) 0%, #07595A 50%, var(--teal-dark) 100% );
        color: white;
    }

        .appointment-details-panel::before {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            right: -180px;
            bottom: -190px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 45px rgba(255,255,255,.022), 0 0 0 90px rgba(115,27,53,.035);
        }

        .appointment-details-panel::after {
            content: "A";
            position: absolute;
            right: -25px;
            top: 20px;
            color: rgba(255,255,255,.045);
            font-family: Georgia, serif;
            font-size: 190px;
            line-height: .8;
            pointer-events: none;
        }

    .panel-kicker {
        position: relative;
        z-index: 2;
        color: var(--teal-soft);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .29em;
    }

    .panel-title {
        position: relative;
        z-index: 2;
        margin-top: 21px;
        color: white;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 38px;
        font-weight: 400;
        line-height: .9;
        letter-spacing: -.05em;
    }

    .panel-line {
        position: relative;
        z-index: 2;
        width: 44px;
        height: 1px;
        margin: 29px 0;
        background: var(--burgundy-soft);
    }

    .panel-copy {
        position: relative;
        z-index: 2;
        max-width: 230px;
        color: rgba(255,255,255,.58);
        font-size: 9px;
        line-height: 1.9;
    }

    .panel-mark {
        position: absolute;
        z-index: 3;
        left: 30px;
        bottom: 35px;
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.20);
        border-radius: 50%;
        color: var(--burgundy-soft);
        font-family: Georgia, serif;
        font-size: 29px;
    }

        .panel-mark::before {
            content: "";
            position: absolute;
            inset: 7px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 50%;
        }


    /* =========================================================
           CONTENT
        ========================================================= */

    .appointment-details-content {
        position: relative;
        overflow: hidden;
        padding: 45px;
    }

        .appointment-details-content::after {
            content: "A";
            position: absolute;
            right: -15px;
            bottom: -100px;
            color: rgba(22,156,152,.035);
            font-family: Georgia, serif;
            font-size: 230px;
            line-height: .8;
            pointer-events: none;
        }


    /* =========================================================
           DETAIL GRID
        ========================================================= */

    .appointment-info-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
    }

    .appointment-info-item {
        min-height: 155px;
        padding: 28px;
        background: rgba(250,252,251,.78);
        transition: background .35s ease;
    }

        .appointment-info-item:hover {
            background: var(--teal-pale);
        }

    .appointment-info-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .24em;
    }

    .appointment-info-value {
        margin-top: 29px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 25px;
        font-weight: 400;
        line-height: 1;
        letter-spacing: -.035em;
        word-break: break-word;
    }

        .appointment-info-value.compact {
            font-size: 20px;
        }

        .appointment-info-value.status {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .18em;
        }

            .appointment-info-value.status::before {
                content: "";
                width: 7px;
                height: 7px;
                flex: 0 0 7px;
                border-radius: 50%;
                background: var(--burgundy);
                box-shadow: 0 0 0 5px rgba(115,27,53,.08);
            }


    /* =========================================================
           NOTES
        ========================================================= */

    .appointment-notes {
        position: relative;
        z-index: 2;
        margin-top: 24px;
        padding: 35px 32px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        background: rgba(255,255,255,.46);
    }

    .appointment-notes-label {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .29em;
    }

        .appointment-notes-label::after {
            content: "";
            flex: 1;
            height: 1px;
            background: linear-gradient( 90deg, var(--line), transparent );
        }

    .appointment-notes-text {
        max-width: 850px;
        margin-top: 22px;
        color: var(--text-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 24px;
        font-weight: 400;
        line-height: 1.25;
        letter-spacing: -.025em;
    }


    /* =========================================================
           ACTIONS
        ========================================================= */

    .appointment-details-actions {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 38px;
        padding-top: 25px;
        border-top: 1px solid var(--line);
    }

    .appointment-details-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        transition: color .3s ease, transform .3s ease;
    }

        .appointment-details-back:hover {
            color: var(--burgundy);
            transform: translateX(-3px);
        }

    .appointment-details-action-group {
        display: flex;
        gap: 10px;
    }

    .appointment-details-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 47px;
        padding: 0 22px;
        border: 1px solid rgba(23,51,52,.15);
        border-radius: 0;
        background: transparent;
        color: var(--text);
        text-decoration: none;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .19em;
        cursor: pointer;
        transition: transform .35s ease, background .35s ease, border-color .35s ease, color .35s ease, box-shadow .35s ease;
    }

        .appointment-details-action:hover {
            transform: translateY(-3px);
            background: var(--teal-deep);
            border-color: var(--teal-deep);
            color: white;
            box-shadow: 0 14px 30px rgba(6,79,80,.14);
        }

        .appointment-details-action.delete {
            background: var(--burgundy);
            border-color: var(--burgundy);
            color: white;
        }

            .appointment-details-action.delete:hover {
                background: var(--burgundy-dark);
                border-color: var(--burgundy-dark);
                box-shadow: 0 14px 30px rgba(82,17,38,.16);
            }


    /* =========================================================
           BOTTOM PHILOSOPHY
        ========================================================= */

    .appointment-details-philosophy {
        display: grid;
        grid-template-columns: 75px 1fr 240px;
        gap: 40px;
        align-items: center;
        margin-top: 68px;
        padding: 40px;
        background: linear-gradient( 135deg, #F4F3ED, #FFFEFA );
        border: 1px solid var(--line);
    }

    .philosophy-mark {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 70px;
        height: 70px;
        border: 1px solid rgba(115,27,53,.22);
        border-radius: 50%;
        color: var(--burgundy);
        font-family: Georgia, serif;
        font-size: 30px;
    }

        .philosophy-mark::before {
            content: "";
            position: absolute;
            inset: 7px;
            border: 1px solid rgba(115,27,53,.09);
            border-radius: 50%;
        }

    .philosophy-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .30em;
    }

    .philosophy-title {
        margin: 12px 0 0;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.2rem, 3.5vw, 3.7rem);
        font-weight: 400;
        line-height: .88;
        letter-spacing: -.06em;
    }

        .philosophy-title span {
            color: var(--burgundy);
        }

    .philosophy-copy {
        padding-left: 18px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 9px;
        line-height: 1.9;
    }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 1000px) {

        .appointment-details-shell {
            width: min(1180px, calc(100% - 48px));
        }

        .appointment-details-hero {
            grid-template-columns: 1fr 270px;
            gap: 35px;
        }

        .appointment-details-frame {
            grid-template-columns: 230px 1fr;
        }

        .appointment-details-content {
            padding: 35px;
        }

        .appointment-details-panel {
            padding: 34px 24px;
        }

        .appointment-details-philosophy {
            grid-template-columns: 70px 1fr;
        }

        .philosophy-copy {
            grid-column: 2;
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 760px) {

        .appointment-details-page {
            padding: 105px 0 65px;
        }

            .appointment-details-page::before {
                right: -30px;
                top: 85px;
                font-size: 18rem;
            }

        .appointment-details-shell {
            width: calc(100% - 28px);
        }

        .appointment-details-topline {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .appointment-details-hero {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .appointment-details-title {
            font-size: clamp(4.3rem, 18vw, 6.8rem);
        }

        .appointment-details-side {
            max-width: 330px;
        }

        .appointment-details-frame {
            display: block;
        }

        .appointment-details-panel {
            min-height: 330px;
        }

        .appointment-details-content {
            padding: 29px 22px;
        }

        .appointment-info-grid {
            grid-template-columns: 1fr;
        }

        .appointment-info-item {
            min-height: 130px;
        }

        .appointment-info-value {
            margin-top: 24px;
            font-size: 23px;
        }

        .appointment-notes {
            padding: 30px 0;
        }

        .appointment-notes-text {
            font-size: 21px;
        }

        .appointment-details-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .appointment-details-action-group {
            width: 100%;
            flex-wrap: wrap;
        }

        .appointment-details-action {
            flex: 1;
        }

        .appointment-details-philosophy {
            grid-template-columns: 1fr;
            gap: 24px;
            padding: 31px 24px;
        }

        .philosophy-copy {
            grid-column: auto;
        }

        .philosophy-title {
            font-size: 2.8rem;
        }
    }


    /* =========================================================
           SMALL MOBILE
        ========================================================= */

    @@media (max-width: 430px) {

        .appointment-details-shell {
            width: calc(100% - 20px);
        }

        .appointment-details-title {
            font-size: 4.05rem;
        }

        .appointment-details-kicker {
            font-size: 7px;
            letter-spacing: .29em;
        }

        .appointment-details-panel {
            padding: 28px 20px;
        }

        .panel-title {
            font-size: 31px;
        }

        .panel-mark {
            left: 20px;
        }

        .appointment-details-content {
            padding: 25px 18px;
        }

        .appointment-info-item {
            padding: 24px;
        }

        .appointment-info-value {
            font-size: 21px;
        }

        .appointment-details-action-group {
            flex-direction: column;
        }

        .appointment-details-action {
            width: 100%;
            min-height: 48px;
        }

        .philosophy-title {
            font-size: 2.4rem;
        }
    }


    /* =========================================================
           REDUCED MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .appointment-details-page *,
        .appointment-details-page *::before,
        .appointment-details-page *::after {
            transition: none !important;
            animation: none !important;
        }
    }

</style>


<div class="appointment-details-page">

    <div class="appointment-details-shell">

        <!-- =====================================================
             TOP LINE
        ====================================================== -->

        <div class="appointment-details-topline">

            <div class="appointment-details-kicker">
                AUREVA / APPOINTMENT
            </div>

            <div class="appointment-details-edition">
                APPOINTMENT PROFILE / 01
            </div>

        </div>


        <!-- =====================================================
             HERO
        ====================================================== -->

        <section class="appointment-details-hero">

            <div>

                <h1 class="appointment-details-title">
                    The moment.
                </h1>

                <p class="appointment-details-intro">
                    Every appointment is a carefully placed
                    moment within the rhythm of the AUREVA
                    atelier — connecting the right client,
                    service, artist and time.
                </p>

            </div>


            <div class="appointment-details-side">

                <div class="appointment-details-side-number">
                    01
                </div>

                <div class="appointment-details-side-label">
                    EXPERIENCE DETAILS
                </div>

                <div class="appointment-details-side-copy">
                    A complete view of this appointment,
                    from the client arriving to the
                    artist welcoming them.
                </div>

                <div class="appointment-details-side-line"></div>

            </div>

        </section>


        <!-- =====================================================
             MAIN FRAME
        ====================================================== -->

        <section class="appointment-details-frame">


            <!-- =================================================
                 LEFT PANEL
            ================================================== -->

            <aside class="appointment-details-panel">

                <div class="panel-kicker">
                    AUREVA / ATELIER
                </div>

                <div class="panel-title">
                    A moment
                    <br />
                    made personal.
                </div>

                <div class="panel-line"></div>

                <div class="panel-copy">
                    The details behind every booking
                    shape the experience before it
                    even begins. AUREVA keeps each
                    one clear and considered.
                </div>

                <div class="panel-mark">
                    A
                </div>

            </aside>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="appointment-details-content">


                <!-- APPOINTMENT INFORMATION -->

                <div class="appointment-info-grid">


                    <!-- CLIENT -->

                    <div class="appointment-info-item">

                        <div class="appointment-info-label">
                            CLIENT
                        </div>

                        <div class="appointment-info-value">

                            @Model.Client?.FullName

                        </div>

                    </div>


                    <!-- SERVICE -->

                    <div class="appointment-info-item">

                        <div class="appointment-info-label">
                            SERVICE
                        </div>

                        <div class="appointment-info-value">

                            @Model.Service?.Name

                        </div>

                    </div>


                    <!-- ARTIST -->

                    <div class="appointment-info-item">

                        <div class="appointment-info-label">
                            ARTIST
                        </div>

                        <div class="appointment-info-value">

                            @Model.Staff?.FullName

                        </div>

                    </div>


                    <!-- DATE & TIME -->

                    <div class="appointment-info-item">

                        <div class="appointment-info-label">
                            DATE & TIME
                        </div>

                        <div class="appointment-info-value compact">

                            @Model.StartTime.ToString("dd MMM yyyy · HH:mm")

                        </div>

                    </div>


                    <!-- DURATION -->

                    <div class="appointment-info-item">

                        <div class="appointment-info-label">
                            DURATION
                        </div>

                        <div class="appointment-info-value">

                            @Model.DurationMinutes

                            <span style="
                                font-family:'Segoe UI',Arial,sans-serif;
                                font-size:8px;
                                font-weight:800;
                                letter-spacing:.15em;
                                color:var(--text-muted);
                                ">
                                MINUTES
                            </span>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="appointment-info-item">

                        <div class="appointment-info-label">
                            STATUS
                        </div>

                        <div class="appointment-info-value status">

                            @Model.Status.ToUpper()

                        </div>

                    </div>

                </div>


                <!-- NOTES -->

                <div class="appointment-notes">

                    <div class="appointment-notes-label">
                        NOTES
                    </div>

                    <div class="appointment-notes-text">

                        @(string.IsNullOrWhiteSpace(Model.Notes)
                            ? "No notes for this appointment."
                            : Model.Notes)

                    </div>

                </div>


                <!-- ACTIONS -->

                <div class="appointment-details-actions">

                    <a asp-action="Index"
                       class="appointment-details-back">

                        ← BACK TO APPOINTMENTS

                    </a>


                    <div class="appointment-details-action-group">

                        <a asp-action="Edit"
