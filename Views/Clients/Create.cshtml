@model AUREVA.Models.Client

@{
    ViewData["Title"] = "New Client";
}

<style>
    /* =========================================================
           AUREVA / NEW CLIENT
           EDITORIAL LUXURY — MODERN ATELIER
        ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .client-create-page {
        --teal: #19B8B2;
        --teal-dark: #087F7A;
        --teal-deep: #075B5A;
        --teal-soft: #DDF5F3;
        --teal-pale: #F1FBFA;
        --burgundy: #800020;
        --burgundy-dark: #5C0017;
        --burgundy-soft: #E8C5CD;
        --burgundy-pale: #FAEFF2;
        --white: #FFFFFF;
        --ivory: #FAFCFB;
        --ivory-dark: #EEF5F4;
        --text: #183333;
        --text-soft: #486361;
        --text-muted: #78908E;
        --line: rgba(24,51,51,.10);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        background: radial-gradient( circle at 88% 6%, rgba(25,184,178,.14), transparent 25% ), radial-gradient( circle at 5% 75%, rgba(128,0,32,.07), transparent 27% ), linear-gradient( 180deg, #FFFFFF 0%, #FAFCFB 58%, #EEF5F4 100% );
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .client-create-page *,
        .client-create-page *::before,
        .client-create-page *::after {
            box-sizing: border-box;
        }

        .client-create-page a {
            -webkit-tap-highlight-color: transparent;
        }


        /* =========================================================
           BACKGROUND MARK
        ========================================================= */

        .client-create-page::before {
            content: "A";
            position: absolute;
            right: -40px;
            top: 80px;
            color: rgba(25,184,178,.085);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 34vw, 34rem);
            line-height: .72;
            pointer-events: none;
            user-select: none;
        }

        .client-create-page::after {
            content: "";
            position: absolute;
            left: -260px;
            top: 500px;
            width: 520px;
            height: 520px;
            border: 1px solid rgba(25,184,178,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 48px rgba(25,184,178,.022), 0 0 0 95px rgba(128,0,32,.015);
            pointer-events: none;
        }


    /* =========================================================
           ORIGINAL DECORATIVE ORBS
        ========================================================= */

    .luxury-orb {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(1px);
    }

        .luxury-orb.one {
            width: 380px;
            height: 380px;
            top: -180px;
            left: -120px;
            background: radial-gradient( circle at 35% 35%, rgba(25,184,178,.18), rgba(25,184,178,.045) 55%, transparent 72% );
        }

        .luxury-orb.two {
            width: 460px;
            height: 460px;
            right: -210px;
            bottom: -170px;
            background: radial-gradient( circle at 45% 45%, rgba(128,0,32,.10), rgba(128,0,32,.035) 55%, transparent 72% );
        }


    /* =========================================================
           NAVIGATION
        ========================================================= */

    .create-nav {
        position: fixed;
        z-index: 100;
        top: 25px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        padding: 7px;
        background: rgba(255,255,255,.86);
        border: 1px solid rgba(24,51,51,.09);
        border-radius: 999px;
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        box-shadow: 0 18px 55px rgba(24,51,51,.07);
    }

        .create-nav button {
            border: 0;
            background: transparent;
            color: var(--text-soft);
            padding: 12px 18px;
            border-radius: 999px;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .20em;
            cursor: pointer;
            transition: background .3s ease, color .3s ease, transform .3s ease;
        }

            .create-nav button:hover {
                background: var(--burgundy);
                color: white;
                transform: translateY(-1px);
                box-shadow: 0 10px 24px rgba(92,0,23,.12);
            }

    .create-logo {
        padding: 0 23px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 17px;
        font-weight: 400;
        letter-spacing: .13em;
    }

    .create-divider {
        width: 1px;
        height: 19px;
        background: rgba(24,51,51,.10);
    }


    /* =========================================================
           MAIN SHELL
        ========================================================= */

    .create-shell {
        position: relative;
        z-index: 2;
        width: min(1320px, calc(100% - 64px));
        margin: 0 auto;
        padding: 150px 0 100px;
    }


    /* =========================================================
           HEADER
        ========================================================= */

    .create-header {
        display: grid;
        grid-template-columns: 1fr 330px;
        gap: 65px;
        align-items: end;
        padding-bottom: 44px;
        border-bottom: 1px solid var(--line);
    }

    .create-kicker {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .38em;
        text-transform: uppercase;
    }

        .create-kicker::before {
            content: "";
            width: 47px;
            height: 1px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

    .create-title {
        margin: 25px 0 0;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(4.8rem, 8vw, 8.8rem);
        font-weight: 400;
        line-height: .73;
        letter-spacing: -.085em;
    }

        .create-title span {
            display: block;
            color: var(--burgundy);
        }

    .create-intro {
        max-width: 350px;
        margin: 0 0 5px auto;
        padding-left: 18px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.95;
    }

        .create-intro strong {
            color: var(--burgundy);
            font-weight: 800;
        }


    /* =========================================================
           FORM LAYOUT
        ========================================================= */

    .create-form-wrap {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 55px;
        margin-top: 56px;
    }


    /* =========================================================
           SIDE PANEL
        ========================================================= */

    .create-side {
        position: relative;
        align-self: start;
        min-height: 520px;
        padding: 40px 30px;
        overflow: hidden;
        border-radius: 0;
        background: linear-gradient( 155deg, var(--teal-deep) 0%, #07595A 48%, var(--teal-dark) 100% );
        color: white;
        box-shadow: 0 30px 75px rgba(7,91,90,.13);
    }

        .create-side::before {
            content: "";
            position: absolute;
            width: 380px;
            height: 380px;
            right: -175px;
            bottom: -190px;
            border: 1px solid rgba(255,255,255,.09);
            border-radius: 50%;
            box-shadow: 0 0 0 45px rgba(255,255,255,.022), 0 0 0 90px rgba(128,0,32,.035);
        }

        .create-side::after {
            content: "A";
            position: absolute;
            right: -20px;
            top: 25px;
            color: rgba(255,255,255,.045);
            font-family: Georgia, serif;
            font-size: 180px;
            line-height: .8;
            pointer-events: none;
        }

    .create-side-label {
        position: relative;
        z-index: 2;
        color: var(--teal-soft);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .29em;
    }

    .create-side-title {
        position: relative;
        z-index: 2;
        margin-top: 21px;
        color: white;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 39px;
        font-weight: 400;
        line-height: .9;
        letter-spacing: -.05em;
    }

        .create-side-title span {
            color: var(--burgundy-soft);
        }

    .create-side-text {
        position: relative;
        z-index: 2;
        max-width: 245px;
        margin-top: 27px;
        color: rgba(255,255,255,.58);
        font-size: 9px;
        line-height: 1.9;
    }

    .create-side-mark {
        position: absolute;
        z-index: 3;
        left: 30px;
        bottom: 35px;
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.20);
        border-radius: 50%;
        color: var(--burgundy-soft);
        font-family: Georgia, serif;
        font-size: 27px;
    }

        .create-side-mark::before {
            content: "";
            position: absolute;
            inset: 7px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 50%;
        }


    /* =========================================================
           FORM CARD
        ========================================================= */

    .create-form {
        position: relative;
        overflow: hidden;
        padding: 46px;
        background: linear-gradient( 145deg, rgba(255,255,255,.98), rgba(247,251,250,.95) );
        border: 1px solid var(--line);
        border-radius: 0;
        box-shadow: 0 35px 90px rgba(24,51,51,.075);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

        .create-form::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

        .create-form::after {
            content: "A";
            position: absolute;
            right: -22px;
            bottom: -90px;
            color: rgba(25,184,178,.035);
            font-family: Georgia, serif;
            font-size: 220px;
            line-height: .8;
            pointer-events: none;
        }


        /* =========================================================
           VALIDATION
        ========================================================= */

        .create-form
        .validation-summary-errors {
            position: relative;
            z-index: 3;
            margin-bottom: 26px;
            padding: 14px 17px;
            border: 1px solid rgba(128,0,32,.09);
            background: var(--burgundy-pale);
            color: var(--burgundy);
            font-size: 8px;
            line-height: 1.7;
        }


    /* =========================================================
           FORM SECTIONS
        ========================================================= */

    .create-section {
        position: relative;
        z-index: 2;
        padding-bottom: 34px;
        margin-bottom: 34px;
        border-bottom: 1px solid var(--line);
    }

        .create-section:last-of-type {
            border-bottom: 0;
            margin-bottom: 0;
        }

    .create-section-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 27px;
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .30em;
    }

        .create-section-heading::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--teal);
            box-shadow: 0 0 0 5px rgba(25,184,178,.09);
        }

        .create-section-heading::after {
            content: "";
            flex: 1;
            height: 1px;
            background: linear-gradient( 90deg, rgba(24,51,51,.10), transparent );
        }


    /* =========================================================
           GRID
        ========================================================= */

    .create-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 27px 30px;
    }

    .create-field {
        position: relative;
    }

        .create-field.full {
            grid-column: 1 / -1;
        }

        .create-field label {
            display: block;
            margin-bottom: 9px;
            color: var(--burgundy);
            font-size: 7px;
            font-weight: 800;
            letter-spacing: .22em;
            text-transform: uppercase;
        }


        /* =========================================================
           INPUTS
        ========================================================= */

        .create-field input,
        .create-field textarea {
            width: 100%;
            padding: 14px;
            border: 1px solid rgba(7,91,90,.13);
            border-radius: 0;
            outline: none;
            background: var(--teal-pale);
            color: var(--teal-deep);
            font-family: inherit;
            font-size: 11px;
            font-weight: 600;
            transition: border-color .3s ease, background .3s ease, box-shadow .3s ease, transform .3s ease;
        }

        .create-field textarea {
            min-height: 125px;
            resize: vertical;
            line-height: 1.75;
        }

            .create-field input::placeholder,
            .create-field textarea::placeholder {
                color: rgba(7,91,90,.30);
            }

            .create-field input:focus,
            .create-field textarea:focus {
                border-color: var(--teal);
                background: white;
                box-shadow: 0 0 0 3px rgba(25,184,178,.08), 0 10px 25px rgba(24,51,51,.045);
                transform: translateY(-1px);
            }

        .create-field input[type="date"]::-webkit-calendar-picker-indicator {
            opacity: .45;
            cursor: pointer;
        }

        .create-field span {
            display: block;
            margin-top: 6px;
            color: var(--burgundy);
            font-size: 7px;
            line-height: 1.5;
        }


    /* =========================================================
           ACTIONS
        ========================================================= */

    .create-actions {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 40px;
        padding-top: 25px;
        border-top: 1px solid var(--line);
    }

    .create-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        transition: color .3s ease, transform .3s ease;
    }

        .create-cancel:hover {
            color: var(--burgundy);
            transform: translateX(-3px);
        }

    .create-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 52px;
        padding: 0 27px;
        border: 0;
        border-radius: 0;
        background: var(--burgundy);
        color: white;
        font-family: inherit;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        cursor: pointer;
        box-shadow: 0 14px 30px rgba(92,0,23,.12);
        transition: transform .35s ease, background .35s ease, box-shadow .35s ease;
    }

        .create-submit:hover {
            transform: translateY(-3px);
            background: var(--teal-deep);
            box-shadow: 0 18px 38px rgba(7,91,90,.18);
        }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 1000px) {

        .create-shell {
            width: min(1180px, calc(100% - 48px));
        }

        .create-header {
            grid-template-columns: 1fr 280px;
            gap: 35px;
        }

        .create-form-wrap {
            grid-template-columns: 220px 1fr;
            gap: 35px;
        }

        .create-side {
            padding: 34px 24px;
        }

        .create-form {
            padding: 35px;
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 760px) {

        .client-create-page::before {
            right: -30px;
            top: 110px;
            font-size: 18rem;
        }

        .create-nav {
            top: 15px;
            width: calc(100% - 28px);
            justify-content: space-between;
        }

            .create-nav button {
                padding: 10px 12px;
                font-size: 7px;
            }

        .create-logo {
            padding: 0 12px;
            font-size: 14px;
        }

        .create-shell {
            width: calc(100% - 28px);
            padding: 112px 0 65px;
        }

        .create-header {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .create-title {
            font-size: clamp(4.4rem, 18vw, 6.8rem);
        }

        .create-intro {
            margin-left: 0;
            max-width: 320px;
        }

        .create-form-wrap {
            grid-template-columns: 1fr;
            gap: 30px;
            margin-top: 45px;
        }

        .create-side {
            min-height: 300px;
            padding: 30px;
        }

        .create-side-text {
            max-width: 320px;
        }

        .create-side-mark {
            left: auto;
            right: 30px;
            bottom: 28px;
        }

        .create-form {
            padding: 29px 22px;
        }

        .create-grid {
            grid-template-columns: 1fr;
            gap: 23px;
        }

        .create-field.full {
            grid-column: auto;
        }

        .create-actions {
            align-items: stretch;
            flex-direction: column;
            gap: 20px;
        }

        .create-submit {
            width: 100%;
        }

        .create-cancel {
            justify-content: center;
        }
    }


    /* =========================================================
           SMALL MOBILE
        ========================================================= */

    @@media (max-width: 430px) {

        .create-nav {
            width: calc(100% - 20px);
        }

        .create-logo {
            padding: 0 8px;
            font-size: 12px;
        }

        .create-nav button {
            padding: 9px 10px;
        }

        .create-shell {
            width: calc(100% - 20px);
        }

        .create-title {
            font-size: 4.1rem;
        }

        .create-kicker {
            font-size: 7px;
            letter-spacing: .29em;
        }

        .create-form {
            padding: 25px 18px;
        }

        .create-side {
            padding: 27px 20px;
        }

        .create-side-title {
            font-size: 32px;
        }

        .create-side-mark {
            right: 20px;
        }

        .create-section-heading {
            letter-spacing: .25em;
        }
    }


    /* =========================================================
           REDUCED MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .client-create-page *,
        .client-create-page *::before,
        .client-create-page *::after {
            transition: none !important;
            animation: none !important;
        }
    }

</style>

<div class="client-create-page">

    <div class="luxury-orb one"></div>
    <div class="luxury-orb two"></div>


    <!-- NAV -->
    <nav class="create-nav">

        <button type="button"
                onclick="window.location.href='/Clients'">
            CLIENTS
        </button>

        <div class="create-divider"></div>

        <div class="create-logo">
            AUREVA
        </div>

        <div class="create-divider"></div>

        <button type="button"
                onclick="window.location.href='/'">
            HOME
        </button>

    </nav>


    <main class="create-shell">


        <!-- HEADER -->
        <header class="create-header">

            <div>

                <div class="create-kicker">
                    AUREVA / NEW RELATIONSHIP
                </div>

                <h1 class="create-title">
                    Add someone.
                    <br />
                    <span>Remember them.</span>
                </h1>

            </div>


            <p class="create-intro">
                Every client has a story.
                <strong>
                    AUREVA
                </strong>
                keeps the details that turn
                an ordinary appointment into
                a personal experience.
            </p>

        </header>


        <!-- FORM AREA -->
        <div class="create-form-wrap">


            <!-- SIDE -->
            <aside class="create-side">

                <div class="create-side-label">
                    CLIENT PROFILE
                </div>

                <div class="create-side-title">
                    Every detail
                    <br />
                    <span>matters.</span>
                </div>

                <p class="create-side-text">
                    Build a richer client profile with
                    contact details, preferences,
                    history and private notes.
                    Everything your team needs,
                    beautifully organized.
                </p>

                <div class="create-side-mark">
                    A
                </div>

            </aside>


            <!-- FORM -->
            <form asp-action="Create"
                  method="post"
                  class="create-form">

                <div asp-validation-summary="ModelOnly"></div>


                <!-- BASIC INFORMATION -->
                <section class="create-section">

                    <div class="create-section-heading">
                        BASIC INFORMATION
                    </div>


                    <div class="create-grid">


                        <div class="create-field full">

                            <label asp-for="FullName">
                                FULL NAME
                            </label>

                            <input asp-for="FullName"
                                   placeholder="e.g. Hiba Ahmad" />

                            <span asp-validation-for="FullName"></span>

                        </div>


                        <div class="create-field">

                            <label asp-for="Email">
                                EMAIL
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   placeholder="client@email.com" />

                            <span asp-validation-for="Email"></span>

                        </div>


                        <div class="create-field">

                            <label asp-for="Phone">
                                PHONE
                            </label>

                            <input asp-for="Phone"
                                   placeholder="+970..." />

                            <span asp-validation-for="Phone"></span>

                        </div>


                        <div class="create-field">

                            <label asp-for="DateOfBirth">
                                DATE OF BIRTH
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date" />

                            <span asp-validation-for="DateOfBirth"></span>

                        </div>


                        <div class="create-field">

                            <label asp-for="FavoriteService">
                                FAVORITE SERVICE
                            </label>

                            <input asp-for="FavoriteService"
                                   placeholder="e.g. Hair Coloring" />

                            <span asp-validation-for="FavoriteService"></span>

                        </div>

                    </div>

                </section>


                <!-- CLIENT HISTORY -->
                <section class="create-section">

                    <div class="create-section-heading">
                        CLIENT HISTORY
                    </div>


                    <div class="create-grid">


                        <div class="create-field">

                            <label asp-for="TotalVisits">
                                TOTAL VISITS
                            </label>

                            <input asp-for="TotalVisits"
                                   type="number"
                                   min="0"
                                   placeholder="0" />

                            <span asp-validation-for="TotalVisits"></span>

                        </div>


                        <div class="create-field">

                            <label asp-for="TotalSpent">
                                TOTAL SPENT
                            </label>

                            <input asp-for="TotalSpent"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   placeholder="0.00" />

                            <span asp-validation-for="TotalSpent"></span>

                        </div>


                        <div class="create-field">

                            <label asp-for="LastVisit">
                                LAST VISIT
                            </label>

                            <input asp-for="LastVisit"
                                   type="date" />

                            <span asp-validation-for="LastVisit"></span>

                        </div>


                        <div class="create-field">

                            <label asp-for="Rating">
                                RATING
                            </label>

                            <input asp-for="Rating"
                                   type="number"
                                   min="0"
                                   max="5"
                                   step="0.1"
                                   placeholder="5.0" />

                            <span asp-validation-for="Rating"></span>

                        </div>

                    </div>

                </section>


                <!-- NOTES -->
                <section class="create-section">

                    <div class="create-section-heading">
                        PRIVATE NOTES
                    </div>


                    <div class="create-field">

                        <label asp-for="Notes">
                            NOTES
                        </label>

                        <textarea asp-for="Notes"
                                  placeholder="Preferences, details, reminders..."></textarea>

                        <span asp-validation-for="Notes"></span>

                    </div>

                </section>


                <!-- ACTIONS -->
                <div class="create-actions">

                    <a asp-action="Index"
                       class="create-cancel">
                        ← BACK TO CLIENTS
                    </a>

                    <button type="submit"
                            class="create-submit">
                        CREATE CLIENT →
                    </button>

