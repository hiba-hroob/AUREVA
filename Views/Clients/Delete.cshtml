@model AUREVA.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<style>
    /* =========================================================
           AUREVA / DELETE CLIENT
           EDITORIAL LUXURY — QUIET CONFIRMATION
        ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .delete-client-page {
        --teal: #19B8B2;
        --teal-dark: #087F7A;
        --teal-deep: #075B5A;
        --teal-soft: #DDF5F3;
        --teal-pale: #F1FBFA;
        --burgundy: #800020;
        --burgundy-dark: #5C0017;
        --burgundy-soft: #E8C5CD;
        --burgundy-pale: #FAEFF2;
        --white: #FFFFFF;
        --ivory: #FAFCFB;
        --ivory-dark: #EEF5F4;
        --text: #183333;
        --text-soft: #486361;
        --text-muted: #78908E;
        --line: rgba(24,51,51,.10);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 110px 20px 90px;
        background: radial-gradient( circle at 84% 12%, rgba(25,184,178,.12), transparent 27% ), radial-gradient( circle at 8% 85%, rgba(128,0,32,.07), transparent 26% ), linear-gradient( 180deg, #FFFFFF 0%, #FAFCFB 58%, #EEF5F4 100% );
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .delete-client-page *,
        .delete-client-page *::before,
        .delete-client-page *::after {
            box-sizing: border-box;
        }

        .delete-client-page a {
            -webkit-tap-highlight-color: transparent;
        }


        /* =========================================================
           BACKGROUND WATERMARK
        ========================================================= */

        .delete-client-page::before {
            content: "A";
            position: absolute;
            top: 55px;
            right: -30px;
            color: rgba(25,184,178,.075);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 34vw, 34rem);
            line-height: .72;
            pointer-events: none;
            user-select: none;
        }

        .delete-client-page::after {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            left: -260px;
            bottom: -250px;
            border: 1px solid rgba(25,184,178,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 48px rgba(25,184,178,.022), 0 0 0 95px rgba(128,0,32,.015);
            pointer-events: none;
        }


    /* =========================================================
           MAIN FRAME
        ========================================================= */

    .delete-client-shell {
        position: relative;
        z-index: 2;
        width: min(1040px, 100%);
        margin: auto;
    }


    /* =========================================================
           TOP LINE
        ========================================================= */

    .delete-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--line);
    }

    .delete-kicker {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .38em;
        text-transform: uppercase;
    }

        .delete-kicker::before {
            content: "";
            width: 45px;
            height: 1px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

    .delete-edition {
        color: var(--text-muted);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .23em;
    }


    /* =========================================================
           CONFIRMATION CARD
        ========================================================= */

    .delete-card {
        position: relative;
        overflow: hidden;
        padding: 58px 60px 52px;
        background: linear-gradient( 145deg, rgba(255,255,255,.98), rgba(247,251,250,.96) );
        border: 1px solid var(--line);
        box-shadow: 0 35px 90px rgba(24,51,51,.075);
    }

        .delete-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

        .delete-card::after {
            content: "A";
            position: absolute;
            right: -15px;
            bottom: -90px;
            color: rgba(25,184,178,.035);
            font-family: Georgia, serif;
            font-size: 240px;
            line-height: .8;
            pointer-events: none;
        }


    /* =========================================================
           CARD INTRO
        ========================================================= */

    .delete-label {
        position: relative;
        z-index: 2;
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .32em;
        text-transform: uppercase;
    }

    .delete-title {
        position: relative;
        z-index: 2;
        max-width: 850px;
        margin: 27px 0 0;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(4rem, 7.5vw, 7.8rem);
        font-weight: 400;
        line-height: .76;
        letter-spacing: -.085em;
    }

        .delete-title span{
            color: #800020;
}

        .delete-title::after {
            content: "";
            display: block;
            width: 55px;
            height: 1px;
            margin-top: 30px;
            background: linear-gradient( 90deg, var(--burgundy), var(--teal) );
        }


    /* =========================================================
           MESSAGE
        ========================================================= */

    .delete-message {
        position: relative;
        z-index: 2;
        max-width: 570px;
        margin-top: 31px;
        padding-left: 19px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.95;
    }

        .delete-message strong {
            display: block;
            margin-bottom: 7px;
            color: var(--text-soft);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .04em;
        }


    /* =========================================================
           CLIENT REFERENCE
        ========================================================= */

    .delete-reference {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        margin-top: 42px;
        padding: 25px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .delete-reference-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .24em;
    }

    .delete-reference-name {
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.7rem, 3vw, 2.7rem);
        font-weight: 400;
        line-height: .95;
        letter-spacing: -.045em;
        text-align: right;
    }


    /* =========================================================
           ACTIONS
        ========================================================= */

    .delete-actions {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 38px;
    }

    .delete-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        transition: color .3s ease, transform .3s ease;
    }

        .delete-cancel:hover {
            color: var(--teal-deep);
            transform: translateX(-3px);
        }

    .delete-form {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin: 0;
    }

    .delete-confirm {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 13px;
        min-height: 51px;
        padding: 0 25px;
        border: 0;
        background: var(--burgundy);
        color: white;
        font-family: inherit;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        cursor: pointer;
        transition: transform .35s ease, background .35s ease, box-shadow .35s ease;
    }

        .delete-confirm span {
            color: var(--burgundy-soft);
            font-size: 14px;
            transition: transform .35s ease;
        }

        .delete-confirm:hover {
            transform: translateY(-3px);
            background: var(--burgundy-dark);
            box-shadow: 0 17px 36px rgba(92,0,23,.18);
        }

            .delete-confirm:hover span {
                transform: translateX(4px);
            }


    /* =========================================================
           BOTTOM NOTE
        ========================================================= */

    .delete-note {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-top: 28px;
        color: var(--text-muted);
        font-size: 7px;
        line-height: 1.7;
        letter-spacing: .03em;
    }

        .delete-note::before {
            content: "03";
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 30px;
            width: 30px;
            height: 30px;
            border: 1px solid rgba(128,0,32,.18);
            border-radius: 50%;
            color: var(--burgundy);
            font-family: Georgia, serif;
            font-size: 10px;
        }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 850px) {

        .delete-client-page {
            padding-top: 95px;
        }

        .delete-client-shell {
            width: min(850px, calc(100% - 30px));
        }

        .delete-card {
            padding: 48px 42px;
        }

        .delete-title {
            font-size: clamp(4rem, 9vw, 6.8rem);
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 600px) {

        .delete-client-page {
            align-items: flex-start;
            padding: 82px 14px 60px;
        }

            .delete-client-page::before {
                top: 75px;
                right: -30px;
                font-size: 17rem;
            }

        .delete-topline {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .delete-card {
            padding: 38px 25px 32px;
        }

        .delete-title {
            font-size: 4.4rem;
        }

            .delete-title::after {
                margin-top: 25px;
            }

        .delete-message {
            margin-top: 26px;
        }

        .delete-reference {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .delete-reference-name {
            text-align: left;
        }

        .delete-actions {
            align-items: stretch;
            flex-direction: column-reverse;
            gap: 22px;
        }

        .delete-form {
            width: 100%;
        }

        .delete-confirm {
            width: 100%;
        }

        .delete-cancel {
            justify-content: center;
        }
    }


    /* =========================================================
           SMALL MOBILE
        ========================================================= */

    @@media (max-width: 420px) {

        .delete-client-page {
            padding-left: 10px;
            padding-right: 10px;
        }

        .delete-client-shell {
            width: 100%;
        }

        .delete-card {
            padding: 32px 21px 28px;
        }

        .delete-kicker {
            font-size: 7px;
            letter-spacing: .28em;
        }

        .delete-title {
            font-size: 3.85rem;
        }

        .delete-message {
            font-size: 9px;
        }

        .delete-reference-name {
            font-size: 1.8rem;
        }
    }


    /* =========================================================
           REDUCED MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .delete-client-page *,
        .delete-client-page *::before,
        .delete-client-page *::after {
            transition: none !important;
            animation: none !important;
        }
    }

</style>


<div class="delete-client-page">

    <div class="delete-client-shell">

        <!-- TOP LINE -->

        <div class="delete-topline">

            <div class="delete-kicker">
                AUREVA / REMOVE CLIENT
            </div>

            <div class="delete-edition">
                CLIENT RELATIONSHIP / 03
            </div>

        </div>


        <!-- MAIN CARD -->

        <section class="delete-card">

            <div class="delete-label">
                PERMANENT ACTION
            </div>


            <h1 class="delete-title">
                Remove
                <br/>
                <span>@Model.FullName?</span>
            </h1>


            <div class="delete-message">

                <strong>
                    This client will be removed from AUREVA.
                </strong>

                This action permanently removes the client
                record and cannot be undone.

            </div>


            <!-- CLIENT REFERENCE -->

            <div class="delete-reference">

                <div class="delete-reference-label">
                    CLIENT RECORD
                </div>

                <div class="delete-reference-name">
                    @Model.FullName
                </div>

            </div>


            <!-- ACTIONS -->

            <div class="delete-actions">

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="delete-cancel">

                    ← CANCEL / KEEP CLIENT

                </a>


                <form asp-action="Delete"
                      method="post"
                      class="delete-form">

                    <input type="hidden"
                           asp-for="Id" />

                    <button type="submit"
                            class="delete-confirm">

                        DELETE CLIENT

                        <span>→</span>

                    </button>

                </form>

            </div>


            <div class="delete-note">
                Please make sure this is the intended client record before continuing.
            </div>

        </section>

    </div>

</div>