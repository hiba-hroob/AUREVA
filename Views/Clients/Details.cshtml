@model AUREVA.Models.Client

@{
    ViewData["Title"] = Model.FullName;
}

<style>
    /* =========================================================
           AUREVA / CLIENT DETAILS
           EDITORIAL LUXURY — MODERN ATELIER
        ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .client-details-page {
        --teal: #19B8B2;
        --teal-dark: #087F7A;
        --teal-deep: #075B5A;
        --teal-soft: #DDF5F3;
        --teal-pale: #F1FBFA;
        --burgundy: #800020;
        --burgundy-dark: #5C0017;
        --burgundy-soft: #E8C5CD;
        --burgundy-pale: #FAEFF2;
        --white: #FFFFFF;
        --ivory: #FAFCFB;
        --ivory-dark: #EEF5F4;
        --text: #183333;
        --text-soft: #486361;
        --text-muted: #78908E;
        --line: rgba(24,51,51,.10);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        background: radial-gradient( circle at 88% 5%, rgba(25,184,178,.13), transparent 25% ), radial-gradient( circle at 4% 70%, rgba(128,0,32,.07), transparent 27% ), linear-gradient( 180deg, #FFFFFF 0%, #FAFCFB 57%, #EEF5F4 100% );
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .client-details-page *,
        .client-details-page *::before,
        .client-details-page *::after {
            box-sizing: border-box;
        }

        .client-details-page a {
            -webkit-tap-highlight-color: transparent;
        }


        /* =========================================================
           BACKGROUND WATERMARK
        ========================================================= */

        .client-details-page::before {
            content: "A";
            position: absolute;
            right: -40px;
            top: 85px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 33vw, 34rem);
            line-height: .72;
            color: rgba(25,184,178,.085);
            pointer-events: none;
            user-select: none;
        }

        .client-details-page::after {
            content: "";
            position: absolute;
            left: -260px;
            top: 470px;
            width: 520px;
            height: 520px;
            border: 1px solid rgba(25,184,178,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 48px rgba(25,184,178,.022), 0 0 0 96px rgba(128,0,32,.015);
            pointer-events: none;
        }


    /* =========================================================
           NAVIGATION
        ========================================================= */

    .details-nav {
        position: fixed;
        z-index: 100;
        top: 25px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        padding: 7px;
        background: rgba(255,255,255,.86);
        border: 1px solid rgba(24,51,51,.09);
        border-radius: 999px;
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        box-shadow: 0 18px 55px rgba(24,51,51,.07);
    }

        .details-nav button {
            border: 0;
            background: transparent;
            color: var(--text-soft);
            padding: 12px 18px;
            border-radius: 999px;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .20em;
            cursor: pointer;
            transition: background .3s ease, color .3s ease, transform .3s ease;
        }

            .details-nav button:hover {
                background: var(--burgundy);
                color: white;
                transform: translateY(-1px);
            }

    .details-logo {
        padding: 0 23px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 17px;
        font-weight: 400;
        letter-spacing: .13em;
    }

    .details-divider {
        width: 1px;
        height: 19px;
        background: rgba(24,51,51,.10);
    }


    /* =========================================================
           MAIN SHELL
        ========================================================= */

    .details-shell {
        position: relative;
        z-index: 2;
        width: min(1320px, calc(100% - 64px));
        margin: 0 auto;
        padding: 150px 0 100px;
    }


    /* =========================================================
           HEADER
        ========================================================= */

    .details-header {
        display: grid;
        grid-template-columns: 1fr 330px;
        gap: 65px;
        align-items: end;
        padding-bottom: 44px;
        border-bottom: 1px solid var(--line);
    }

    .details-kicker {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .38em;
        text-transform: uppercase;
    }

        .details-kicker::before {
            content: "";
            width: 47px;
            height: 1px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

    .details-name {
        max-width: 900px;
        margin: 25px 0 0;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(4.8rem, 8.5vw, 9rem);
        font-weight: 400;
        line-height: .74;
        letter-spacing: -.085em;
    }

    .details-contact {
        max-width: 330px;
        margin-left: auto;
        padding-bottom: 6px;
    }

    .details-contact-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .28em;
    }

    .details-contact-main {
        margin-top: 13px;
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 700;
        word-break: break-word;
    }

    .details-contact-sub {
        margin-top: 7px;
        color: var(--text-muted);
        font-size: 10px;
    }


    /* =========================================================
           MAIN GRID
        ========================================================= */

    .details-main {
        display: grid;
        grid-template-columns: 390px 1fr;
        gap: 20px;
        margin-top: 38px;
    }


    /* =========================================================
           PROFILE CARD
        ========================================================= */

    .details-profile {
        position: relative;
        min-height: 560px;
        padding: 42px;
        overflow: hidden;
        background: linear-gradient( 150deg, var(--teal-deep) 0%, #07595A 52%, var(--teal-dark) 100% );
        color: white;
        box-shadow: 0 30px 75px rgba(7,91,90,.13);
    }

        .details-profile::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            right: -185px;
            bottom: -175px;
            border: 1px solid rgba(255,255,255,.09);
            border-radius: 50%;
            box-shadow: 0 0 0 45px rgba(255,255,255,.025), 0 0 0 90px rgba(128,0,32,.04);
        }

        .details-profile::after {
            content: "A";
            position: absolute;
            right: -20px;
            top: 40px;
            color: rgba(255,255,255,.045);
            font-family: Georgia, serif;
            font-size: 180px;
            line-height: .8;
            pointer-events: none;
        }


    /* =========================================================
           AVATAR
        ========================================================= */

    .details-avatar {
        position: relative;
        z-index: 2;
        width: 140px;
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 50%;
        background: radial-gradient( circle, rgba(255,255,255,.09), rgba(255,255,255,.025) );
        color: var(--burgundy-soft);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 32px;
        font-weight: 400;
        letter-spacing: .08em;
        box-shadow: 0 20px 50px rgba(0,0,0,.12);
    }

        .details-avatar::before {
            content: "";
            position: absolute;
            inset: 8px;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 50%;
        }


    /* =========================================================
           PROFILE INFORMATION
        ========================================================= */

    .details-profile-label {
        position: relative;
        z-index: 2;
        margin-top: 38px;
        color: var(--teal-soft);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .29em;
    }

    .details-profile-service {
        position: relative;
        z-index: 2;
        margin-top: 12px;
        max-width: 250px;
        color: white;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 34px;
        font-weight: 400;
        line-height: .92;
        letter-spacing: -.045em;
    }


    /* =========================================================
           PROFILE FOOTER
        ========================================================= */

    .details-profile-footer {
        position: absolute;
        z-index: 3;
        left: 42px;
        right: 42px;
        bottom: 36px;
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.12);
    }

    .details-created-label {
        color: rgba(255,255,255,.38);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
    }

    .details-created-value {
        margin-top: 6px;
        color: rgba(255,255,255,.72);
        font-size: 10px;
    }

    .details-status {
        color: var(--burgundy-soft);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .18em;
        text-align: right;
    }


    /* =========================================================
           STATS GRID
        ========================================================= */

    .details-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
    }

    .details-stat {
        position: relative;
        min-height: 205px;
        padding: 31px;
        background: rgba(255,255,255,.94);
        transition: background .35s ease, transform .35s ease;
    }

        .details-stat::after {
            content: "";
            position: absolute;
            left: 31px;
            bottom: 24px;
            width: 30px;
            height: 1px;
            background: var(--teal);
            transition: width .35s ease, background .35s ease;
        }

        .details-stat:hover {
            background: var(--teal-pale);
        }

            .details-stat:hover::after {
                width: 50px;
                background: var(--burgundy);
            }

    .details-stat-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .25em;
    }

    .details-stat-value {
        margin-top: 44px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 43px;
        font-weight: 400;
        line-height: .85;
        letter-spacing: -.055em;
        word-break: break-word;
    }

    .details-stat-note {
        margin-top: 9px;
        color: var(--text-muted);
        font-size: 8px;
        line-height: 1.5;
    }


    /* =========================================================
           CONTACT BAND
        ========================================================= */

    .details-band {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 24px;
        background: rgba(255,255,255,.55);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .details-item {
        min-height: 150px;
        padding: 30px;
        border-right: 1px solid var(--line);
    }

        .details-item:last-child {
            border-right: 0;
        }

    .details-item-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .25em;
    }

    .details-item-value {
        margin-top: 28px;
        color: var(--teal-deep);
        font-size: 12px;
        font-weight: 700;
        line-height: 1.5;
        word-break: break-word;
    }


    /* =========================================================
           PRIVATE NOTES
        ========================================================= */

    .details-notes {
        position: relative;
        overflow: hidden;
        margin-top: 24px;
        padding: 45px;
        background: linear-gradient( 135deg, rgba(255,255,255,.96), rgba(247,251,250,.96) );
        border: 1px solid var(--line);
        box-shadow: 0 22px 60px rgba(24,51,51,.045);
    }

        .details-notes::after {
            content: "A";
            position: absolute;
            right: 10px;
            bottom: -62px;
            color: rgba(25,184,178,.035);
            font-family: Georgia, serif;
            font-size: 190px;
            line-height: .8;
            pointer-events: none;
        }

    .details-notes-label {
        position: relative;
        z-index: 2;
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .34em;
    }

    .details-notes-text {
        position: relative;
        z-index: 2;
        max-width: 920px;
        margin-top: 29px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.2rem, 3.4vw, 4.1rem);
        font-weight: 400;
        line-height: .94;
        letter-spacing: -.055em;
    }


    /* =========================================================
           ACTIONS
        ========================================================= */

    .details-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 38px;
    }

    .details-back {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        transition: color .3s ease, transform .3s ease;
    }

        .details-back:hover {
            color: var(--burgundy);
            transform: translateX(-3px);
        }

    .details-actions-right {
        display: flex;
        gap: 10px;
    }

    .details-action {
        border: 1px solid rgba(24,51,51,.15);
        border-radius: 0;
        background: transparent;
        color: var(--text);
        padding: 13px 21px;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .19em;
        cursor: pointer;
        text-decoration: none;
        transition: transform .35s ease, background .35s ease, border-color .35s ease, color .35s ease, box-shadow .35s ease;
    }

        .details-action:hover {
            transform: translateY(-3px);
            background: var(--teal-deep);
            border-color: var(--teal-deep);
            color: white;
            box-shadow: 0 13px 28px rgba(7,91,90,.12);
        }

        .details-action.primary {
            background: var(--burgundy);
            border-color: var(--burgundy);
            color: white;
        }

            .details-action.primary:hover {
                background: var(--burgundy-dark);
                border-color: var(--burgundy-dark);
                box-shadow: 0 13px 28px rgba(92,0,23,.15);
            }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 1000px) {

        .details-shell {
            width: min(1180px, calc(100% - 48px));
        }

        .details-header {
            grid-template-columns: 1fr 280px;
            gap: 35px;
        }

        .details-main {
            grid-template-columns: 1fr;
        }

        .details-profile {
            min-height: 500px;
        }

        .details-profile-service {
            max-width: 500px;
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 700px) {

        .client-details-page::before {
            right: -35px;
            top: 100px;
            font-size: 18rem;
        }

        .details-nav {
            top: 15px;
            width: calc(100% - 28px);
            justify-content: space-between;
        }

            .details-nav button {
                padding: 10px 12px;
                font-size: 7px;
            }

        .details-logo {
            padding: 0 12px;
            font-size: 14px;
        }

        .details-shell {
            width: calc(100% - 28px);
            padding: 112px 0 65px;
        }

        .details-header {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .details-name {
            font-size: 4.7rem;
        }

        .details-contact {
            margin-left: 0;
            max-width: 100%;
        }

        .details-profile {
            min-height: 470px;
            padding: 32px;
        }

        .details-profile-footer {
            left: 32px;
            right: 32px;
            bottom: 30px;
        }

        .details-stats {
            grid-template-columns: 1fr;
        }

        .details-stat {
            min-height: 175px;
        }

        .details-stat-value {
            margin-top: 32px;
            font-size: 39px;
        }

        .details-band {
            grid-template-columns: 1fr;
        }

        .details-item {
            min-height: auto;
            padding: 25px 24px;
            border-right: 0;
            border-bottom: 1px solid var(--line);
        }

            .details-item:last-child {
                border-bottom: 0;
            }

        .details-item-value {
            margin-top: 14px;
        }

        .details-notes {
            padding: 30px 24px;
        }

        .details-notes-text {
            font-size: 2.65rem;
        }

        .details-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .details-actions-right {
            width: 100%;
            flex-wrap: wrap;
        }

        .details-action {
            flex: 1;
            text-align: center;
        }
    }


    /* =========================================================
           SMALL MOBILE
        ========================================================= */

    @@media (max-width: 430px) {

        .details-nav {
            width: calc(100% - 20px);
        }

        .details-logo {
            padding: 0 8px;
            font-size: 12px;
        }

        .details-nav button {
            padding: 9px 10px;
        }

        .details-shell {
            width: calc(100% - 20px);
        }

        .details-name {
            font-size: 4.15rem;
        }

        .details-profile {
            min-height: 440px;
            padding: 27px;
        }

        .details-avatar {
            width: 120px;
            height: 120px;
            font-size: 28px;
        }

        .details-profile-footer {
            left: 27px;
            right: 27px;
            bottom: 25px;
        }

        .details-stat {
            padding: 26px;
        }

            .details-stat::after {
                left: 26px;
            }

        .details-stat-value {
            font-size: 36px;
        }

        .details-notes-text {
            font-size: 2.35rem;
        }

        .details-actions-right {
            flex-direction: column;
        }

        .details-action {
            width: 100%;
        }
    }


    /* =========================================================
           REDUCED MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .client-details-page *,
        .client-details-page *::before,
        .client-details-page *::after {
            transition: none !important;
            animation: none !important;
        }
    }

</style>


<div class="client-details-page">

    <!-- NAV -->
    <nav class="details-nav">

        <button type="button"
                onclick="window.location.href='/Clients'">
            CLIENTS
        </button>

        <div class="details-divider"></div>

        <div class="details-logo">
            AUREVA
        </div>

        <div class="details-divider"></div>

        <button type="button"
                onclick="window.location.href='/'">
            HOME
        </button>

    </nav>


    <main class="details-shell">

        <!-- HEADER -->
        <header class="details-header">

            <div>

                <div class="details-kicker">
                    CLIENT PROFILE
                </div>

                <h1 class="details-name">
                    @Model.FullName
                </h1>

            </div>


            <div class="details-contact">

                <div class="details-contact-label">
                    CONTACT
                </div>

                <div class="details-contact-main">
                    @(string.IsNullOrWhiteSpace(Model.Email)
                        ? "No email provided"
                        : Model.Email)
                </div>

                <div class="details-contact-sub">
                    @(string.IsNullOrWhiteSpace(Model.Phone)
                        ? "No phone provided"
                        : Model.Phone)
                </div>

            </div>

        </header>


        <!-- MAIN -->
        <section class="details-main">

            <!-- PROFILE -->
            <div class="details-profile">

                <div class="details-avatar">

                    @{
                        var initials = string.Join(
                            "",
                            Model.FullName
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(x => x[0])
                        );
                    }

                    @initials

                </div>


                <div class="details-profile-label">
                    FAVORITE SERVICE
                </div>

                <div class="details-profile-service">
                    @(string.IsNullOrWhiteSpace(Model.FavoriteService)
                        ? "Not recorded yet."
                        : Model.FavoriteService)
                </div>


                <div class="details-profile-footer">

                    <div>

                        <div class="details-created-label">
                            CLIENT SINCE
                        </div>

                        <div class="details-created-value">
                            @Model.CreatedAt.ToString("dd MMM yyyy")
                        </div>

                    </div>

                    <div class="details-status">
                        AUREVA CLIENT
                    </div>

                </div>

            </div>


            <!-- STATS -->
            <div>

                <div class="details-stats">

                    <div class="details-stat">

                        <div class="details-stat-label">
                            TOTAL VISITS
                        </div>

                        <div class="details-stat-value">
                            @Model.TotalVisits
                        </div>

                        <div class="details-stat-note">
                            appointments completed
                        </div>

                    </div>


                    <div class="details-stat">

                        <div class="details-stat-label">
                            TOTAL SPENT
                        </div>

                        <div class="details-stat-value">
                            @Model.TotalSpent.ToString("C")
                        </div>

                        <div class="details-stat-note">
                            lifetime value
                        </div>

                    </div>


                    <div class="details-stat">

                        <div class="details-stat-label">
                            RATING
                        </div>

                        <div class="details-stat-value">
                            @(Model.Rating?.ToString("0.0") ?? "—")
                        </div>

                        <div class="details-stat-note">
                            client experience
                        </div>

                    </div>


                    <div class="details-stat">

                        <div class="details-stat-label">
                            LAST VISIT
                        </div>

                        <div class="details-stat-value"
                             style="font-size:22px;">

                            @(Model.LastVisit?.ToString("dd MMM yyyy") ?? "—")

                        </div>

                        <div class="details-stat-note">
                            most recent appointment
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- CONTACT BAND -->
        <section class="details-band">

            <div class="details-item">

                <div class="details-item-label">
                    FULL NAME
                </div>

                <div class="details-item-value">
                    @Model.FullName
                </div>

            </div>


            <div class="details-item">

                <div class="details-item-label">
                    DATE OF BIRTH
                </div>

                <div class="details-item-value">
                    @(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")
                </div>

            </div>


            <div class="details-item">

                <div class="details-item-label">
                    EMAIL
                </div>

                <div class="details-item-value">
                    @(string.IsNullOrWhiteSpace(Model.Email)
                        ? "—"
                        : Model.Email)
                </div>

            </div>

        </section>


        <!-- NOTES -->
        <section class="details-notes">

            <div class="details-notes-label">
                PRIVATE NOTES
            </div>

            <div class="details-notes-text">

                @if (string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <span style="color:rgba(11,20,36,.24);">
                        No private notes have been added yet.
                    </span>
                }
                else
                {
                    @Model.Notes
                }

            </div>

        </section>


        <!-- ACTIONS -->
        <div class="details-actions">

            <a asp-action="Index"
               class="details-back">
                ← BACK TO CLIENTS
