@model AUREVA.Models.Service

@{
    ViewData["Title"] = "Service Details";
}

<style>
    /* =========================================================
           AUREVA / SERVICE DETAILS
           EDITORIAL LUXURY — MODERN ATELIER
        ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .service-details-page {
        --teal: #19B8B2;
        --teal-dark: #087F7A;
        --teal-deep: #075B5A;
        --teal-soft: #DDF5F3;
        --teal-pale: #F1FBFA;
        --burgundy: #800020;
        --burgundy-dark: #5C0017;
        --burgundy-soft: #E8C5CD;
        --burgundy-pale: #FAEFF2;
        --white: #FFFFFF;
        --ivory: #FAFCFB;
        --ivory-dark: #EEF5F4;
        --text: #183333;
        --text-soft: #486361;
        --text-muted: #78908E;
        --line: rgba(24,51,51,.10);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        padding: 145px 0 100px;
        background: radial-gradient( circle at 88% 5%, rgba(25,184,178,.13), transparent 25% ), radial-gradient( circle at 5% 75%, rgba(128,0,32,.07), transparent 27% ), linear-gradient( 180deg, #FFFFFF 0%, #FAFCFB 58%, #EEF5F4 100% );
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .service-details-page *,
        .service-details-page *::before,
        .service-details-page *::after {
            box-sizing: border-box;
        }

        .service-details-page a {
            -webkit-tap-highlight-color: transparent;
        }


        /* =========================================================
           BACKGROUND WATERMARK
        ========================================================= */

        .service-details-page::before {
            content: "A";
            position: absolute;
            right: -40px;
            top: 75px;
            color: rgba(25,184,178,.085);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 34vw, 34rem);
            line-height: .72;
            pointer-events: none;
            user-select: none;
        }

        .service-details-page::after {
            content: "";
            position: absolute;
            width: 520px;
            height: 520px;
            left: -260px;
            top: 500px;
            border: 1px solid rgba(25,184,178,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 48px rgba(25,184,178,.022), 0 0 0 95px rgba(128,0,32,.015);
            pointer-events: none;
        }


    /* =========================================================
           SHELL
        ========================================================= */

    .service-details-shell {
        position: relative;
        z-index: 2;
        width: min(1260px, calc(100% - 64px));
        margin: auto;
    }


    /* =========================================================
           TOP LINE
        ========================================================= */

    .service-details-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 40px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
    }

    .service-details-kicker {
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .38em;
        text-transform: uppercase;
    }

        .service-details-kicker::before {
            content: "";
            width: 46px;
            height: 1px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
        }

    .service-details-edition {
        color: var(--text-muted);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .24em;
    }


    /* =========================================================
           HERO
        ========================================================= */

    .service-details-hero {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 65px;
        align-items: end;
        padding-bottom: 45px;
        border-bottom: 1px solid var(--line);
    }

    .service-details-title {
        margin: 0;
        max-width: 900px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(5rem, 8.5vw, 9rem);
        font-weight: 400;
        line-height: .74;
        letter-spacing: -.085em;
        word-break: break-word;
    }

    .service-details-intro {
        max-width: 390px;
        margin: 31px 0 0;
        padding-left: 19px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.95;
    }


    /* =========================================================
           HERO SIDE
        ========================================================= */

    .service-details-side {
        padding: 25px;
        background: rgba(255,255,255,.80);
        border: 1px solid var(--line);
        box-shadow: 0 25px 60px rgba(24,51,51,.05);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .service-details-side-number {
        color: var(--burgundy);
        font-family: Georgia, serif;
        font-size: 50px;
        line-height: .8;
        letter-spacing: -.07em;
    }

    .service-details-side-label {
        margin-top: 14px;
        color: var(--teal-deep);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .20em;
    }

    .service-details-side-copy {
        margin-top: 12px;
        color: var(--text-muted);
        font-size: 8px;
        line-height: 1.85;
    }

    .service-details-side-line {
        width: 38px;
        height: 1px;
        margin-top: 23px;
        background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
    }


    /* =========================================================
           MAIN DETAIL FRAME
        ========================================================= */

    .service-details-frame {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 0;
        margin-top: 38px;
        background: rgba(255,255,255,.92);
        border: 1px solid var(--line);
        box-shadow: 0 35px 90px rgba(24,51,51,.075);
    }


    /* =========================================================
           LEFT PANEL
        ========================================================= */

    .service-details-panel {
        position: relative;
        overflow: hidden;
        min-height: 570px;
        padding: 40px 30px;
        background: linear-gradient( 155deg, var(--teal-deep) 0%, #07595A 50%, var(--teal-dark) 100% );
        color: white;
    }

        .service-details-panel::before {
            content: "";
            position: absolute;
            width: 390px;
            height: 390px;
            right: -175px;
            bottom: -180px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 45px rgba(255,255,255,.022), 0 0 0 90px rgba(128,0,32,.035);
        }

        .service-details-panel::after {
            content: "A";
            position: absolute;
            right: -23px;
            top: 25px;
            color: rgba(255,255,255,.045);
            font-family: Georgia, serif;
            font-size: 185px;
            line-height: .8;
            pointer-events: none;
        }

    .panel-kicker {
        position: relative;
        z-index: 2;
        color: var(--teal-soft);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .29em;
    }

    .panel-title {
        position: relative;
        z-index: 2;
        margin-top: 20px;
        color: white;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 37px;
        font-weight: 400;
        line-height: .9;
        letter-spacing: -.05em;
    }

    .panel-line {
        position: relative;
        z-index: 2;
        width: 43px;
        height: 1px;
        margin: 28px 0;
        background: var(--burgundy-soft);
    }

    .panel-copy {
        position: relative;
        z-index: 2;
        max-width: 225px;
        color: rgba(255,255,255,.58);
        font-size: 9px;
        line-height: 1.9;
    }

    .panel-mark {
        position: absolute;
        z-index: 3;
        left: 30px;
        bottom: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 68px;
        height: 68px;
        border: 1px solid rgba(255,255,255,.20);
        border-radius: 50%;
        color: var(--burgundy-soft);
        font-family: Georgia, serif;
        font-size: 29px;
    }

        .panel-mark::before {
            content: "";
            position: absolute;
            inset: 7px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 50%;
        }


    /* =========================================================
           CONTENT
        ========================================================= */

    .service-details-content {
        position: relative;
        overflow: hidden;
        padding: 45px;
    }

        .service-details-content::after {
            content: "A";
            position: absolute;
            right: -15px;
            bottom: -95px;
            color: rgba(25,184,178,.035);
            font-family: Georgia, serif;
            font-size: 225px;
            line-height: .8;
            pointer-events: none;
        }


    /* =========================================================
           DESCRIPTION
        ========================================================= */

    .service-description-label {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 13px;
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .30em;
    }

        .service-description-label::after {
            content: "";
            flex: 1;
            height: 1px;
            background: linear-gradient( 90deg, var(--line), transparent );
        }

    .service-description {
        position: relative;
        z-index: 2;
        max-width: 850px;
        margin: 27px 0 0;
        color: var(--teal-deep);
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: clamp(2.15rem, 3.3vw, 4rem);
        font-weight: 400;
        line-height: .96;
        letter-spacing: -.055em;
    }


    /* =========================================================
           META GRID
        ========================================================= */

    .service-meta-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: 47px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
    }

    .service-meta-card {
        min-height: 170px;
        padding: 28px;
        border-right: 1px solid var(--line);
        background: rgba(250,252,251,.55);
        transition: background .35s ease, transform .35s ease;
    }

        .service-meta-card:last-child {
            border-right: 0;
        }

        .service-meta-card:hover {
            background: var(--teal-pale);
        }

    .service-meta-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .23em;
    }

    .service-meta-value {
        margin-top: 30px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 39px;
        font-weight: 400;
        line-height: .85;
        letter-spacing: -.055em;
    }

    .service-meta-note {
        margin-top: 10px;
        color: var(--text-muted);
        font-size: 8px;
        line-height: 1.5;
    }

    .service-meta-value.status {
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .18em;
    }


    /* =========================================================
           STATUS INDICATOR
        ========================================================= */

    .service-status-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        margin-right: 8px;
        vertical-align: middle;
        border-radius: 50%;
    }

        .service-status-dot.active {
            background: var(--teal);
            box-shadow: 0 0 0 5px rgba(25,184,178,.10);
        }

        .service-status-dot.inactive {
            background: var(--burgundy);
            opacity: .55;
            box-shadow: 0 0 0 5px rgba(128,0,32,.08);
        }


    /* =========================================================
           ACTIONS
        ========================================================= */

    .service-details-actions {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 38px;
        padding-top: 25px;
        border-top: 1px solid var(--line);
    }

    .service-details-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .20em;
        transition: color .3s ease, transform .3s ease;
    }

        .service-details-back:hover {
            color: var(--burgundy);
            transform: translateX(-3px);
        }

    .service-details-action-group {
        display: flex;
        gap: 10px;
    }

    .service-details-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 21px;
        border: 1px solid rgba(24,51,51,.15);
        border-radius: 0;
        background: transparent;
        color: var(--text);
        text-decoration: none;
        font-family: inherit;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .19em;
        cursor: pointer;
        transition: transform .35s ease, background .35s ease, border-color .35s ease, color .35s ease, box-shadow .35s ease;
    }

        .service-details-action:hover {
            transform: translateY(-3px);
            background: var(--teal-deep);
            border-color: var(--teal-deep);
            color: white;
            box-shadow: 0 14px 30px rgba(7,91,90,.13);
        }

        .service-details-action.delete {
            background: var(--burgundy);
            border-color: var(--burgundy);
            color: white;
        }

            .service-details-action.delete:hover {
                background: var(--burgundy-dark);
                border-color: var(--burgundy-dark);
                box-shadow: 0 14px 30px rgba(92,0,23,.16);
            }

    .service-details-delete-form {
        display: inline;
        margin: 0;
    }


    /* =========================================================
           PHILOSOPHY STRIP
        ========================================================= */

    .service-details-philosophy {
        display: grid;
        grid-template-columns: 75px 1fr 245px;
        gap: 40px;
        align-items: center;
        margin-top: 68px;
        padding: 40px;
        background: linear-gradient( 135deg, #F4F3ED, #FFFEFA );
        border: 1px solid var(--line);
    }

    .philosophy-mark {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 70px;
        height: 70px;
        border: 1px solid rgba(128,0,32,.23);
        border-radius: 50%;
        color: var(--burgundy);
        font-family: Georgia, serif;
        font-size: 30px;
    }

        .philosophy-mark::before {
            content: "";
            position: absolute;
            inset: 7px;
            border: 1px solid rgba(128,0,32,.09);
            border-radius: 50%;
        }

    .philosophy-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .30em;
    }

    .philosophy-title {
        margin: 12px 0 0;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.2rem, 3.5vw, 3.8rem);
        font-weight: 400;
        line-height: .88;
        letter-spacing: -.06em;
    }

        .philosophy-title span {
            color: var(--burgundy);
        }

    .philosophy-copy {
        padding-left: 18px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 9px;
        line-height: 1.9;
    }


    /* =========================================================
           TABLET
        ========================================================= */

    @@media (max-width: 1000px) {

        .service-details-shell {
            width: min(1180px, calc(100% - 48px));
        }

        .service-details-hero {
            grid-template-columns: 1fr 270px;
            gap: 35px;
        }

        .service-details-frame {
            grid-template-columns: 230px 1fr;
        }

        .service-details-content {
            padding: 35px;
        }

        .service-details-panel {
            padding: 34px 24px;
        }

        .service-meta-card {
            padding: 25px;
        }

        .service-details-philosophy {
            grid-template-columns: 70px 1fr;
        }

        .philosophy-copy {
            grid-column: 2;
        }
    }


    /* =========================================================
           MOBILE
        ========================================================= */

    @@media (max-width: 760px) {

        .service-details-page {
            padding: 105px 0 65px;
        }

            .service-details-page::before {
                right: -30px;
                top: 90px;
                font-size: 18rem;
            }

        .service-details-shell {
            width: calc(100% - 28px);
        }

        .service-details-topline {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .service-details-hero {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .service-details-title {
            font-size: clamp(4.3rem, 18vw, 6.8rem);
        }

        .service-details-side {
            max-width: 330px;
        }

        .service-details-frame {
            display: block;
        }

        .service-details-panel {
            min-height: 330px;
        }

        .service-details-content {
            padding: 29px 22px;
        }

        .service-description {
            font-size: 2.65rem;
        }

        .service-meta-grid {
            grid-template-columns: 1fr;
        }

        .service-meta-card {
            min-height: 145px;
            border-right: 0;
            border-bottom: 1px solid var(--line);
        }

            .service-meta-card:last-child {
                border-bottom: 0;
            }

        .service-details-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .service-details-action-group {
            width: 100%;
            flex-wrap: wrap;
        }

        .service-details-action,
        .service-details-delete-form {
            flex: 1;
        }

            .service-details-action.delete {
                width: 100%;
            }

        .service-details-delete-form {
            display: block;
        }

        .service-details-philosophy {
            grid-template-columns: 1fr;
            gap: 24px;
            padding: 31px 24px;
        }

        .philosophy-copy {
            grid-column: auto;
        }

        .philosophy-title {
            font-size: 2.8rem;
        }
    }


    /* =========================================================
           SMALL MOBILE
        ========================================================= */

    @@media (max-width: 430px) {

        .service-details-shell {
            width: calc(100% - 20px);
        }

        .service-details-title {
            font-size: 4.05rem;
        }

        .service-details-kicker {
            font-size: 7px;
            letter-spacing: .29em;
        }

        .service-details-panel {
            padding: 28px 20px;
        }

        .panel-title {
            font-size: 31px;
        }

        .panel-mark {
            left: 20px;
        }

        .service-details-content {
            padding: 25px 18px;
        }

        .service-description {
            font-size: 2.3rem;
        }

        .service-details-action-group {
            flex-direction: column;
        }

        .service-details-action,
        .service-details-delete-form {
            width: 100%;
        }

        .service-details-action {
            min-height: 48px;
        }

        .philosophy-title {
            font-size: 2.4rem;
        }
    }


    /* =========================================================
           REDUCED MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .service-details-page *,
        .service-details-page *::before,
        .service-details-page *::after {
            transition: none !important;
            animation: none !important;
        }
    }

</style>


<div class="service-details-page">

    <div class="service-details-shell">


        <!-- =====================================================
             TOP LINE
        ====================================================== -->

        <div class="service-details-topline">

            <div class="service-details-kicker">
                AUREVA / SERVICE
            </div>

            <div class="service-details-edition">
                SERVICE PROFILE / 01
            </div>

        </div>


        <!-- =====================================================
             HERO
        ====================================================== -->

        <section class="service-details-hero">

            <div>

                <h1 class="service-details-title">
                    @Model.Name
                </h1>

                <p class="service-details-intro">
                    A considered service is more than
                    an offering. It is a defined part
                    of the AUREVA experience, shaped
                    with clarity and intention.
                </p>

            </div>


            <div class="service-details-side">

                <div class="service-details-side-number">
                    01
                </div>

                <div class="service-details-side-label">
                    SERVICE PROFILE
                </div>

                <div class="service-details-side-copy">
                    Explore the value, duration and
                    current availability of this
                    AUREVA offering.
                </div>

                <div class="service-details-side-line"></div>

            </div>

        </section>


        <!-- =====================================================
             MAIN FRAME
        ====================================================== -->

        <section class="service-details-frame">


            <!-- =================================================
                 LEFT PANEL
            ================================================== -->

            <aside class="service-details-panel">

                <div class="panel-kicker">
                    AUREVA / ATELIER
                </div>

                <div class="panel-title">
                    Defined
                    <br />
                    with intention.
                </div>

                <div class="panel-line"></div>

                <div class="panel-copy">
                    Every service has its own rhythm,
                    value and character. AUREVA keeps
                    these details clear for the team
                    and meaningful for every client.
                </div>

                <div class="panel-mark">
                    A
                </div>

            </aside>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="service-details-content">


                <!-- DESCRIPTION -->

                <div class="service-description-label">
                    DESCRIPTION
                </div>

                <p class="service-description">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description available."
                        : Model.Description)
                </p>


                <!-- META -->

                <div class="service-meta-grid">


                    <!-- PRICE -->

                    <div class="service-meta-card">

                        <div class="service-meta-label">
                            PRICE
                        </div>

                        <div class="service-meta-value">
                            @Model.Price.ToString("C")
                        </div>

                        <div class="service-meta-note">
                            service investment
                        </div>

                    </div>


                    <!-- DURATION -->

                    <div class="service-meta-card">

                        <div class="service-meta-label">
                            DURATION
                        </div>

                        <div class="service-meta-value">
                            @Model.DurationMinutes
                        </div>

                        <div class="service-meta-note">
                            minutes
                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="service-meta-card">

                        <div class="service-meta-label">
                            STATUS
                        </div>

                        <div class="service-meta-value status">

                            <span class="service-status-dot @(Model.IsActive ? "active" : "inactive")"></span>

                            @(Model.IsActive
                                ? "ACTIVE"
                                : "INACTIVE")

                        </div>

                        <div class="service-meta-note">
                            current availability
                        </div>

                    </div>


                </div>


                <!-- ACTIONS -->

                <div class="service-details-actions">


                    <a asp-action="Index"
                       class="service-details-back">

                        ← BACK TO SERVICES

                    </a>


                    <div class="service-details-action-group">


                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="service-details-action">

                            EDIT SERVICE

                        </a>


                        <form asp-action="Delete"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="service-details-delete-form">

                            <button type="submit"
                                    onclick="return confirm('Delete this service?');"
                                    class="service-details-action delete">

                                DELETE SERVICE

                            </button>

                        </form>


                    </div>

