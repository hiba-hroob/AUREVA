@{
    ViewData["Title"] = "Dashboard";

    var todayAppointments =
        (List<AUREVA.Models.Appointment>)ViewBag.TodayAppointments;

    var upcomingAppointments =
        (List<AUREVA.Models.Appointment>)ViewBag.UpcomingAppointments;

    var reminderAppointments =
        (List<AUREVA.Models.Appointment>)ViewBag.ReminderAppointments;

    var totalClients =
        (int)ViewBag.TotalClients;

    var todayRevenue =
        (decimal)ViewBag.TodayRevenue;

    var activeServices =
        (int)ViewBag.ActiveServices;

    var availableStaff =
        (int)ViewBag.AvailableStaff;

    var weekRevenue = (decimal)ViewBag.WeekRevenue;
    var monthRevenue = (decimal)ViewBag.MonthRevenue;
    var topServices = ViewBag.TopServices;
}

<style>
    /* =========================================================
           AUREVA DASHBOARD — DEEP TEAL × BURGUNDY × IVORY
           Modern Luxury / Beauty / Elegant Dashboard
           ========================================================= */

    .dashboard-page {
        /* =====================================================
               CORE PALETTE
               ===================================================== */

        --teal: #19B8B2;
        --teal-dark: #087F7A;
        --teal-deep: #075B5A;
        --teal-deeper: #043F40;
        --teal-soft: #DDF5F3;
        --teal-pale: #F1FBFA;
        --burgundy: #800020;
        --burgundy-dark: #5C0017;
        --burgundy-border: #650018;
        --burgundy-light: #FFD8E0;
        --burgundy-soft: #E8C5CD;
        --burgundy-pale: #FAEFF2;
        --ivory: #FAFCFB;
        --ivory-light: #FFFFFF;
        --ivory-dark: #EEF5F4;
        --text: #183333;
        --text-soft: #486361;
        --muted: rgba(24, 51, 51, .56);
        --faint: rgba(24, 51, 51, .36);
        --line: rgba(7, 91, 90, .11);
        --line-dark: rgba(255,255,255,.12);
        min-height: 100vh;
        background: radial-gradient( circle at 8% 4%, rgba(7, 91, 90, .09), transparent 27% ), radial-gradient( circle at 92% 30%, rgba(128, 0, 32, .10), transparent 30% ), linear-gradient( 180deg, #FFFFFF 0%, #FAFCFB 58%, #F1F8F7 100% );
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
        overflow-x: hidden;
    }


        /* =========================================================
           GLOBAL BOX SIZING
           ========================================================= */

        .dashboard-page *,
        .dashboard-page *::before,
        .dashboard-page *::after {
            box-sizing: border-box;
        }


    /* =========================================================
           NUMBER TYPOGRAPHY
           ========================================================= */

    .dashboard-stat-value,
    .dashboard-revenue-value,
    .dashboard-side-mini-value,
    .dashboard-glance-value,
    .dashboard-time,
    .dashboard-reminder-time,
    .dashboard-service-revenue {
        font-family: "DM Sans", "Segoe UI", Arial, sans-serif;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1, "zero" 1;
        font-weight: 700;
        letter-spacing: -.045em;
    }


    /* =========================================================
           HTML / BODY
           ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        background: var(--ivory);
    }


    /* =========================================================
           SHELL
           ========================================================= */

    .dashboard-shell {
        width: min(1500px, calc(100% - 56px));
        margin: 0 auto;
        padding: 130px 0 90px;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .dashboard-hero {
        position: relative;
        min-height: 470px;
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        gap: 22px;
    }


    /* =========================================================
           HERO MAIN — IVORY
           ========================================================= */

    .dashboard-hero-main {
        position: relative;
        min-height: 470px;
        padding: 58px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-radius: 38px;
        overflow: hidden;
        background: radial-gradient( circle at 100% 0%, rgba(7,91,90,.08), transparent 34% ), linear-gradient( 145deg, #FFFFFF 0%, #F5FBFA 100% );
        border: 1px solid rgba(7,91,90,.12);
        box-shadow: 0 30px 90px rgba(7,91,90,.07), inset 0 1px 0 rgba(255,255,255,.95);
    }


        .dashboard-hero-main::after {
            content: "";
            position: absolute;
            width: 430px;
            height: 430px;
            right: -240px;
            bottom: -255px;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(128,0,32,.18), rgba(25,184,178,.06) 45%, transparent 70% );
            filter: blur(6px);
            pointer-events: none;
        }


    /* =========================================================
           HERO KICKER
           ========================================================= */

    .dashboard-kicker {
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--burgundy-dark);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .38em;
    }


        .dashboard-kicker::before {
            content: "";
            width: 45px;
            height: 2px;
            background: linear-gradient( 90deg, var(--burgundy), var(--teal) );
        }


    /* =========================================================
           HERO DATE
           ========================================================= */

    .dashboard-date {
        margin-top: 25px;
        color: var(--teal-deep);
        opacity: .52;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .25em;
    }


    /* =========================================================
           HERO TITLE
           ========================================================= */

    .dashboard-title {
        position: relative;
        z-index: 2;
        margin: 25px 0 0;
        max-width: 900px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(4rem, 7vw, 7.8rem);
        line-height: .82;
        letter-spacing: -.065em;
        font-weight: 500;
    }


        .dashboard-title span {
            color: var(--burgundy);
            opacity: .88;
        }


    /* =========================================================
           HERO SUBTITLE
           ========================================================= */

    .dashboard-subtitle {
        position: relative;
        z-index: 2;
        max-width: 500px;
        margin-top: 30px;
        color: var(--text-soft);
        font-size: 13px;
        line-height: 1.9;
    }


    /* =========================================================
           HERO SIDE — DEEP TEAL
           ========================================================= */

    .dashboard-hero-side {
        position: relative;
        min-height: 470px;
        padding: 48px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-radius: 38px;
        overflow: hidden;
        background: radial-gradient( circle at 90% 0%, rgba(128,0,32,.22), transparent 32% ), linear-gradient( 145deg, #075B5A 0%, #087F7A 58%, #159D98 100% );
        color: #FFFFFF;
        border: 1px solid rgba(25,184,178,.22);
        box-shadow: 0 30px 90px rgba(7,91,90,.23);
    }


        .dashboard-hero-side::before {
            content: "";
            position: absolute;
            width: 440px;
            height: 440px;
            top: -270px;
            right: -150px;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(128,0,32,.22), transparent 65% );
            filter: blur(8px);
        }


        .dashboard-hero-side::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 135deg, rgba(25,184,178,.10), transparent 45% ), linear-gradient( 315deg, rgba(128,0,32,.08), transparent 45% );
            pointer-events: none;
        }


    /* =========================================================
           HERO SIDE LABEL
           ========================================================= */

    .dashboard-side-label {
        position: relative;
        z-index: 2;
        color: var(--burgundy-light);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .35em;
    }


    /* =========================================================
           HERO SIDE HEADING
           ========================================================= */

    .dashboard-side-heading {
        position: relative;
        z-index: 2;
        margin-top: 18px;
        color: #FFFFFF;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.5rem, 4vw, 4rem);
        line-height: .9;
        letter-spacing: -.05em;
        font-weight: 400;
    }


        .dashboard-side-heading span {
            color: rgba(255,255,255,.52);
        }


    /* =========================================================
           HERO BOTTOM
           ========================================================= */

    .dashboard-side-bottom {
        position: relative;
        z-index: 2;
        padding-top: 25px;
        border-top: 1px solid rgba(255,255,255,.13);
    }


    .dashboard-side-mini-label {
        color: rgba(255,255,255,.48);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .22em;
    }


    .dashboard-side-mini-value {
        margin-top: 10px;
        color: var(--burgundy-light);
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -.04em;
        text-shadow: 0 5px 25px rgba(128,0,32,.22);
    }


    /* =========================================================
           MAIN STATS
           ========================================================= */

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        margin-top: 22px;
        gap: 1px;
        background: rgba(7,91,90,.13);
        border: 1px solid rgba(7,91,90,.13);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(7,91,90,.07);
    }


    .dashboard-stat {
        position: relative;
        min-height: 190px;
        padding: 30px;
        background: linear-gradient( 145deg, #FFFFFF, #F5FBFA );
        transition: transform .35s ease, background .35s ease, box-shadow .35s ease;
    }


        .dashboard-stat:hover {
            background: #FFFFFF;
            transform: translateY(-3px);
            z-index: 2;
            box-shadow: 0 20px 50px rgba(7,91,90,.08);
        }


        .dashboard-stat::before {
            content: "";
            position: absolute;
            top: 0;
            left: 30px;
            right: 30px;
            height: 2px;
            background: linear-gradient( 90deg, transparent, var(--teal), var(--burgundy), transparent );
            opacity: .45;
        }


    .dashboard-stat-label {
        color: var(--teal-deep);
        opacity: .48;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .25em;
    }


    .dashboard-stat-value {
        margin-top: 52px;
        color: var(--teal-deep);
        font-size: clamp(30px, 3vw, 43px);
        font-weight: 700;
        letter-spacing: -.055em;
    }


    /* TEAL */

    .dashboard-stat:nth-child(1)
    .dashboard-stat-value {
        color: var(--teal-deep);
    }


    /* BURGUNDY */

    .dashboard-stat:nth-child(2)
    .dashboard-stat-value {
        color: var(--burgundy);
    }


    /* TURQUOISE */

    .dashboard-stat:nth-child(3)
    .dashboard-stat-value {
        color: var(--teal);
    }


    /* TEAL */

    .dashboard-stat:nth-child(4)
    .dashboard-stat-value {
        color: var(--teal-dark);
    }


    /* =========================================================
           REVENUE STRIP
           ========================================================= */

    .dashboard-revenue {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        margin-top: 22px;
        background: rgba(7,91,90,.13);
        border: 1px solid rgba(7,91,90,.13);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(7,91,90,.07);
    }


    .dashboard-revenue-card {
        min-height: 180px;
        padding: 32px;
        position: relative;
        background: linear-gradient( 145deg, #FFFFFF, #F5FBFA );
    }


    /* =========================================================
           REVENUE LABEL
           ========================================================= */

    .dashboard-revenue-label {
        color: var(--teal-deep);
        opacity: .48;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .27em;
    }


    /* =========================================================
           REVENUE NUMBER
           ========================================================= */

    .dashboard-revenue-value {
        margin-top: 38px;
        color: var(--teal-deep);
        font-size: 38px;
        font-weight: 700;
        letter-spacing: -.055em;
    }


    /* =========================================================
           TODAY — BURGUNDY
           ========================================================= */

    .dashboard-revenue-card:nth-child(1) {
        background: linear-gradient( 145deg, #FFFFFF, #FAF1F3 );
    }


        .dashboard-revenue-card:nth-child(1)
        .dashboard-revenue-value {
            color: var(--burgundy);
        }


    /* =========================================================
           WEEK — DEEP TEAL
           ========================================================= */

    .dashboard-revenue-card:nth-child(2) {
        background: radial-gradient( circle at 90% 0%, rgba(128,0,32,.18), transparent 35% ), linear-gradient( 145deg, #075B5A, #087F7A );
        color: #FFFFFF;
    }


        .dashboard-revenue-card:nth-child(2)
        .dashboard-revenue-label {
            color: rgba(255,255,255,.52);
        }


        .dashboard-revenue-card:nth-child(2)
        .dashboard-revenue-value {
            color: var(--burgundy-light);
            text-shadow: 0 5px 25px rgba(128,0,32,.22);
        }


    /* =========================================================
           MONTH — BURGUNDY / TEAL BLEND
           ========================================================= */

    .dashboard-revenue-card:nth-child(3) {
        background: radial-gradient( circle at 90% 0%, rgba(25,184,178,.20), transparent 80% ), linear-gradient( 160deg, #5C0017, #800020 );
        color: #FFFFFF;
    }


        .dashboard-revenue-card:nth-child(3)
        .dashboard-revenue-label {
            color: rgba(255,255,255,.60);
        }


        .dashboard-revenue-card:nth-child(3)
        .dashboard-revenue-value {
            color: #FFFFFF;
        }


    /* =========================================================
           SECTION INTRO
           ========================================================= */

    .dashboard-section-intro {
        display: grid;
        grid-template-columns: .35fr 1.65fr;
        gap: 35px;
        align-items: end;
        margin-top: 90px;
        margin-bottom: 28px;
    }


    .dashboard-section-label {
        color: var(--burgundy-dark);
        font-size: 9px;
        font-weight: 800;
        line-height: 1.7;
        letter-spacing: .34em;
    }


    .dashboard-section-title {
        margin: 0;
        color: var(--teal-deep);
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: clamp(2.8rem, 5vw, 5.4rem);
        line-height: .92;
        letter-spacing: -.055em;
        font-weight: 500;
    }


        .dashboard-section-title span {
            color: var(--burgundy);
            opacity: .88;
        }


    /* =========================================================
           SERVICES
           ========================================================= */

    .dashboard-services {
        background: #FFFFFF;
        border: 1px solid rgba(7,91,90,.12);
        border-radius: 32px;
        overflow: hidden;
        box-shadow: 0 30px 90px rgba(7,91,90,.07);
    }


    /* =========================================================
           CARD HEADER
           ========================================================= */

    .dashboard-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 28px 32px;
        border-bottom: 1px solid var(--line);
    }


    .dashboard-card-title {
        color: var(--teal-deep);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .30em;
    }


    .dashboard-card-link {
        color: var(--burgundy-dark);
        text-decoration: none;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .16em;
        transition: color .25s ease, transform .25s ease;
    }


        .dashboard-card-link:hover {
            color: var(--teal-dark);
        }


    /* =========================================================
           SERVICES ROW
           ========================================================= */

    .dashboard-service-row {
        display: grid;
        grid-template-columns: 1fr 150px 150px;
        gap: 20px;
        align-items: center;
        padding: 23px 32px;
        border-bottom: 1px solid var(--line);
        transition: background .3s ease, padding-left .3s ease;
    }


        .dashboard-service-row:last-child {
            border-bottom: 0;
        }


        .dashboard-service-row:hover {
            background: linear-gradient( 90deg, var(--teal-pale), #FFFFFF );
            padding-left: 37px;
        }


    .dashboard-service-name {
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 800;
    }


    .dashboard-service-count {
        color: var(--muted);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .08em;
    }


    .dashboard-service-revenue {
        color: var(--burgundy-dark);
        font-size: 12px;
        font-weight: 800;
        text-align: right;
    }


    .dashboard-empty {
        padding: 40px 32px;
        color: var(--muted);
        font-size: 11px;
    }


    /* =========================================================
           MAIN CONTENT
           ========================================================= */

    .dashboard-content {
        display: grid;
        grid-template-columns: 1.35fr .65fr;
        gap: 22px;
        margin-top: 22px;
    }


    .dashboard-card {
        background: #FFFFFF;
        border: 1px solid rgba(7,91,90,.12);
        border-radius: 32px;
        overflow: hidden;
        box-shadow: 0 25px 80px rgba(7,91,90,.06);
    }


    /* =========================================================
           APPOINTMENTS
           ========================================================= */

    .dashboard-appointment {
        position: relative;
        display: grid;
        grid-template-columns: 90px minmax(0,1fr) auto;
        gap: 20px;
        align-items: center;
        padding: 23px 32px;
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid var(--line);
        transition: background .3s ease, padding-left .3s ease;
    }


        .dashboard-appointment:last-child {
            border-bottom: 0;
        }


        .dashboard-appointment:hover {
            background: linear-gradient( 90deg, var(--burgundy-pale), #FFFFFF );
            padding-left: 37px;
        }


    .dashboard-time {
        color: var(--burgundy-dark);
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.04em;
    }


    .dashboard-client {
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 800;
    }


    .dashboard-service {
        margin-top: 6px;
        color: var(--muted);
        font-size: 9px;
    }


    .dashboard-status {
        color: var(--teal-dark);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .16em;
        text-align: right;
    }


    /* =========================================================
           AT A GLANCE
           ========================================================= */

    .dashboard-side-item {
        position: relative;
        padding: 30px 32px;
        border-bottom: 1px solid var(--line);
        overflow: hidden;
    }


        .dashboard-side-item:last-child {
            border-bottom: 0;
        }


        .dashboard-side-item::after {
            content: "";
            position: absolute;
            right: -50px;
            bottom: -70px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(128,0,32,.16), rgba(25,184,178,.05) 55%, transparent 70% );
        }


    .dashboard-glance-label {
        color: var(--teal-deep);
        opacity: .46;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .22em;
    }


    .dashboard-glance-value {
        position: relative;
        z-index: 2;
        margin-top: 12px;
        color: var(--burgundy-dark);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 38px;
        letter-spacing: -.05em;
    }


    /* alternating colors */

    .dashboard-side-item:nth-child(3)
    .dashboard-glance-value {
        color: var(--teal-deep);
    }


    .dashboard-side-item:nth-child(4)
    .dashboard-glance-value {
        color: var(--teal);
    }


    /* =========================================================
           REMINDERS — TEAL
           ========================================================= */

    .dashboard-reminders {
        position: relative;
        margin-top: 22px;
        background: radial-gradient( circle at 92% 0%, rgba(128,0,32,.20), transparent 31% ), linear-gradient( 145deg, #075B5A, #087F7A 58%, #043F40 );
        color: white;
        border: 1px solid rgba(25,184,178,.20);
        border-radius: 32px;
        overflow: hidden;
        box-shadow: 0 30px 90px rgba(7,91,90,.20);
    }


        .dashboard-reminders::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            right: -210px;
            top: -270px;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(128,0,32,.20), transparent 68% );
            filter: blur(8px);
            pointer-events: none;
        }


    .dashboard-reminders-header {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 28px 32px;
        border-bottom: 1px solid rgba(255,255,255,.10);
    }


    .dashboard-reminders-title {
        color: var(--burgundy-light);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .30em;
    }


    .dashboard-reminders-meta {
        color: rgba(255,255,255,.42);
        font-size: 8px;
        letter-spacing: .18em;
    }


    .dashboard-reminder {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 90px 1fr auto;
        gap: 20px;
        align-items: center;
        padding: 23px 32px;
        color: white;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,.075);
        transition: background .3s ease, padding-left .3s ease;
    }


        .dashboard-reminder:last-child {
            border-bottom: 0;
        }


        .dashboard-reminder:hover {
            background: linear-gradient( 90deg, rgba(128,0,32,.10), rgba(25,184,178,.04) );
            padding-left: 37px;
        }


    .dashboard-reminder-time {
        color: var(--burgundy-light);
        font-size: 20px;
        font-weight: 700;
    }


    .dashboard-reminder-client {
        font-size: 13px;
        font-weight: 800;
    }


    .dashboard-reminder-details {
        margin-top: 6px;
        color: rgba(255,255,255,.42);
        font-size: 9px;
    }


    .dashboard-reminder-status {
        color: var(--burgundy-light);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .16em;
    }


    .dashboard-reminder-empty {
        position: relative;
        z-index: 2;
        padding: 38px 32px;
        color: rgba(255,255,255,.40);
        font-size: 11px;
    }


    /* =========================================================
           QUICK ACTIONS
           ========================================================= */

    .dashboard-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
        margin-top: 22px;
    }


    .dashboard-action {
        position: relative;
        min-height: 240px;
        padding: 38px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: white;
        text-decoration: none;
        background: radial-gradient( circle at 90% 0%, rgba(25,184,178,.20), transparent 34% ), linear-gradient( 145deg, #5C0017, #800020 );
        border: 1px solid var(--burgundy-border);
        border-radius: 32px;
        overflow: hidden;
        box-shadow: 0 25px 80px rgba(7,91,90,.17);
        transition: transform .35s ease, box-shadow .35s ease;
    }


        /* SECOND ACTION — DEEP TEAL */

        .dashboard-action:nth-child(2) {
            background: radial-gradient( circle at 90% 0%, rgba(128,0,32,.20), transparent 32% ), linear-gradient( 145deg, #075B5A, #087F7A );
        }


        .dashboard-action::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: -100px;
            bottom: -150px;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(255,255,255,.12), transparent 68% );
            transition: transform .7s ease;
        }


        .dashboard-action:hover {
            transform: translateY(-5px);
            box-shadow: 0 35px 100px rgba(7,91,90,.24);
        }


            .dashboard-action:hover::after {
                transform: scale(1.3);
            }


    .dashboard-action-label {
        position: relative;
        z-index: 2;
        color: var(--burgundy-light);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .30em;
    }


    .dashboard-action:nth-child(2)
    .dashboard-action-label {
        color: #FFFFFF;
        opacity: .80;
    }


    .dashboard-action-title {
        position: relative;
        z-index: 2;
        max-width: 500px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2rem, 3vw, 3rem);
        line-height: .88;
        letter-spacing: -.05em;
    }


    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 1100px) {

        .dashboard-hero {
            grid-template-columns: 1fr;
        }

        .dashboard-hero-main,
        .dashboard-hero-side {
            min-height: 430px;
        }

        .dashboard-content {
            grid-template-columns: 1fr;
        }

        .dashboard-section-intro {
            grid-template-columns: 1fr;
            gap: 18px;
        }
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 800px) {

        .dashboard-shell {
            width: calc(100% - 28px);
            padding-top: 100px;
            padding-bottom: 60px;
        }


        .dashboard-hero-main {
            min-height: 540px;
            padding: 34px 27px;
            border-radius: 28px;
        }


        .dashboard-hero-side {
            min-height: 400px;
            padding: 34px 27px;
            border-radius: 28px;
        }


        .dashboard-title {
            font-size: clamp(3.8rem, 16vw, 6rem);
        }


        .dashboard-subtitle {
            font-size: 12px;
        }


        .dashboard-stats {
            grid-template-columns: repeat(2, 1fr);
            border-radius: 25px;
        }


        .dashboard-stat {
            min-height: 160px;
            padding: 24px;
        }


        .dashboard-stat-value {
            margin-top: 40px;
            font-size: 32px;
        }


        .dashboard-revenue {
            grid-template-columns: 1fr;
            border-radius: 25px;
        }


        .dashboard-revenue-card {
            min-height: 145px;
            padding: 27px;
        }


        .dashboard-revenue-value {
            margin-top: 25px;
            font-size: 34px;
        }


        .dashboard-section-intro {
            margin-top: 65px;
        }


        .dashboard-section-title {
            font-size: clamp(2.7rem, 12vw, 4.3rem);
        }


        .dashboard-services,
        .dashboard-card,
        .dashboard-reminders,
        .dashboard-action {
            border-radius: 28px;
        }


        .dashboard-card-header,
        .dashboard-reminders-header {
            padding: 25px 22px;
        }


        .dashboard-service-row {
            grid-template-columns: 1fr auto;
            padding: 21px 22px;
        }


            .dashboard-service-row:hover {
                padding-left: 26px;
            }


        .dashboard-service-count {
            display: none;
        }


        .dashboard-service-revenue {
            text-align: right;
        }


        .dashboard-appointment {
            grid-template-columns: 65px minmax(0,1fr) 65px;
            gap: 12px;
            padding: 21px 22px;
        }


            .dashboard-appointment:hover {
                padding-left: 26px;
            }


        .dashboard-time {
            font-size: 17px;
        }


        .dashboard-status {
            font-size: 7px;
        }


        .dashboard-side-item {
            padding: 27px 22px;
        }


        .dashboard-reminder {
            grid-template-columns: 65px minmax(0,1fr);
            gap: 12px;
            padding: 21px 22px;
        }


        .dashboard-reminder-status {
            display: none;
        }


        .dashboard-reminder:hover {
            padding-left: 26px;
        }


        .dashboard-actions {
            grid-template-columns: 1fr;
        }


        .dashboard-action {
            min-height: 220px;
            padding: 30px 27px;
        }
    }


    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 480px) {

        .dashboard-shell {
            width: calc(100% - 20px);
        }


        .dashboard-hero-main {
            min-height: 520px;
            padding: 30px 22px;
        }


        .dashboard-hero-side {
            min-height: 370px;
            padding: 30px 22px;
        }


        .dashboard-title {
            font-size: 3.65rem;
        }


        .dashboard-stats {
            grid-template-columns: 1fr;
        }


        .dashboard-stat {
            min-height: 145px;
        }


        .dashboard-stat-value {
            margin-top: 30px;
        }


        .dashboard-card-title {
            font-size: 8px;
        }


        .dashboard-card-link {
            font-size: 7px;
        }


        .dashboard-appointment {
            grid-template-columns: 56px minmax(0,1fr) 55px;
            padding: 20px 17px;
        }


        .dashboard-time {
            font-size: 14px;
        }


        .dashboard-client {
            font-size: 12px;
        }


        .dashboard-service {
            font-size: 8px;
        }


        .dashboard-status {
            font-size: 6px;
        }


        .dashboard-reminder {
            grid-template-columns: 56px minmax(0,1fr);
            padding: 20px 17px;
        }


        .dashboard-reminder-time {
            font-size: 15px;
        }


        .dashboard-reminder-client {
            font-size: 12px;
        }


        .dashboard-reminder-details {
            font-size: 8px;
        }


        .dashboard-action {
            min-height: 200px;
            padding: 27px 22px;
        }


        .dashboard-action-title {
            font-size: 2.8rem;
        }
    }


    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .dashboard-page *,
        .dashboard-page *::before,
        .dashboard-page *::after {
            transition: none !important;
            animation: none !important;
        }
    }

</style>


<div class="dashboard-page">

    <div class="dashboard-shell">


        <!-- =====================================================
             HERO
             ===================================================== -->

        <section class="dashboard-hero">


            <!-- HERO MAIN -->

            <div class="dashboard-hero-main">

                <div>

                    <div class="dashboard-kicker">
                        AUREVA / COMMAND CENTER
                    </div>

                    <div class="dashboard-date">
                        @DateTime.Today.ToString("dddd · dd MMMM").ToUpper()
                    </div>

                    <h1 class="dashboard-title">

                        Everything,
                        <br />

                        <span>in perfect view.</span>

                    </h1>

                    <p class="dashboard-subtitle">

                        A single elegant view of your salon today —
                        appointments, clients, services, team availability
                        and the revenue keeping AUREVA moving.

                    </p>

                </div>


                <div class="dashboard-side-bottom">

                    <div class="dashboard-side-mini-label">
                        TODAY / APPOINTMENTS
                    </div>

                    <div class="dashboard-side-mini-value">
                        @todayAppointments.Count
                    </div>

                </div>

            </div>


            <!-- HERO SIDE -->

            <div class="dashboard-hero-side">

                <div>

                    <div class="dashboard-side-label">
                        AUREVA OVERVIEW
                    </div>

                    <div class="dashboard-side-heading">

                        The day,
                        <br />

                        <span>beautifully organized.</span>

                    </div>

                </div>


                <div class="dashboard-side-bottom">

                    <div class="dashboard-side-mini-label">
                        TODAY REVENUE
                    </div>

                    <div class="dashboard-side-mini-value">
                        @todayRevenue.ToString("C")
                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             MAIN STATS
             ===================================================== -->

        <section class="dashboard-stats">

            <div class="dashboard-stat">

                <div class="dashboard-stat-label">
                    CLIENTS
                </div>

                <div class="dashboard-stat-value">
                    @totalClients
                </div>

            </div>


            <div class="dashboard-stat">

                <div class="dashboard-stat-label">
                    TODAY / APPOINTMENTS
                </div>

                <div class="dashboard-stat-value">
                    @todayAppointments.Count
                </div>

            </div>


            <div class="dashboard-stat">

                <div class="dashboard-stat-label">
                    TODAY / REVENUE
                </div>

                <div class="dashboard-stat-value">
                    @todayRevenue.ToString("C")
                </div>

            </div>


            <div class="dashboard-stat">

                <div class="dashboard-stat-label">
                    ACTIVE SERVICES
                </div>

                <div class="dashboard-stat-value">
                    @activeServices
                </div>

            </div>

        </section>


        <!-- =====================================================
             REVENUE
             ===================================================== -->

        <section class="dashboard-revenue">

            <div class="dashboard-revenue-card">

                <div class="dashboard-revenue-label">
                    TODAY REVENUE
                </div>

                <div class="dashboard-revenue-value">
                    @todayRevenue.ToString("C")
                </div>

            </div>


            <div class="dashboard-revenue-card">

                <div class="dashboard-revenue-label">
                    THIS WEEK
                </div>

                <div class="dashboard-revenue-value">
                    @weekRevenue.ToString("C")
                </div>

            </div>


            <div class="dashboard-revenue-card">

                <div class="dashboard-revenue-label">
                    THIS MONTH
                </div>

                <div class="dashboard-revenue-value">
                    @monthRevenue.ToString("C")
                </div>

            </div>

        </section>


        <!-- =====================================================
             SERVICES INTRO
             ===================================================== -->

        <div class="dashboard-section-intro">

            <div class="dashboard-section-label">
                PERFORMANCE / SERVICES
            </div>

            <h2 class="dashboard-section-title">

                What your clients
                <span>choose most.</span>

            </h2>

        </div>


        <!-- =====================================================
             TOP SERVICES
             ===================================================== -->

        <section class="dashboard-services">

            <div class="dashboard-card-header">

                <div class="dashboard-card-title">
                    MOST REQUESTED SERVICES
                </div>

                <div class="dashboard-card-link">
                    AUREVA / INSIGHTS
                </div>

            </div>


            @if (topServices.Count > 0)
            {
                foreach (var service in topServices)
                {
                    <div class="dashboard-service-row">

                        <div class="dashboard-service-name">
                            @service.Name
                        </div>

                        <div class="dashboard-service-count">
                            @service.Count APPOINTMENTS
                        </div>

                        <div class="dashboard-service-revenue">
                            @service.Revenue.ToString("C")
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="dashboard-empty">
                    No service data yet.
                </div>
            }

        </section>


        <!-- =====================================================
             REMINDERS
             ===================================================== -->

        <section class="dashboard-reminders">

            <div class="dashboard-reminders-header">

                <div class="dashboard-reminders-title">
                    REMINDERS
                </div>

                <div class="dashboard-reminders-meta">
                    NEXT 24 HOURS
                </div>

            </div>


            @if (reminderAppointments.Any())
            {
                foreach (var appointment in reminderAppointments)
                {
                    <a asp-controller="Appointments"
                       asp-action="Details"
                       asp-route-id="@appointment.Id"
                       class="dashboard-reminder">

                        <div class="dashboard-reminder-time">
                            @appointment.StartTime.ToString("HH:mm")
                        </div>


                        <div>

                            <div class="dashboard-reminder-client">
                                @appointment.Client?.FullName
                            </div>

                            <div class="dashboard-reminder-details">

                                @appointment.Service?.Name

                                ·

                                @appointment.Staff?.FullName

                            </div>

                        </div>


                        <div class="dashboard-reminder-status">
                            UPCOMING
                        </div>

                    </a>
                }
            }
            else
            {
                <div class="dashboard-reminder-empty">

                    No appointments require attention
                    in the next 24 hours.

                </div>
            }

        </section>


        <!-- =====================================================
             APPOINTMENTS / GLANCE INTRO
             ===================================================== -->

        <div class="dashboard-section-intro">

            <div class="dashboard-section-label">
                THE DAY AHEAD
            </div>

            <h2 class="dashboard-section-title">

                Everything important,
                <span>in one place.</span>

            </h2>

        </div>


        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <section class="dashboard-content">


            <!-- UPCOMING -->

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <div class="dashboard-card-title">
                        UPCOMING APPOINTMENTS
                    </div>

                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="dashboard-card-link">

                        VIEW ALL →

                    </a>

                </div>


                @if (upcomingAppointments.Any())
                {
                    foreach (var appointment in upcomingAppointments)
                    {
                        <a asp-controller="Appointments"
                           asp-action="Details"
                           asp-route-id="@appointment.Id"
                           class="dashboard-appointment">

                            <div class="dashboard-time">
                                @appointment.StartTime.ToString("HH:mm")
                            </div>

                            <div>

                                <div class="dashboard-client">
                                    @appointment.Client?.FullName
                                </div>

                                <div class="dashboard-service">

                                    @appointment.Service?.Name

                                    ·

                                    @appointment.Staff?.FullName

                                </div>

                            </div>

                            <div class="dashboard-status">

                                @appointment.Status.ToUpper()

                            </div>

                        </a>
                    }
                }
                else
                {
                    <div class="dashboard-empty">
                        No upcoming appointments.
                    </div>
                }

            </div>


            <!-- AT A GLANCE -->

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <div class="dashboard-card-title">
                        AT A GLANCE
                    </div>

                </div>


                <div class="dashboard-side-item">

                    <div class="dashboard-glance-label">
                        AVAILABLE TEAM
                    </div>

                    <div class="dashboard-glance-value">
                        @availableStaff
                    </div>

                </div>


                <div class="dashboard-side-item">

                    <div class="dashboard-glance-label">
                        ACTIVE SERVICES
                    </div>

                    <div class="dashboard-glance-value">
                        @activeServices
                    </div>

                </div>


                <div class="dashboard-side-item">

                    <div class="dashboard-glance-label">
                        TODAY
                    </div>

                    <div class="dashboard-glance-value">
                        @DateTime.Today.ToString("dd MMM")
                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             QUICK ACTIONS
             ===================================================== -->

        <div class="dashboard-section-intro">

            <div class="dashboard-section-label">
                AUREVA / QUICK ACTIONS
            </div>

            <h2 class="dashboard-section-title">

                Keep the day
                <span>moving.</span>

            </h2>

        </div>


        <section class="dashboard-actions">


            <a asp-controller="Appointments"
               asp-action="Create"
               class="dashboard-action">

                <div class="dashboard-action-label">
                    QUICK ACTION
                </div>

                <div class="dashboard-action-title">

                    Book a new
                    appointment →

                </div>

            </a>


            <a asp-controller="Clients"
               asp-action="Create"
               class="dashboard-action">

                <div class="dashboard-action-label">
                    CLIENTS
                </div>

                <div class="dashboard-action-title">

                    Remember
                    someone new →

                </div>

            </a>


        </section>


    </div>

</div>