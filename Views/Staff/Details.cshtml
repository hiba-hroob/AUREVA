@model AUREVA.Models.Staff

@{
    ViewData["Title"] = "Staff Details";
}

<style>
    :root {
        --teal: #169C98;
        --teal-dark: #0B7773;
        --teal-deep: #064F50;
        --teal-soft: #DDF3F1;
        --teal-pale: #F2F9F8;
        --burgundy: #731B35;
        --burgundy-dark: #521126;
        --burgundy-soft: #D9AEB9;
        --burgundy-pale: #FAF0F3;
        --white: #FFFFFF;
        --ivory: #F8F7F2;
        --ivory-dark: #ECECE5;
        --text: #173334;
        --text-soft: #4E6563;
        --text-muted: #81918F;
        --text-faint: #A9B8B6;
    }

    * {
        box-sizing: border-box;
    }

    .staff-details-page {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        padding: 48px 28px 70px;
        background: radial-gradient(circle at 10% 10%, rgba(22,156,152,.07), transparent 30%), radial-gradient(circle at 88% 80%, rgba(115,27,53,.06), transparent 28%), var(--ivory);
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .staff-details-page::before {
            content: "A";
            position: absolute;
            top: 100px;
            right: -30px;
            z-index: 0;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 34vw, 34rem);
            line-height: .72;
            font-weight: 400;
            color: rgba(22,156,152,.065);
            pointer-events: none;
            user-select: none;
        }

    .staff-details-shell {
        position: relative;
        z-index: 1;
        width: min(1120px, 100%);
        margin: 0 auto;
    }

    /* =========================
           TOPLINE
        ========================= */

    .staff-details-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 16px;
        margin-bottom: 32px;
        border-bottom: 1px solid rgba(23,51,52,.11);
    }

    .staff-details-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--teal-dark);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .22em;
        text-transform: uppercase;
    }

        .staff-details-kicker::before {
            content: "";
            width: 28px;
            height: 1px;
            background: var(--teal);
        }

    .staff-details-record {
        color: var(--text-muted);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    /* =========================
           HERO
        ========================= */

    .staff-details-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 70px;
        align-items: end;
        margin-bottom: 42px;
    }

    .staff-details-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.8rem, 7vw, 7rem);
        line-height: .84;
        font-weight: 400;
        letter-spacing: -.055em;
        color: var(--teal-deep);
        word-break: break-word;
    }

        .staff-details-title span {
            color: var(--burgundy);
            font-style: italic;
        }

    .staff-details-intro {
        max-width: 650px;
        margin: 23px 0 0;
        color: var(--text-soft);
        font-size: 13px;
        line-height: 1.9;
    }

    .staff-details-note {
        padding: 20px 22px;
        border-left: 2px solid var(--burgundy);
        background: rgba(255,255,255,.5);
    }

    .staff-details-note-label {
        display: block;
        margin-bottom: 8px;
        color: var(--burgundy);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .staff-details-note p {
        margin: 0;
        color: var(--text-soft);
        font-size: 11px;
        line-height: 1.8;
    }

    /* =========================
           PROFILE FRAME
        ========================= */

    .staff-details-frame {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        border: 1px solid rgba(23,51,52,.11);
        background: rgba(255,255,255,.74);
        box-shadow: 0 28px 75px rgba(6,79,80,.08), 0 8px 25px rgba(23,51,52,.05);
        backdrop-filter: blur(14px);
    }

    /* =========================
           SIDE
        ========================= */

    .staff-details-side {
        position: relative;
        overflow: hidden;
        padding: 38px 30px;
        background: linear-gradient( 180deg, rgba(6,79,80,.98), rgba(11,119,115,.98) );
        color: var(--white);
    }

        .staff-details-side::after {
            content: "A";
            position: absolute;
            right: -30px;
            bottom: -45px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 11rem;
            line-height: 1;
            color: rgba(255,255,255,.045);
            pointer-events: none;
        }

    .side-kicker {
        display: block;
        margin-bottom: 15px;
        color: rgba(255,255,255,.62);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .side-title {
        margin: 0 0 15px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        line-height: 1.05;
        font-weight: 400;
    }

    .side-copy {
        margin: 0;
        color: rgba(255,255,255,.69);
        font-size: 11px;
        line-height: 1.9;
    }

    .side-rule {
        width: 100%;
        height: 1px;
        margin: 28px 0;
        background: rgba(255,255,255,.14);
    }

    .side-status {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        border: 1px solid rgba(255,255,255,.16);
        background: rgba(255,255,255,.055);
    }

    .side-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--teal);
        box-shadow: 0 0 0 4px rgba(22,156,152,.13);
    }

    .side-status.busy .side-status-dot {
        background: var(--burgundy-soft);
        box-shadow: 0 0 0 4px rgba(217,174,185,.1);
    }

    .side-status-text {
        color: rgba(255,255,255,.84);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .15em;
        text-transform: uppercase;
    }

    /* =========================
           CONTENT
        ========================= */

    .staff-details-content {
        padding: 42px 44px 38px;
    }

    .content-heading {
        margin-bottom: 30px;
    }

    .content-heading-kicker {
        display: block;
        margin-bottom: 7px;
        color: var(--burgundy);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .content-heading-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        line-height: 1;
        font-weight: 400;
        letter-spacing: -.025em;
        color: var(--teal-deep);
    }

    /* =========================
           INFO GRID
        ========================= */

    .staff-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid rgba(23,51,52,.1);
        border-left: 1px solid rgba(23,51,52,.1);
    }

    .staff-info-item {
        min-width: 0;
        padding: 25px 24px;
        border-right: 1px solid rgba(23,51,52,.1);
        border-bottom: 1px solid rgba(23,51,52,.1);
        background: rgba(255,255,255,.42);
        transition: background .2s ease, transform .2s ease;
    }

        .staff-info-item:hover {
            background: var(--teal-pale);
        }

    .staff-info-label {
        display: block;
        margin-bottom: 13px;
        color: var(--text-muted);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .staff-info-value {
        min-height: 25px;
        color: var(--text);
        font-size: 14px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

        .staff-info-value.role {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 24px;
            line-height: 1.15;
            color: var(--teal-deep);
        }

        .staff-info-value.muted {
            color: var(--text-faint);
        }

    /* =========================
           STATUS
        ========================= */

    .staff-status {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--teal-dark);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .staff-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--teal);
        box-shadow: 0 0 0 5px rgba(22,156,152,.1);
    }

    .staff-status.busy {
        color: var(--burgundy);
    }

        .staff-status.busy .staff-status-dot {
            background: var(--burgundy);
            box-shadow: 0 0 0 5px rgba(115,27,53,.09);
        }

    /* =========================
           ACTIONS
        ========================= */

    .staff-details-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 34px;
        padding-top: 24px;
        border-top: 1px solid rgba(23,51,52,.1);
    }

    .staff-back {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text-soft);
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
        transition: color .2s ease, gap .2s ease;
    }

        .staff-back::before {
            content: "←";
            font-size: 15px;
            line-height: 1;
        }

        .staff-back:hover {
            color: var(--teal-dark);
            gap: 13px;
        }

    .staff-action-group {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .staff-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 45px;
        padding: 12px 20px;
        border: 1px solid rgba(23,51,52,.16);
        background: transparent;
        color: var(--text);
        text-decoration: none;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .17em;
        text-transform: uppercase;
        transition: background .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
    }

        .staff-action:hover {
            background: var(--teal-pale);
            border-color: rgba(22,156,152,.35);
            color: var(--teal-deep);
            transform: translateY(-1px);
        }

        .staff-action.delete {
            border-color: var(--burgundy);
            background: var(--burgundy);
            color: var(--white);
        }

            .staff-action.delete:hover {
                border-color: var(--burgundy-dark);
                background: var(--burgundy-dark);
                color: var(--white);
                transform: translateY(-1px);
            }

    /* =========================
           FOOTER
        ========================= */

    .staff-details-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

        .staff-details-footer span {
            color: var(--text-faint);
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 1000px) {

        .staff-details-hero {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .staff-details-note {
            max-width: 500px;
        }

        .staff-details-frame {
            grid-template-columns: 235px minmax(0, 1fr);
        }

        .staff-details-content {
            padding: 36px 30px;
        }
    }

    @@media (max-width: 780px) {

        .staff-details-page {
            padding: 32px 18px 50px;
        }

        .staff-details-frame {
            grid-template-columns: 1fr;
        }

        .staff-details-side {
            padding: 30px;
        }

            .staff-details-side::after {
                display: none;
            }

        .side-rule {
            margin: 22px 0;
        }
    }

    @@media (max-width: 620px) {

        .staff-details-page::before {
            top: 170px;
            right: -70px;
            font-size: 18rem;
        }

        .staff-details-topline {
            align-items: flex-start;
            flex-direction: column;
            gap: 9px;
        }

        .staff-details-title {
            font-size: 3.5rem;
        }

        .staff-details-content {
            padding: 30px 20px;
        }

        .staff-info-grid {
            grid-template-columns: 1fr;
        }

        .staff-info-item {
            padding: 21px 18px;
        }

        .staff-details-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .staff-action-group {
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .staff-back {
            width: 100%;
        }
    }

    @@media (max-width: 430px) {

        .staff-details-page {
            padding-left: 12px;
            padding-right: 12px;
        }

        .staff-details-title {
            font-size: 3rem;
        }

        .staff-details-intro {
            font-size: 12px;
        }

        .staff-details-side {
            padding: 25px 20px;
        }

        .staff-details-content {
            padding: 26px 16px;
        }

        .staff-action-group {
            grid-template-columns: 1fr;
        }

        .staff-action {
            width: 100%;
        }
    }
</style>


<div class="staff-details-page">

    <div class="staff-details-shell">

        <!-- TOPLINE -->
        <div class="staff-details-topline">

            <div class="staff-details-kicker">
                Team Member
            </div>

            <div class="staff-details-record">
                Record #@Model.Id
            </div>

        </div>


        <!-- HERO -->
        <section class="staff-details-hero">

            <div>

                <h1 class="staff-details-title">
                    @Model.FullName
                </h1>

                <p class="staff-details-intro">
                    A closer look at this team member's professional profile,
                    contact details, and current availability within AUREVA.
                </p>

            </div>


            <div class="staff-details-note">

                <span class="staff-details-note-label">
                    AUREVA Standard
                </span>

                <p>
                    Each team member contributes to the experience,
                    precision, and character of the atelier.
                </p>

            </div>

        </section>


        <!-- PROFILE FRAME -->
        <section class="staff-details-frame">

            <!-- SIDE -->
            <aside class="staff-details-side">

                <span class="side-kicker">
                    Profile Edition
                </span>

                <h2 class="side-title">
                    Team<br />
                    identity.
                </h2>

                <p class="side-copy">
                    Professional information presented with the clarity
                    and restraint that defines the AUREVA identity.
                </p>

                <div class="side-rule"></div>


                <div class="side-status @(Model.IsAvailable ? "" : "busy")">

                    <span class="side-status-dot"></span>

                    <span class="side-status-text">
                        @(Model.IsAvailable ? "Available" : "Busy")
                    </span>

                </div>

            </aside>


            <!-- CONTENT -->
            <div class="staff-details-content">

                <div class="content-heading">

                    <span class="content-heading-kicker">
                        Professional Record
                    </span>

                    <h2 class="content-heading-title">
                        Member details
                    </h2>

                </div>


                <div class="staff-info-grid">

                    <!-- ROLE -->
                    <div class="staff-info-item">

                        <span class="staff-info-label">
                            Role
                        </span>

                        <div class="staff-info-value role
                            @(string.IsNullOrWhiteSpace(Model.Role) ? "muted" : "")">

                            @(string.IsNullOrWhiteSpace(Model.Role)
                                ? "—"
                                : Model.Role)

                        </div>

                    </div>


                    <!-- STATUS -->
                    <div class="staff-info-item">

                        <span class="staff-info-label">
                            Status
                        </span>

                        <div class="staff-status @(Model.IsAvailable ? "" : "busy")">

                            <span class="staff-status-dot"></span>

                            <span>
                                @(Model.IsAvailable
                                    ? "Available"
                                    : "Busy")
                            </span>

                        </div>

                    </div>


                    <!-- EMAIL -->
                    <div class="staff-info-item">

                        <span class="staff-info-label">
                            Email
                        </span>

                        <div class="staff-info-value
                            @(string.IsNullOrWhiteSpace(Model.Email) ? "muted" : "")">

                            @(string.IsNullOrWhiteSpace(Model.Email)
                                ? "—"
                                : Model.Email)

                        </div>

                    </div>


                    <!-- PHONE -->
                    <div class="staff-info-item">

                        <span class="staff-info-label">
                            Phone
                        </span>

                        <div class="staff-info-value
                            @(string.IsNullOrWhiteSpace(Model.Phone) ? "muted" : "")">

                            @(string.IsNullOrWhiteSpace(Model.Phone)
                                ? "—"
                                : Model.Phone)

                        </div>

                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="staff-details-actions">

                    <a asp-action="Index"
                       class="staff-back">
                        Back to Team
                    </a>


                    <div class="staff-action-group">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="staff-action">
                            Edit Profile
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="staff-action delete">
                            Delete
                        </a>

                    </div>

                </div>

            </div>

        </section>


        <!-- FOOTER -->
        <div class="staff-details-footer">

            <span>
                AUREVA / Team Management
            </span>

        </div>

    </div>

</div>