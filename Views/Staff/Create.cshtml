@model AUREVA.Models.Staff

@{
    ViewData["Title"] = "New Staff";
}

<style>
    :root {
        --teal: #169C98;
        --teal-dark: #0B7773;
        --teal-deep: #064F50;
        --teal-soft: #DDF3F1;
        --teal-pale: #F2F9F8;
        --burgundy: #731B35;
        --burgundy-dark: #521126;
        --burgundy-soft: #D9AEB9;
        --burgundy-pale: #FAF0F3;
        --white: #FFFFFF;
        --ivory: #F8F7F2;
        --ivory-dark: #ECECE5;
        --text: #173334;
        --text-soft: #4E6563;
        --text-muted: #81918F;
        --text-faint: #A9B8B6;
    }

    * {
        box-sizing: border-box;
    }

    .staff-create-page {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        padding: 48px 28px 70px;
        background: radial-gradient(circle at 10% 12%, rgba(22,156,152,.07), transparent 30%), radial-gradient(circle at 88% 82%, rgba(115,27,53,.06), transparent 28%), var(--ivory);
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .staff-create-page::before {
            content: "A";
            position: absolute;
            top: 105px;
            right: -30px;
            z-index: 0;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(19rem, 34vw, 34rem);
            line-height: .72;
            font-weight: 400;
            color: rgba(22,156,152,.065);
            pointer-events: none;
            user-select: none;
        }

    .staff-create-shell {
        position: relative;
        z-index: 1;
        width: min(1180px, 100%);
        margin: 0 auto;
    }

    /* =========================
           TOPLINE
        ========================= */

    .staff-create-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 16px;
        margin-bottom: 30px;
        border-bottom: 1px solid rgba(23,51,52,.11);
    }

    .staff-create-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--teal-dark);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .22em;
        text-transform: uppercase;
    }

        .staff-create-kicker::before {
            content: "";
            width: 28px;
            height: 1px;
            background: var(--teal);
        }

    .staff-create-record {
        color: var(--text-muted);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    /* =========================
           HERO
        ========================= */

    .staff-create-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 70px;
        align-items: end;
        margin-bottom: 42px;
    }

    .staff-create-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.8rem, 7vw, 7rem);
        line-height: .84;
        font-weight: 400;
        letter-spacing: -.055em;
        color: var(--teal-deep);
    }

        .staff-create-title span{
            color: var(--burgundy);
        }

    .staff-create-intro {
        max-width: 640px;
        margin: 23px 0 0;
        color: var(--text-soft);
        font-size: 13px;
        line-height: 1.9;
    }

    .staff-create-note {
        padding: 20px 22px;
        border-left: 2px solid var(--burgundy);
        background: rgba(255,255,255,.5);
    }

    .staff-create-note-label {
        display: block;
        margin-bottom: 8px;
        color: var(--burgundy);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .staff-create-note p {
        margin: 0;
        color: var(--text-soft);
        font-size: 11px;
        line-height: 1.8;
    }

    /* =========================
           MAIN FRAME
        ========================= */

    .staff-create-frame {
        display: grid;
        grid-template-columns: 285px minmax(0, 1fr);
        border: 1px solid rgba(23,51,52,.11);
        background: rgba(255,255,255,.74);
        box-shadow: 0 28px 75px rgba(6,79,80,.08), 0 8px 25px rgba(23,51,52,.05);
        backdrop-filter: blur(14px);
    }

    /* =========================
           SIDE
        ========================= */

    .staff-create-side {
        position: relative;
        overflow: hidden;
        padding: 38px 30px;
        background: linear-gradient( 180deg, rgba(6,79,80,.98), rgba(11,119,115,.98) );
        color: var(--white);
    }

        .staff-create-side::after {
            content: "A";
            position: absolute;
            right: -28px;
            bottom: -45px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 11rem;
            line-height: 1;
            color: rgba(255,255,255,.045);
            pointer-events: none;
        }

    .side-kicker {
        display: block;
        margin-bottom: 16px;
        color: rgba(255,255,255,.62);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .side-title {
        margin: 0 0 15px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        line-height: 1.05;
        font-weight: 400;
    }

    .side-copy {
        margin: 0;
        color: rgba(255,255,255,.69);
        font-size: 11px;
        line-height: 1.9;
    }

    .side-rule {
        width: 100%;
        height: 1px;
        margin: 28px 0;
        background: rgba(255,255,255,.14);
    }

    .side-step {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-bottom: 19px;
    }

        .side-step:last-child {
            margin-bottom: 0;
        }

    .side-step-number {
        flex: 0 0 28px;
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255,255,255,.23);
        color: rgba(255,255,255,.88);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .08em;
    }

    .side-step-text strong {
        display: block;
        margin-bottom: 4px;
        color: rgba(255,255,255,.92);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .side-step-text span {
        display: block;
        color: rgba(255,255,255,.56);
        font-size: 10px;
        line-height: 1.6;
    }

    /* =========================
           FORM CONTENT
        ========================= */

    .staff-create-content {
        padding: 42px 44px 38px;
    }

    .form-heading {
        margin-bottom: 30px;
    }

    .form-heading-kicker {
        display: block;
        margin-bottom: 7px;
        color: var(--burgundy);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
    }

    .form-heading-title {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        line-height: 1;
        font-weight: 400;
        letter-spacing: -.025em;
        color: var(--teal-deep);
    }

    .validation-summary {
        margin-bottom: 24px;
        padding: 15px 17px;
        border-left: 2px solid var(--burgundy);
        background: var(--burgundy-pale);
        color: var(--burgundy-dark);
        font-size: 11px;
        line-height: 1.7;
    }

        .validation-summary:empty {
            display: none;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px 20px;
    }

    .form-group {
        min-width: 0;
    }

        .form-group.full {
            grid-column: 1 / -1;
        }

    .form-label {
        display: block;
        margin-bottom: 9px;
        color: var(--text);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

        .form-label .required {
            color: var(--burgundy);
        }

    .form-control {
        width: 100%;
        min-height: 50px;
        padding: 13px 14px;
        border: 1px solid rgba(23,51,52,.14);
        border-radius: 0;
        outline: none;
        background: rgba(255,255,255,.88);
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: 13px;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

        .form-control:hover {
            border-color: rgba(22,156,152,.35);
            background: #fff;
        }

        .form-control:focus {
            border-color: var(--teal);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(22,156,152,.09);
        }

        .form-control::placeholder {
            color: var(--text-faint);
        }

    .field-validation-error {
        display: block;
        margin-top: 7px;
        color: var(--burgundy);
        font-size: 10px;
        line-height: 1.5;
    }

    /* =========================
           DIVIDER
        ========================= */

    .form-divider {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 2px 0;
    }

        .form-divider::before,
        .form-divider::after {
            content: "";
            height: 1px;
            background: rgba(23,51,52,.1);
        }

        .form-divider::before {
            width: 36px;
        }

        .form-divider::after {
            flex: 1;
        }

        .form-divider span {
            color: var(--text-muted);
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

    /* =========================
           AVAILABILITY
        ========================= */

    .availability-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 17px 18px;
        border: 1px solid rgba(23,51,52,.1);
        background: var(--teal-pale);
    }

    .availability-copy {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .availability-indicator {
        width: 9px;
        height: 9px;
        flex: 0 0 9px;
        border-radius: 50%;
        background: var(--teal);
        box-shadow: 0 0 0 5px rgba(22,156,152,.1);
    }

    .availability-text strong {
        display: block;
        margin-bottom: 4px;
        color: var(--teal-deep);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .availability-text span {
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.5;
    }

    .availability-check {
        position: relative;
        flex: 0 0 auto;
    }

        .availability-check input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .availability-toggle {
        position: relative;
        display: block;
        width: 44px;
        height: 24px;
        border-radius: 999px;
        background: #CCD8D6;
        cursor: pointer;
        transition: background .2s ease;
    }

        .availability-toggle::after {
            content: "";
            position: absolute;
            top: 4px;
            left: 4px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,.12);
            transition: transform .2s ease;
        }

    .availability-check input:checked + .availability-toggle {
        background: var(--teal);
    }

        .availability-check input:checked + .availability-toggle::after {
            transform: translateX(20px);
        }

    /* =========================
           ACTIONS
        ========================= */

    .staff-create-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 34px;
        padding-top: 24px;
        border-top: 1px solid rgba(23,51,52,.1);
    }

    .create-cancel {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text-soft);
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
        transition: color .2s ease, gap .2s ease;
    }

        .create-cancel::before {
            content: "←";
            font-size: 15px;
            line-height: 1;
        }

        .create-cancel:hover {
            color: var(--burgundy);
            gap: 13px;
        }

    .create-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 190px;
        min-height: 50px;
        padding: 14px 24px;
        border: 1px solid var(--teal-deep);
        border-radius: 0;
        background: var(--teal-deep);
        color: var(--white);
        cursor: pointer;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        transition: background .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease;
    }

        .create-submit::after {
            content: "↗";
            margin-left: 13px;
            font-size: 13px;
            line-height: 1;
        }

        .create-submit:hover {
            background: var(--burgundy);
            border-color: var(--burgundy);
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(115,27,53,.15);
        }

    /* =========================
           FOOTER
        ========================= */

    .staff-create-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

        .staff-create-footer span {
            color: var(--text-faint);
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .18em;
            text-transform: uppercase;
        }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 1050px) {

        .staff-create-hero {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .staff-create-note {
            max-width: 500px;
        }

        .staff-create-frame {
            grid-template-columns: 235px minmax(0, 1fr);
        }

        .staff-create-content {
            padding: 36px 30px;
        }
    }

    @@media (max-width: 820px) {

        .staff-create-page {
            padding: 32px 18px 50px;
        }

        .staff-create-frame {
            grid-template-columns: 1fr;
        }

        .staff-create-side {
            padding: 30px;
        }

            .staff-create-side::after {
                display: none;
            }

        .side-rule {
            margin: 22px 0;
        }
    }

    @@media (max-width: 620px) {

        .staff-create-page::before {
            top: 175px;
            right: -70px;
            font-size: 18rem;
        }

        .staff-create-topline {
            align-items: flex-start;
            flex-direction: column;
            gap: 9px;
        }

        .staff-create-title {
            font-size: 3.5rem;
        }

        .staff-create-content {
            padding: 30px 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: auto;
        }

        .form-divider {
            grid-column: auto;
        }

        .staff-create-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .create-submit,
        .create-cancel {
            width: 100%;
        }

        .create-cancel {
            justify-content: center;
        }
    }

    @@media (max-width: 430px) {

        .staff-create-page {
            padding-left: 12px;
            padding-right: 12px;
        }

        .staff-create-title {
            font-size: 3rem;
        }

        .staff-create-intro {
            font-size: 12px;
        }

        .staff-create-side {
            padding: 25px 20px;
        }

        .staff-create-content {
            padding: 26px 16px;
        }

        .form-control {
            min-height: 48px;
        }

        .availability-card {
            align-items: flex-start;
        }
    }
</style>


<div class="staff-create-page">

    <div class="staff-create-shell">

        <!-- TOPLINE -->
        <div class="staff-create-topline">

            <div class="staff-create-kicker">
                Team Management
            </div>

            <div class="staff-create-record">
                New Profile
            </div>

        </div>


        <!-- HERO -->
        <section class="staff-create-hero">

            <div>

                <h1 class="staff-create-title">
                    Add <span>Artist.</span>
                </h1>

                <p class="staff-create-intro">
                    Create a new professional profile and add a new member
                    to the AUREVA team.
                </p>

            </div>


            <div class="staff-create-note">

                <span class="staff-create-note-label">
                    AUREVA Standard
                </span>

                <p>
                    Every team member profile should feel precise,
                    polished, and consistent with the atelier identity.
                </p>

            </div>

        </section>


        <!-- MAIN FRAME -->
        <section class="staff-create-frame">

            <!-- SIDE PANEL -->
            <aside class="staff-create-side">

                <span class="side-kicker">
                    New Profile
                </span>

                <h2 class="side-title">
                    Build the<br />
                    profile.
                </h2>

                <p class="side-copy">
                    Enter the professional information of the new team
                    member and define their appointment availability.
                </p>

                <div class="side-rule"></div>


                <div class="side-step">

                    <div class="side-step-number">
                        01
                    </div>

                    <div class="side-step-text">
                        <strong>Identity</strong>
                        <span>Name &amp; professional role</span>
                    </div>

                </div>


                <div class="side-step">

                    <div class="side-step-number">
                        02
                    </div>

                    <div class="side-step-text">
                        <strong>Contact</strong>
                        <span>Email &amp; phone information</span>
                    </div>

                </div>


                <div class="side-step">

                    <div class="side-step-number">
                        03
                    </div>

                    <div class="side-step-text">
                        <strong>Status</strong>
                        <span>Appointment availability</span>
                    </div>

                </div>

            </aside>


            <!-- FORM -->
            <div class="staff-create-content">

                <div class="form-heading">

                    <span class="form-heading-kicker">
                        Team Member Details
                    </span>

                    <h2 class="form-heading-title">
                        Create the profile
                    </h2>

                </div>


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <form asp-action="Create" method="post">

                    @Html.AntiForgeryToken()


                    <div class="form-grid">

                        <!-- FULL NAME -->
                        <div class="form-group full">

                            <label asp-for="FullName"
                                   class="form-label">
                                Full Name <span class="required">*</span>
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="e.g. Maya" />

                            <span asp-validation-for="FullName"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <!-- ROLE -->
                        <div class="form-group full">

                            <label asp-for="Role"
                                   class="form-label">
                                Role
                            </label>

                            <input asp-for="Role"
                                   class="form-control"
                                   placeholder="e.g. Hair Artist" />

                            <span asp-validation-for="Role"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <div class="form-divider">
                            <span>Contact</span>
                        </div>


                        <!-- EMAIL -->
                        <div class="form-group">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="name@example.com" />

                            <span asp-validation-for="Email"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <!-- PHONE -->
                        <div class="form-group">

                            <label asp-for="Phone"
                                   class="form-label">
                                Phone
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="+970 ..." />

                            <span asp-validation-for="Phone"
                                  class="field-validation-error">
                            </span>

                        </div>


                        <div class="form-divider">
                            <span>Availability</span>
                        </div>


                        <!-- AVAILABILITY -->
                        <div class="form-group full">

                            <div class="availability-card">

                                <div class="availability-copy">

                                    <span class="availability-indicator"></span>

                                    <div class="availability-text">

                                        <strong>
                                            Available for appointments
                                        </strong>

                                        <span>
                                            Enable this profile when the
                                            artist is accepting appointments.
                                        </span>

                                    </div>

                                </div>


                                <label class="availability-check">

                                    <input asp-for="IsAvailable" />

                                    <span class="availability-toggle"></span>

                                </label>

                            </div>


                            <span asp-validation-for="IsAvailable"
                                  class="field-validation-error">
                            </span>

                        </div>

                    </div>


                    <!-- ACTIONS -->
                    <div class="staff-create-actions">

                        <a asp-action="Index"
                           class="create-cancel">
                            Cancel &amp; Return
                        </a>

                        <button type="submit"
                                class="create-submit">
                            Create Staff
                        </button>

                    </div>

                </form>

            </div>

        </section>


        <!-- FOOTER -->
        <div class="staff-create-footer">

            <span>
                AUREVA / Team Management
            </span>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
