@model IEnumerable<AUREVA.Models.Staff>

@{
    ViewData["Title"] = "Staff";
    var staffMembers = Model?.ToList() ?? new List<AUREVA.Models.Staff>();
}

<div class="aureva-staff">

    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <nav class="staff-nav">

        <a asp-controller="Home"
           asp-action="Index"
           class="staff-logo">
            AUREVA
        </a>


        <a asp-controller="Appointments"
           asp-action="Create"
           class="staff-nav-cta">
            BOOK NOW
        </a>

    </nav>


    <main class="staff-container">

        <!-- =================================================
             HERO
        ================================================== -->

        <section class="staff-hero">

            <div class="hero-eyebrow">
                <span class="eyebrow-line"></span>
                <span>AUREVA / PEOPLE</span>
            </div>

            <div class="hero-main">

                <div class="hero-number">
                    01
                </div>

                <div class="hero-title-area">

                    <h1>
                        Meet the
                        <span>atelier.</span>
                    </h1>

                    <p>
                        The people behind every detail,
                        every appointment and every AUREVA experience.
                    </p>

                </div>

            </div>


            <div class="hero-footer">

                <div class="hero-description">
                    <span>OUR PHILOSOPHY</span>
                    <p>
                        Great experiences begin with
                        people who care about the details.
                    </p>
                </div>

                <div class="hero-stat">

                    <div class="stat-label">
                        SPECIALISTS
                    </div>

                    <div class="stat-number">
                        @staffMembers.Count.ToString("00")
                    </div>

                    <div class="stat-line"></div>

                </div>

                <a asp-action="Create"
                   class="hero-add">

                    <span class="add-symbol">+</span>

                    <span class="add-label">
                        ADD NEW
                        <small>STAFF MEMBER</small>
                    </span>

                    <span class="add-arrow">↗</span>

                </a>

            </div>

        </section>


        <!-- =================================================
             INTRO STRIP
        ================================================== -->

        <section class="staff-intro-strip">

            <span class="strip-number">02</span>

            <span class="strip-line"></span>

            <div class="strip-title">
                PEOPLE MAKE
                <span>THE EXPERIENCE.</span>
            </div>

            <p>
                Behind every appointment is a specialist
                who brings skill, care and personality.
            </p>

        </section>


        <!-- =================================================
             TEAM HEADER
        ================================================== -->

        <section class="team-heading">

            <div>

                <span class="section-eyebrow">
                    AUREVA / OUR PEOPLE
                </span>

                <h2>
                    The people
                    <span>behind AUREVA.</span>
                </h2>

            </div>

            <div class="team-heading-meta">

                <span>01 — TEAM</span>
                <span>AUREVA STUDIO</span>

            </div>

        </section>


        <!-- =================================================
             STAFF
        ================================================== -->
        @if (staffMembers.Any())
        {
            <section class="staff-grid">

                @foreach (var member in staffMembers)
                {
                    var initial = !string.IsNullOrWhiteSpace(member.FullName)
                        ? member.FullName.Trim().Substring(0, 1).ToUpper()
                        : "A";

                    <a asp-action="Details"
                       asp-route-id="@member.Id"
                       class="staff-card">

                        <div class="card-number">
                            @member.Id.ToString("D2")
                        </div>

                        <div class="card-status @(member.IsAvailable ? "available" : "busy")">

                            <span class="status-dot"></span>

                            @(member.IsAvailable
                                ? "AVAILABLE"
                                : "BUSY")

                        </div>


                        <div class="card-visual">

                            <div class="visual-circle circle-large"></div>

                            <div class="visual-circle circle-small"></div>

                            <div class="visual-line"></div>

                            <div class="avatar">
                                @initial
                            </div>

                            <span class="visual-mark">
                                AUREVA
                            </span>

                        </div>


                        <div class="card-info">

                            <div>

                                <h3>
                                    @member.FullName
                                </h3>

                                <span>
                                    @member.Role
                                </span>

                            </div>

                            <div class="card-link">
                                <span>VIEW</span>
                                <b>↗</b>
                            </div>

                        </div>

                    </a>
                }

            </section>
        }
        else
        {
            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <section class="staff-empty">

                <div class="empty-number">
                    00
                </div>

                <div class="empty-content">

                    <span>
                        AUREVA / TEAM
                    </span>

                    <h3>
                        No team members yet.
                    </h3>

                    <p>
                        Add your first AUREVA specialist
                        to begin building the atelier.
                    </p>

                </div>

                <a asp-action="Create"
                   class="empty-button">
                    + ADD MEMBER
                </a>

            </section>
        }


        <!-- =================================================
             CLOSING STATEMENT
        ================================================== -->

        <section class="staff-statement">

            <div class="statement-orbit orbit-one"></div>
            <div class="statement-orbit orbit-two"></div>

            <div class="statement-mark">
                A
            </div>

            <div class="statement-content">

                <span>
                    AUREVA / PHILOSOPHY
                </span>

                <h2>
                    Skill is personal.
                    <br>
                    <span>Experience is shared.</span>
                </h2>

            </div>

            <div class="statement-note">

                <strong>03 / 03</strong>

                <p>
                    Every appointment begins
                    with the right person.
                </p>

            </div>

        </section>

    </main>

</div>


<style>

    /* =========================================================
           AUREVA STAFF — COMPLETE REDESIGN
           Editorial Luxury / Modern Atelier
        ========================================================= */

    .aureva-staff {
        --teal: #19B8B2;
        --teal-dark: #087F7A;
        --teal-deep: #075B5A;
        --burgundy: #800020;
        --burgundy-dark: #5C0017;
        --burgundy-soft: #E8C5CD;
        --white: #FFFFFF;
        --ivory: #FAFCFB;
        --ivory-dark: #EEF5F4;
        --text: #183333;
        --text-soft: #486361;
        --text-muted: #78908E;
        --line: rgba(24,51,51,.10);
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        background: radial-gradient( circle at 0% 0%, rgba(25,184,178,.10), transparent 28% ), radial-gradient( circle at 100% 25%, rgba(128,0,32,.07), transparent 25% ), linear-gradient( 180deg, #FFFFFF 0%, #FAFCFB 55%, #EEF5F4 100% );
        color: var(--text);
        font-family: "Segoe UI", Arial, sans-serif;
    }


        .aureva-staff *,
        .aureva-staff *::before,
        .aureva-staff *::after {
            box-sizing: border-box;
        }


        .aureva-staff a {
            -webkit-tap-highlight-color: transparent;
        }


    /* =========================================================
           NAVIGATION
        ========================================================= */

    .staff-nav {
        position: absolute;
        top: 28px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;
        width: min(1180px, calc(100% - 48px));
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 9px 8px 25px;
        background: rgba(255,255,255,.84);
        border: 1px solid rgba(24,51,51,.09);
        border-radius: 100px;
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        box-shadow: 0 18px 50px rgba(24,51,51,.07);
    }


    .staff-logo {
        color: var(--teal-deep);
        text-decoration: none;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 19px;
        letter-spacing: .10em;
    }

    .staff-nav-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 21px;
        background: var(--burgundy);
        color: #fff;
        text-decoration: none;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .17em;
        border-radius: 100px;
        transition: transform .35s ease, background .35s ease, box-shadow .35s ease;
    }


        .staff-nav-cta:hover {
            transform: translateY(-2px);
            background: var(--burgundy-dark);
            box-shadow: 0 14px 28px rgba(92,0,23,.18);
        }


    /* =========================================================
           MAIN CONTAINER
        ========================================================= */

    .staff-container {
        width: min(1320px, calc(100% - 64px));
        margin: auto;
        padding: 145px 0 100px;
    }


    /* =========================================================
           HERO
        ========================================================= */

    .staff-hero {
        position: relative;
        min-height: 620px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 45px 0 0;
        border-bottom: 1px solid var(--line);
    }


        .staff-hero::before {
            content: "AU";
            position: absolute;
            right: -20px;
            top: 25px;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(18rem, 32vw, 31rem);
            line-height: .7;
            color: rgba(25,184,178,.09);
            pointer-events: none;
        }


    .hero-eyebrow {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .38em;
        text-transform: uppercase;
    }


    .eyebrow-line {
        width: 48px;
        height: 1px;
        background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
    }


    .hero-main {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 85px 1fr;
        gap: 30px;
        align-items: start;
    }


    .hero-number {
        padding-top: 18px;
        color: var(--burgundy);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        letter-spacing: -.03em;
    }


    .hero-title-area h1 {
        margin: 0;
        max-width: 850px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(5.5rem, 10vw, 9.5rem);
        font-weight: 400;
        line-height: .77;
        letter-spacing: -.085em;
    }


        .hero-title-area h1 span {
            display: block;
            color: var(--burgundy);
            font-weight: 400;
        }


    .hero-title-area p {
        max-width: 410px;
        margin: 48px 0 0;
        padding-left: 20px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 11px;
        line-height: 1.9;
        letter-spacing: .01em;
    }


    /* =========================================================
           HERO FOOTER
        ========================================================= */

    .hero-footer {
        position: relative;
        z-index: 3;
        display: grid;
        grid-template-columns: 1fr 180px 230px;
        gap: 55px;
        align-items: end;
        padding-bottom: 34px;
    }


    .hero-description span {
        display: block;
        margin-bottom: 9px;
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .28em;
    }


    .hero-description p {
        max-width: 260px;
        margin: 0;
        color: var(--text-muted);
        font-size: 9px;
        line-height: 1.8;
    }


    .hero-stat {
        position: relative;
        padding-left: 18px;
        border-left: 1px solid var(--line);
    }


    .stat-label {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .24em;
    }


    .stat-number {
        margin-top: 8px;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 65px;
        line-height: .8;
        letter-spacing: -.07em;
    }


    .stat-line {
        width: 34px;
        height: 1px;
        margin-top: 15px;
        background: var(--teal);
    }


    .hero-add {
        display: flex;
        align-items: center;
        gap: 16px;
        min-height: 62px;
        padding: 0 19px;
        background: var(--burgundy);
        color: white;
        text-decoration: none;
        transition: transform .4s cubic-bezier(.22,1,.36,1), background .3s ease, box-shadow .4s ease;
    }


        .hero-add:hover {
            transform: translateY(-4px);
            background: var(--burgundy-dark);
            box-shadow: 0 20px 40px rgba(92,0,23,.18);
        }


    .add-symbol {
        color: var(--burgundy-soft);
        font-size: 23px;
        font-weight: 300;
        transition: transform .4s ease;
    }


    .hero-add:hover .add-symbol {
        transform: rotate(90deg);
    }


    .add-label {
        display: flex;
        flex-direction: column;
        flex: 1;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .22em;
    }


        .add-label small {
            margin-top: 5px;
            color: rgba(255,255,255,.55);
            font-size: 6px;
            letter-spacing: .22em;
        }


    .add-arrow {
        font-size: 16px;
        transition: transform .4s ease;
    }


    .hero-add:hover .add-arrow {
        transform: translate(3px,-3px);
    }


    /* =========================================================
           INTRO STRIP
        ========================================================= */

    .staff-intro-strip {
        display: grid;
        grid-template-columns: 45px 1px minmax(300px,1fr) 300px;
        gap: 25px;
        align-items: center;
        padding: 32px 0;
        border-bottom: 1px solid var(--line);
    }


    .strip-number {
        color: var(--burgundy);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
    }


    .strip-line {
        width: 1px;
        height: 45px;
        background: var(--burgundy);
    }


    .strip-title {
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.8rem, 3vw, 3rem);
        line-height: .9;
        letter-spacing: -.055em;
    }


        .strip-title span {
            color: var(--burgundy);
        }


    .staff-intro-strip p {
        margin: 0;
        padding-left: 18px;
        border-left: 1px solid var(--burgundy);
        color: var(--text-muted);
        font-size: 9px;
        line-height: 1.8;
    }


    /* =========================================================
           TEAM HEADING
        ========================================================= */

    .team-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 30px;
        margin-top: 105px;
    }


    .section-eyebrow {
        display: block;
        margin-bottom: 17px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .30em;
    }


    .team-heading h2 {
        margin: 0;
        color: var(--teal-deep);
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: clamp(2.8rem, 5vw, 5.4rem);
        line-height: .92;
        letter-spacing: -.055em;
        font-weight: 500;
    }


        .team-heading h2 span {
            display: block;
            color: var(--burgundy);
        }


    .team-heading-meta {
        display: flex;
        gap: 30px;
        padding-bottom: 5px;
        color: var(--text-muted);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .24em;
    }


        .team-heading-meta span:last-child {
            color: var(--burgundy);
        }


    /* =========================================================
           STAFF GRID
        ========================================================= */

    .staff-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 20px;
        margin-top: 38px;
    }


    /* =========================================================
           STAFF CARD
        ========================================================= */

    .staff-card {
        position: relative;
        min-height: 490px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 23px;
        background: linear-gradient( 145deg, rgba(255,255,255,.98), rgba(247,251,250,.94) );
        border: 1px solid var(--line);
        color: inherit;
        text-decoration: none;
        transition: transform .55s cubic-bezier(.22,1,.36,1), box-shadow .55s cubic-bezier(.22,1,.36,1), border-color .35s ease;
    }


        .staff-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--teal), var(--burgundy) );
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .55s cubic-bezier(.22,1,.36,1);
        }


        .staff-card:hover {
            transform: translateY(-8px);
            border-color: rgba(25,184,178,.25);
            box-shadow: 0 28px 65px rgba(24,51,51,.10);
        }


            .staff-card:hover::before {
                transform: scaleX(1);
            }


    /* =========================================================
           CARD HEADER
        ========================================================= */

    .card-number {
        position: absolute;
        top: 23px;
        left: 23px;
        color: var(--burgundy);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .18em;
    }


    .card-status {
        position: absolute;
        top: 23px;
        right: 23px;
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .16em;
    }


    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }


    .card-status.available {
        color: var(--teal-dark);
    }


        .card-status.available .status-dot {
            background: var(--teal);
            box-shadow: 0 0 0 4px rgba(25,184,178,.10);
        }


    .card-status.busy {
        color: var(--burgundy);
    }


        .card-status.busy .status-dot {
            background: var(--burgundy);
            box-shadow: 0 0 0 4px rgba(128,0,32,.08);
        }


    /* =========================================================
           CARD VISUAL
        ========================================================= */

    .card-visual {
        position: relative;
        height: 315px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 25px;
        overflow: hidden;
    }


        .card-visual::before {
            content: "";
            position: absolute;
            width: 270px;
            height: 270px;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(25,184,178,.09), transparent 68% );
        }


    .visual-circle {
        position: absolute;
        border-radius: 50%;
        transition: transform .8s cubic-bezier(.22,1,.36,1);
    }


    .circle-large {
        width: 235px;
        height: 235px;
        border: 1px dashed rgba(25,184,178,.25);
    }


    .circle-small {
        width: 190px;
        height: 190px;
        border: 1px solid rgba(128,0,32,.14);
    }


    .visual-line {
        position: absolute;
        width: 250px;
        height: 1px;
        background: linear-gradient( 90deg, transparent, rgba(128,0,32,.25), transparent );
        transform: rotate(45deg);
    }


    .avatar {
        position: relative;
        z-index: 2;
        width: 148px;
        height: 148px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
         background: radial-gradient( circle at 92% 0%, rgba(128, 0, 32, .30), transparent 30% ), linear-gradient( 135deg, var(--teal-deep), var(--teal-dark) 58%, #159D98 100% );
        color: white;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 62px;
        box-shadow: 0 25px 55px rgba(24,51,51,.17);
        transition: transform .7s cubic-bezier(.22,1,.36,1), box-shadow .6s ease;
    }


        .avatar::before {
            content: "";
            position: absolute;
            inset: 8px;
            border: 1px solid rgba(255,255,255,.20);
            border-radius: 50%;
        }


    .visual-mark {
        position: absolute;
        bottom: 30px;
        right: 10px;
        color: rgba(24,51,51,.16);
        font-size: 6px;
        font-weight: 800;
        letter-spacing: .35em;
        transform: rotate(-90deg);
    }


    .staff-card:hover .circle-large {
        transform: rotate(15deg) scale(1.04);
    }


    .staff-card:hover .circle-small {
        transform: rotate(-12deg) scale(1.04);
    }


    .staff-card:hover .avatar {
        transform: scale(1.07) rotate(-4deg);
        box-shadow: 0 32px 70px rgba(24,51,51,.23);
    }


    /* =========================================================
           CARD INFO
        ========================================================= */

    .card-info {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 15px;
        margin-top: auto;
        padding-top: 19px;
        border-top: 1px solid var(--line);
    }


        .card-info h3 {
            margin: 0;
            color: var(--teal-deep);
            font-family: Georgia, "Times New Roman", serif;
            font-size: 28px;
            font-weight: 400;
            line-height: .95;
            letter-spacing: -.045em;
            transition: color .35s ease;
        }


        .card-info span {
            display: block;
            margin-top: 9px;
            color: var(--text-muted);
            font-size: 7px;
            font-weight: 800;
            letter-spacing: .18em;
            text-transform: uppercase;
        }


    .staff-card:hover .card-info h3 {
        color: var(--burgundy);
    }


    .card-link {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        font-size: 6px;
        font-weight: 800;
        letter-spacing: .15em;
    }


        .card-link b {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--line);
            border-radius: 50%;
            color: var(--teal-deep);
            font-size: 14px;
            font-weight: 400;
            transition: transform .45s ease, background .35s ease, color .35s ease, border-color .35s ease;
        }


    .staff-card:hover .card-link b {
        transform: rotate(45deg);
        background: var(--burgundy);
        border-color: var(--burgundy);
        color: white;
    }


    /* =========================================================
           EMPTY STATE
        ========================================================= */

    .staff-empty {
        display: grid;
        grid-template-columns: 110px 1fr auto;
        align-items: center;
        gap: 40px;
        margin-top: 38px;
        padding: 48px;
        background: rgba(255,255,255,.75);
        border: 1px solid var(--line);
        box-shadow: 0 20px 55px rgba(24,51,51,.04);
    }


    .empty-number {
        color: var(--burgundy);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 72px;
        line-height: .8;
        letter-spacing: -.07em;
    }


    .empty-content > span {
        color: var(--burgundy);
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .3em;
    }


    .empty-content h3 {
        margin: 10px 0 0;
        color: var(--teal-deep);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 26px;
        font-weight: 400;
    }


    .empty-content p {
        margin: 8px 0 0;
        color: var(--text-muted);
        font-size: 9px;
    }


    .empty-button {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 23px;
