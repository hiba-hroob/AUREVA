<div class="aureva-page">

    <!-- HERO -->
    <section class="aureva-hero">

        <div class="aureva-wrap">

            <div class="aureva-hero-grid">

                <!-- LEFT -->
                <div class="aureva-panel aureva-copy">

                    <div>

                        <div class="aureva-eyebrow">

                            <span class="aureva-eyebrow-line"></span>

                            SALON MANAGEMENT

                        </div>


                        <div class="aureva-date">
                            @today.ToString("dddd · dd MMMM").ToUpper()
                        </div>


                        <h1 class="aureva-title">
                            Beauty,
                            <br />
                            <span>in perfect flow.</span>
                        </h1>


                        <p class="aureva-description">
                            One elegant space for appointments, artists,
                            clients and everything that keeps your salon moving.
                        </p>

                    </div>


                    <!-- LIVE STATS -->
                    <div class="aureva-stats">

                        <div>

                            <div class="aureva-stat-number">
                                @todayAppointments.Count
                            </div>

                            <div class="aureva-stat-label">
                                APPOINTMENTS
                            </div>

                        </div>


                        <div>

                            <div class="aureva-stat-number">
                                @todayRevenue.ToString("C")
                            </div>

                            <div class="aureva-stat-label">
                                REVENUE
                            </div>

                        </div>


                        <div>

                            <div class="aureva-stat-number">
                                —
                            </div>

                            <div class="aureva-stat-label">
                                OCCUPANCY
                            </div>

                        </div>

                    </div>

                </div>


                <!-- IMAGE -->
                <div class="aureva-panel aureva-image">

                    <img src="https://www.gammabross.com/Gallery/salonimg-frkqkj-181.webp"
                         alt="Luxury salon interior" />

                    <div class="aureva-image-overlay"></div>


                    <div class="aureva-image-tag">
                        AUREVA STUDIO
                    </div>


                    <div class="aureva-image-content">

                        <div class="aureva-gold-label">
                            TODAY AT AUREVA
                        </div>


                        <div class="aureva-image-title">
                            Every detail
                            <br />
                            <span>deserves its moment.</span>
                        </div>


                        <div class="aureva-image-actions">

                            <button type="button"
                                    class="aureva-btn"
                                    onclick="window.location.href='/Calendar'">
                                OPEN SCHEDULE
                            </button>


                            <div class="aureva-small-note">
                                @todayAppointments.Count APPOINTMENTS TODAY
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- INTRO -->
    <section class="aureva-section">

        <div class="aureva-wrap">

            <div class="aureva-section-top">

                <div class="aureva-section-label">
                    THE DAY AHEAD
                </div>


                <h2 class="aureva-section-title">
                    A calm overview for a busy
                    <span>beautiful business.</span>
                </h2>

            </div>

        </div>

    </section>


    <!-- CALENDAR -->
    <section id="schedule"
             class="aureva-section"
             style="padding-top:20px;">

        <div class="aureva-wrap">

            <div class="aureva-calendar-light">

                <div class="aureva-calendar-header">

                    <div>

                        <div class="aureva-gold-label">
                            LIVE CALENDAR
                        </div>

                        <h3 class="aureva-calendar-title">
                            Today, in motion.
                        </h3>

                    </div>


                    <button type="button"
                            class="aureva-calendar-button"
                            onclick="window.location.href='/Appointments/Create'">
                        + NEW APPOINTMENT
                    </button>

                </div>


                <div class="aureva-calendar-list">

                    @if (todayAppointments.Any())
                    {
                        foreach (var appointment in todayAppointments)
                        {
                            var isNow =
                                appointment.StartTime <= DateTime.Now &&
                                appointment.StartTime.AddMinutes(
                                    appointment.DurationMinutes
                                ) >= DateTime.Now;

                            <div class="aureva-appointment @(isNow ? "aureva-appointment-active" : "")">

                                <div class="aureva-time @(isNow ? "aureva-status-now" : "")">

                                    @appointment.StartTime.ToString("HH:mm")

                                </div>


                                <div>

                                    <div class="aureva-service">
                                        @(appointment.Service?.Name ?? "SERVICE")
                                    </div>

                                    <div class="aureva-client">
                                        @(appointment.Client?.FullName ?? "CLIENT")
                                    </div>

                                </div>


                                <div class="aureva-artist">

                                    @(appointment.Staff?.FullName ?? "ARTIST")

                                </div>


                                <div class="aureva-status @(isNow ? "aureva-status-now" : "")">

                                    @if (isNow)
                                    {
                                        <text>● NOW</text>
                                    }
                                    else
                                    {
                                        @appointment.Status.ToUpper()
                                    }

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="aureva-appointment">

                            <div class="aureva-time">
                                —
                            </div>

                            <div>

                                <div class="aureva-service">
                                    No appointments today.
                                </div>

                                <div class="aureva-client">
                                    Your schedule is clear.
                                </div>

                            </div>

                            <div class="aureva-artist">
                                AUREVA
                            </div>

                            <div class="aureva-status">
                                OPEN
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </section>


    <!-- TEAM -->
    <section class="aureva-section">

        <div class="aureva-wrap">

            <div class="aureva-section-top">

                <div class="aureva-section-label">
                    THE PEOPLE BEHIND THE EXPERIENCE
                </div>

                <h2 class="aureva-section-title">
                    Your artists.
                </h2>

            </div>


            <div class="aureva-team-stage">

                <div class="aureva-team-line"></div>


                <div class="aureva-team-grid">

                    @if (staff.Any())
                    {
                        foreach (var member in staff.Take(3))
                        {
                            var initials = string.Join(
                                "",
                                member.FullName
                                    .Split(
                                        ' ',
                                        StringSplitOptions.RemoveEmptyEntries
                                    )
                                    .Take(2)
                                    .Select(x => x[0])
                            );


                            <div class="aureva-person">

                                <div class="aureva-person-content">

                                    <div class="aureva-avatar-wrap">
                                        <div class="aureva-avatar">
                                            @initials
                                        </div>

                                        <span class="aureva-avatar-line"></span>
                                    </div>


                                    <div class="aureva-person-name">
                                        @member.FullName
                                    </div>


                                    <div class="aureva-person-role">
                                        @member.Role?.ToUpper()
                                    </div>


                                    <div class="aureva-person-state">
                                        @(member.IsAvailable
                                            ? "AVAILABLE"
                                            : "BUSY")
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="aureva-person">

                            <div class="aureva-person-content">

                                <div class="aureva-avatar">
                                    —
                                </div>

                                <div class="aureva-person-name">
                                    No team members
                                </div>

                                <div class="aureva-person-role">
                                    AUREVA
                                </div>

                                <div class="aureva-person-state">
                                    SETUP REQUIRED
                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </section>


    <!-- GOLD NOTE -->
    <section class="aureva-section">

        <div class="aureva-wrap">

            <div class="aureva-note aureva-note-photo">

                <img src="https://www.gammabross.com/ImgContent/brand-gammastore-cover.jpg"
                     alt="Luxury salon interior" />

                <div class="aureva-note-gold-overlay"></div>


                <div class="aureva-note-grid">

                    <div>

                        <div class="aureva-note-label">
                            AUREVA NOTE
                        </div>


                        <h2 class="aureva-note-title">
                            A beautiful salon runs on beautiful organization.
                        </h2>


                        <p class="aureva-note-text">
                            From the first appointment of the morning to the
                            final client of the day, AUREVA keeps every moving
                            part aligned.
                        </p>

                    </div>


                    <button type="button"
                            class="aureva-note-button"
                            onclick="window.location.href='/Clients'">
                        VIEW CLIENTS →
                    </button>

                </div>

            </div>

        </div>

    </section>

</div>