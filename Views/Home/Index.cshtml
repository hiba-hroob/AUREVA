@{
    ViewData["Title"] = "AUREVA";

    var today = (DateTime)ViewBag.Today;

    var todayAppointments =
        (List<AUREVA.Models.Appointment>)ViewBag.TodayAppointments;

    var staff =
        (List<AUREVA.Models.Staff>)ViewBag.Staff;

    var todayRevenue =
        (decimal)ViewBag.TodayRevenue;
}


<style>

    /* =========================================================
                       AUREVA — DEEP TEAL × BURGUNDY × IVORY
                       Quiet Luxury / Modern Beauty / Elegant
                       ========================================================= */

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        background: #FAFCFB;
    }

    .aureva-page {
        /* =========================
                           CORE PALETTE
                           ========================= */

        --teal: #19B8B2;
        --teal-dark: #087F7A;
        --teal-deep: #075B5A;
        --teal-soft: #DDF5F3;
        --teal-pale: #F1FBFA;
        /* BURGUNDY — #800020 */
        --burgundy: #800020;
        --burgundy-dark: #5C0017;
        --burgundy-soft: #E8C5CD;
        --burgundy-pale: #FAEFF2;
        --white: #FFFFFF;
        --ivory: #FAFCFB;
        --ivory-dark: #EEF5F4;
        --text: #183333;
        --text-soft: #486361;
        --text-muted: #78908E;
        --text-faint: #A8B9B7;
        --line: rgba(24, 51, 51, .10);
        --line-teal: rgba(7, 91, 90, .15);
        --line-white: rgba(255, 255, 255, .16);
        background: radial-gradient( circle at 8% 3%, rgba(7, 91, 90, .09), transparent 27% ), radial-gradient( circle at 94% 20%, rgba(128, 0, 32, .08), transparent 28% ), linear-gradient( 180deg, #FFFFFF 0%, #FAFCFB 55%, #F1F8F7 100% );
        color: var(--text);
        min-height: 100vh;
        font-family: "Segoe UI", Arial, sans-serif;
        overflow-x: hidden;
    }

        .aureva-page *,
        .aureva-page *::before,
        .aureva-page *::after {
            box-sizing: border-box;
        }


    /* =========================================================
                       WRAPPER
                       ========================================================= */

    .aureva-wrap {
        width: min(1500px, calc(100% - 56px));
        margin: 0 auto;
    }


    /* =========================================================
                       FLOATING NAV
                       ========================================================= */

    .aureva-nav-wrap {
        position: fixed;
        top: 22px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1000;
        width: min(720px, calc(100% - 28px));
    }

    .aureva-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 7px;
        background: rgba(255, 255, 255, .90);
        border: 1px solid rgba(7, 91, 90, .12);
        border-radius: 999px;
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow: 0 20px 60px rgba(7, 91, 90, .09), 0 4px 15px rgba(24, 51, 51, .04);
    }

        .aureva-nav button {
            border: 0;
            background: transparent;
            color: var(--teal-deep);
            min-height: 42px;
            padding: 0 20px;
            border-radius: 999px;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .22em;
            cursor: pointer;
            transition: background .3s ease, color .3s ease, transform .3s ease;
        }

            .aureva-nav button:hover {
                background: var(--teal-deep);
                color: #FFFFFF;
                transform: translateY(-1px);
            }

    .aureva-logo {
        padding: 0 27px;
        color: var(--teal-deep);
        font-size: 14px;
        font-weight: 800;
        letter-spacing: .42em;
    }

    .aureva-divider {
        width: 1px;
        height: 20px;
        background: rgba(7, 91, 90, .15);
    }

    .aureva-dot {
        width: 6px;
        height: 6px;
        display: inline-block;
        margin-right: 8px;
        border-radius: 50%;
        background: var(--burgundy);
        box-shadow: 0 0 0 4px rgba(128, 0, 32, .14);
    }


    /* =========================================================
                       HERO
                       ========================================================= */

    .aureva-hero {
        padding-top: 124px;
        padding-bottom: 36px;
    }

    .aureva-hero-grid {
        display: grid;
        grid-template-columns: minmax(340px, .78fr) minmax(500px, 1.22fr);
        gap: 22px;
    }

    .aureva-panel {
        position: relative;
        min-height: 690px;
        border-radius: 38px;
        overflow: hidden;
    }


    /* =========================================================
                       HERO COPY
                       ========================================================= */

    .aureva-copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 58px;
        background: radial-gradient( circle at 100% 0%, rgba(7, 91, 90, .07), transparent 34% ), linear-gradient( 145deg, #FFFFFF 0%, #F5FBFA 100% );
        border: 1px solid rgba(7, 91, 90, .11);
        box-shadow: 0 30px 90px rgba(7, 91, 90, .06), inset 0 1px 0 rgba(255, 255, 255, .95);
    }

    .aureva-eyebrow {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 38px;
        color: var(--burgundy-dark);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .38em;
    }

    .aureva-eyebrow-line {
        width: 46px;
        height: 2px;
        background: var(--burgundy);
    }

    .aureva-date {
        color: var(--text-faint);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .28em;
    }

    .aureva-title {
        margin: 27px 0 0;
        max-width: 760px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(4rem, 7vw, 7.6rem);
        line-height: .82;
        letter-spacing: -.065em;
        font-weight: 500;
        color: var(--teal-deep);
    }

        .aureva-title span {
            color: var(--burgundy);
            opacity: .88;
        }

    .aureva-description {
        max-width: 455px;
        margin-top: 34px;
        color: var(--text-soft);
        font-size: 14px;
        line-height: 1.95;
    }


    /* =========================================================
                       STATS
                       ========================================================= */

    .aureva-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 55px;
        padding-top: 26px;
        border-top: 1px solid var(--line-teal);
    }

        .aureva-stats > div {
            min-width: 0;
            padding: 0 22px;
            border-right: 1px solid var(--line-teal);
        }

            .aureva-stats > div:first-child {
                padding-left: 0;
            }

            .aureva-stats > div:last-child {
                padding-right: 0;
                border-right: 0;
            }

    .aureva-stat-number {
        color: var(--teal-deep);
        font-size: clamp(25px, 3vw, 39px);
        font-weight: 700;
        letter-spacing: -.055em;
        white-space: nowrap;
    }

    .aureva-stat-label {
        margin-top: 9px;
        color: var(--text-faint);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .27em;
    }


    /* =========================================================
                       HERO IMAGE
                       ========================================================= */

    .aureva-image {
        background: var(--teal-deep);
        isolation: isolate;
        box-shadow: 0 30px 90px rgba(7, 91, 90, .22);
    }

        .aureva-image img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.01);
            display: block;
            transition: transform 1.5s cubic-bezier(.22, 1, .36, 1);
        }

        .aureva-image:hover img {
            transform: scale(1.045);
        }

    .aureva-image-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient( 135deg, rgba(7, 91, 90, .94), rgba(8, 127, 122, .68) 55%, rgba(128, 0, 32, .58) 100% );
        mix-blend-mode: multiply;
    }

    .aureva-image::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        background: linear-gradient( 135deg, rgba(25, 184, 178, .18), transparent 43% ), linear-gradient( 315deg, rgba(128, 0, 32, .12), transparent 45% );
    }

    .aureva-image-tag {
        position: absolute;
        top: 28px;
        left: 28px;
        z-index: 4;
        padding: 11px 16px;
        color: #FFFFFF;
        background: rgba(7, 91, 90, .38);
        border: 1px solid rgba(255, 255, 255, .26);
        border-radius: 999px;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .28em;
    }

    .aureva-image-content {
        position: absolute;
        left: 52px;
        right: 52px;
        bottom: 52px;
        z-index: 4;
        color: #FFFFFF;
    }

    .aureva-gold-label {
        color: var(--burgundy-soft);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .40em;
    }

    .aureva-image-title {
        margin-top: 18px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.4rem, 5.8vw, 6.4rem);
        line-height: .86;
        letter-spacing: -.055em;
        font-weight: 500;
    }

        .aureva-image-title span {
            color: rgba(255, 255, 255, .58);
        }

    .aureva-image-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 17px;
        margin-top: 30px;
    }


    /* =========================================================
                       MAIN BUTTON
                       ========================================================= */

    .aureva-btn {
        border: 1px solid #650018;
        border-radius: 999px;
        padding: 15px 23px;
        background: var(--burgundy);
        color: #FFFFFF;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .20em;
        cursor: pointer;
        box-shadow: 0 12px 35px rgba(128, 0, 32, .28);
        transition: transform .25s ease, background .25s ease, color .25s ease, border-color .25s ease;
    }

        .aureva-btn:hover {
            transform: translateY(-3px);
            background: #FFFFFF;
            color: var(--teal-deep);
            border-color: #FFFFFF;
        }

    .aureva-small-note {
        color: rgba(255, 255, 255, .55);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: .13em;
    }


    /* =========================================================
                       GENERAL SECTIONS
                       ========================================================= */

    .aureva-section {
        padding: 72px 0 34px;
        background: radial-gradient( circle at 12% 5%, rgba(7, 91, 90, .07), transparent 27% ), radial-gradient( circle at 92% 50%, rgba(128, 0, 32, .07), transparent 30% ), linear-gradient( 180deg, #FFFFFF 10%, #FAFCFB 85%, #F1F8F7 100% );
    }

    .aureva-section-top {
        display: grid;
        grid-template-columns: .34fr 1.66fr;
        gap: 35px;
        align-items: end;
        margin-bottom: 30px;
    }

    .aureva-section-label {
        color: var(--burgundy-dark);
        font-size: 9px;
        font-weight: 800;
        line-height: 1.7;
        letter-spacing: .34em;
    }

    .aureva-section-title {
        margin: 0;
        max-width: 1000px;
        font-family: "Segoe UI", Arial, sans-serif;
        font-size: clamp(2.9rem, 5vw, 5.5rem);
        line-height: .95;
        letter-spacing: -.055em;
        font-weight: 500;
        color: var(--teal-deep);
    }

        .aureva-section-title span {
            color: var(--burgundy);
            opacity: .88;
        }


    /* =========================================================
                       CALENDAR
                       ========================================================= */

    .aureva-calendar-light {
        position: relative;
        background: radial-gradient( circle at 92% 0%, rgba(128, 0, 32, .30), transparent 30% ), linear-gradient( 135deg, var(--teal-deep), var(--teal-dark) 58%, #159D98 100% );
        color: #FFFFFF;
        border: 1px solid rgba(7, 91, 90, .18);
        border-radius: 36px;
        overflow: hidden;
        box-shadow: 0 35px 100px rgba(7, 91, 90, .21);
    }

        .aureva-calendar-light::before {
            content: "";
            position: absolute;
            width: 430px;
            height: 430px;
            top: -240px;
            right: -160px;
            border-radius: 50%;
            background: rgba(128, 0, 32, .18);
            filter: blur(10px);
            pointer-events: none;
        }

    .aureva-calendar-header {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        padding: 39px 44px;
        border-bottom: 1px solid rgba(255, 255, 255, .12);
    }

    .aureva-calendar-title {
        margin: 10px 0 0;
        color: #FFFFFF;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.3rem, 4vw, 3.3rem);
        line-height: .95;
        letter-spacing: -.045em;
        font-weight: 500;
    }

    .aureva-calendar-button {
        border: 1px solid var(--burgundy);
        border-radius: 999px;
        padding: 13px 20px;
        background: #FFFFFF;
        color: var(--teal-deep);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .19em;
        cursor: pointer;
        box-shadow: 0 10px 28px rgba(7, 91, 90, .16);
        transition: background .3s ease, color .3s ease, border-color .3s ease, transform .3s ease, box-shadow .3s ease;
    }

        .aureva-calendar-button:hover {
            border-color: var(--burgundy);
            background: var(--burgundy);
            color: #FFFFFF;
            transform: translateY(-2px);
            box-shadow: 0 14px 35px rgba(128, 0, 32, .28);
        }

    .aureva-calendar-list {
        width: 100%;
    }

    .aureva-appointment {
        position: relative;
        display: grid;
        grid-template-columns: 100px minmax(0, 1fr) 180px 110px;
        gap: 22px;
        align-items: center;
        padding: 27px 44px;
        border-bottom: 1px solid rgba(255, 255, 255, .075);
        transition: background .3s ease, padding-left .3s ease;
    }

        .aureva-appointment:last-child {
            border-bottom: 0;
        }

        .aureva-appointment:hover {
            background: rgba(128, 0, 32, .10);
            padding-left: 49px;
        }

    .aureva-appointment-active {
        background: linear-gradient( 90deg, rgba(128, 0, 32, .20), rgba(128, 0, 32, .03) );
    }

        .aureva-appointment-active::before {
            content: "";
            position: absolute;
            left: 0;
            top: 15px;
            bottom: 15px;
            width: 3px;
            background: var(--burgundy);
            border-radius: 0 4px 4px 0;
            box-shadow: 0 0 20px rgba(128, 0, 32, .60);
        }

    .aureva-time {
        color: rgba(255, 255, 255, .55);
        font-size: 13px;
        font-weight: 600;
        letter-spacing: .08em;
    }

    .aureva-service {
        color: #FFFFFF;
        font-size: 14px;
        font-weight: 700;
    }

    .aureva-client {
        margin-top: 6px;
        color: rgba(255, 255, 255, .42);
        font-size: 10px;
    }

    .aureva-artist {
        color: rgba(255, 255, 255, .48);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .18em;
    }

    .aureva-status {
        text-align: right;
        color: rgba(255, 255, 255, .32);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .18em;
    }

    .aureva-status-now {
        color: var(--burgundy-soft);
    }


    /* =========================================================
                       TEAM
                       ========================================================= */

    .aureva-team-stage {
        position: relative;
        min-height: 380px;
        border-top: 1px solid var(--line-teal);
        border-bottom: 1px solid var(--line-teal);
        overflow: hidden;
    }

    .aureva-team-line {
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        height: 1px;
        background: rgba(7, 91, 90, .11);
        z-index: 0;
    }

    .aureva-team-grid {
        position: relative;
        z-index: 1;
        min-height: 380px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
    }

    .aureva-person {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
    }

        .aureva-person:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 15%;
            bottom: 15%;
            right: 0;
            width: 1px;
            background: rgba(7, 91, 90, .11);
            pointer-events: none;
        }

    .aureva-person-content {
        position: relative;
        z-index: 2;
        text-align: center;
        transform: translateY(0);
        transition: transform .45s cubic-bezier(.22, 1, .36, 1);
    }

    .aureva-person:hover .aureva-person-content {
        transform: translateY(-8px);
    }


    /* =========================================================
                       AVATAR
                       ========================================================= */

    .aureva-avatar-wrap {
        position: relative;
        width: 94px;
        height: 94px;
        margin: 0 auto;
    }

    .aureva-avatar {
        position: relative;
        z-index: 3;
        width: 94px;
        height: 94px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient( 145deg, var(--teal-dark), var(--teal-deep) );
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .08em;
        box-shadow: 0 22px 50px rgba(7, 91, 90, .18);
        transition: transform .45s ease, box-shadow .45s ease;
    }

    /* FIRST — DEEP TEAL */

    .aureva-person:nth-child(1) .aureva-avatar {
        background: var(--teal-dark);
        color: #FFFFFF;
    }

    /* SECOND — BURGUNDY */

    .aureva-person:nth-child(2) .aureva-avatar {
        background: var(--burgundy);
        color: #FFFFFF;
    }

    /* THIRD — DEEP TEAL */

    .aureva-person:nth-child(3) .aureva-avatar {
        background: var(--teal-dark);
        color: #FFFFFF;
    }

        .aureva-person:nth-child(1) .aureva-avatar::after,
        .aureva-person:nth-child(3) .aureva-avatar::after {
            border-color: rgba(7, 91, 90, .48);
        }

    .aureva-person:nth-child(2) .aureva-avatar::after {
        border-color: rgba(128, 0, 32, .58);
    }

    .aureva-person:nth-child(1):hover .aureva-avatar,
    .aureva-person:nth-child(3):hover .aureva-avatar {
        box-shadow: 0 28px 65px rgba(7, 91, 90, .25);
    }

    .aureva-person:nth-child(2):hover .aureva-avatar {
        box-shadow: 0 28px 65px rgba(128, 0, 32, .32);
    }

    .aureva-avatar::before {
        content: "";
        position: absolute;
        inset: -12px;
        border: 1px solid rgba(7, 91, 90, .15);
        border-radius: 50%;
    }

    .aureva-avatar::after {
        content: "";
        position: absolute;
        inset: -21px;
        border: 1px dashed rgba(128, 0, 32, .48);
        border-radius: 50%;
        transition: transform .8s ease;
    }

    .aureva-person:hover .aureva-avatar {
        transform: scale(1.04);
        box-shadow: 0 28px 65px rgba(7, 91, 90, .25);
    }

        .aureva-person:hover .aureva-avatar::after {
            transform: rotate(55deg);
        }

    .aureva-avatar-line {
        position: absolute;
        left: 50%;
        top: 94px;
        width: 1px;
        height: 150px;
        background: rgba(7, 91, 90, .12);
        transform: translateX(-50%);
        z-index: 0;
        pointer-events: none;
    }


    /* =========================================================
                       PERSON TEXT
                       ========================================================= */

    .aureva-person-name {
        margin-top: 34px;
        color: var(--teal-deep);
        font-size: 15px;
        font-weight: 800;
    }

    .aureva-person-role {
        margin-top: 7px;
        color: var(--burgundy-dark);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .20em;
    }

    .aureva-person-state {
        margin-top: 14px;
        color: var(--text-muted);
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .15em;
    }

        .aureva-person-state::before {
            content: "";
            display: inline-block;
            width: 6px;
            height: 6px;
            margin-right: 8px;
            border-radius: 50%;
            background: var(--teal);
            box-shadow: 0 0 0 4px rgba(25, 184, 178, .13);
        }


    /* =========================================================
                       FINAL NOTE
                       ========================================================= */

    .aureva-note {
        position: relative;
        min-height: 520px;
        margin-bottom: 85px;
        border-radius: 38px;
        overflow: hidden;
        color: #FFFFFF;
        border: 1px solid rgba(7, 91, 90, .25);
        box-shadow: 0 35px 100px rgba(7, 91, 90, .18);
    }

    .aureva-note-photo {
        position: relative;
        overflow: hidden;
    }

        .aureva-note-photo > img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: none !important;
            transition: none !important;
            animation: none !important;
            will-change: auto !important;
            pointer-events: none;
            display: block;
        }

        .aureva-note-photo:hover > img {
            transform: none !important;
            transition: none !important;
            animation: none !important;
        }

    .aureva-note img {
        transform: none !important;
        transition: none !important;
        animation: none !important;
        will-change: auto !important;
    }


    /* =========================================================
                       DEEP TEAL × BURGUNDY OVERLAY
                       ========================================================= */

    .aureva-note-gold-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( 105deg, rgba(7, 91, 90, .97) 0%, rgba(8, 127, 122, .92) 38%, rgba(25, 184, 178, .65) 66%, rgba(128, 0, 32, .72) 100% );
    }

    .aureva-note-photo::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient( 180deg, rgba(0, 0, 0, .02), rgba(0, 0, 0, .28) );
        pointer-events: none;
    }


    /* =========================================================
                       NOTE GRID
                       ========================================================= */

    .aureva-note-grid {
        position: relative;
        z-index: 4;
        min-height: 520px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 45px;
        padding: 60px;
    }

    .aureva-note-label {
        color: var(--burgundy-soft);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .40em;
    }

    .aureva-note-title {
        max-width: 950px;
